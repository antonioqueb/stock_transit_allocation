<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- URL de la API -->
        <record id="shipsgo_api_url" model="ir.config_parameter">
            <field name="key">stock_transit.shipsgo_api_url</field>
            <field name="value">https://api.shipsgo.com/v2</field>
        </record>
        <!-- Token de Ricardo -->
        <record id="shipsgo_api_token" model="ir.config_parameter">
            <field name="key">stock_transit.shipsgo_api_token</field>
            <field name="value">example-0b01-4a31-a1ac-demo</field>
        </record>
        <!-- Interruptor de la medición de actividad: 'off' la apaga sin
             desinstalar nada (el controlador deja de guardar). -->
        <record id="som_activity_tracking" model="ir.config_parameter">
            <field name="key">som.activity_tracking</field>
            <field name="value">on</field>
        </record>
    </data>
</odoo>