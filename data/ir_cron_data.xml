<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Sincronización ShipsGo cada 2 horas -->
        <record id="ir_cron_shipsgo_sync_bihhourly" model="ir.cron">
            <field name="name">Torre de Control: Sincronizar ShipsGo (cada 1h)</field>
            <field name="model_id" ref="model_stock_transit_voyage"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_sync_shipsgo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

        <!-- Cron: Sincronización ShipsGo diaria a las 5am -->
        <record id="ir_cron_shipsgo_sync_daily" model="ir.cron">
            <field name="name">Torre de Control: Sincronizar ShipsGo (5am diario)</field>
            <field name="model_id" ref="model_stock_transit_voyage"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_sync_shipsgo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall">2025-01-01 11:00:00</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>