<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Sincronización ShipsGo cada 1 hora -->
        <record id="ir_cron_shipsgo_sync_bihhourly" model="ir.cron">
            <field name="name">Torre de Control: Sincronizar ShipsGo (cada 1h)</field>
            <field name="model_id" ref="model_stock_transit_voyage"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_sync_shipsgo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

        <!-- El cron diario de ShipsGo se eliminó: ejecutaba el MISMO
             action_cron_sync_shipsgo que el horario y a las 5am corrían en
             paralelo, pisando estados/ETA del mismo viaje y consumiendo cuota
             de API doble. Se desactiva en bases existentes vía migración. -->

        <!-- NUEVO Cron: Revisar alertas ETA (próximo a vencer / vencido) -->
        <!-- Se ejecuta cada hora porque las alertas dependen del paso del tiempo,
             no solo de cambios en el registro. Los flags eta_warning_notified y
             eta_overdue_notified evitan envíos repetidos. -->
        <record id="ir_cron_check_eta_alerts" model="ir.cron">
            <field name="name">Torre de Control: Revisar alertas ETA</field>
            <field name="model_id" ref="model_stock_transit_voyage"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_eta_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">15</field>
        </record>


        <!-- Poda de la medición de actividad: ~13 meses (comparativo año
             contra año). Sin esto, un latido cada 15 s por usuario acumula
             renglones para siempre. -->
        <record id="ir_cron_som_activity_gc" model="ir.cron">
            <field name="name">SOM: podar medición de actividad</field>
            <field name="model_id" ref="model_som_user_activity"/>
            <field name="state">code</field>
            <field name="code">model._som_gc_activity()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
            <field name="priority">50</field>
        </record>

        <!-- Procesamiento de PLs físicos grandes en segundo plano. Se
             dispara al instante con _trigger() al encolar un job; la corrida
             horaria es solo red de seguridad para jobs que queden en cola
             (p. ej. reinicio del servidor a media ejecución). -->
        <record id="ir_cron_tc_physical_pl_jobs" model="ir.cron">
            <field name="name">Torre de Control: Procesar PLs en segundo plano</field>
            <field name="model_id" ref="model_tc_physical_pl_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>