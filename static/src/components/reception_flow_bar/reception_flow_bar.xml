<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ReceptionFlowBar" owl="1">
        <div t-attf-class="o_rcpflow {{ complete ? 'o_rcpflow_complete' : '' }}">
            <t t-foreach="steps" t-as="s" t-key="s.n">
                <div t-if="!s_first" t-attf-class="o_rcpflow_link {{ s.state === 'done' ? 'done' : '' }}"/>
                <div t-attf-class="o_rcpflow_step {{ s.state }}"
                     t-att-title="s.n + ' · ' + s.label">
                    <!-- El dot SIEMPRE muestra el número del paso: el estado
                         (hecho / actual / pendiente) se comunica con color,
                         nunca sustituyendo el número por un ícono. -->
                    <div class="o_rcpflow_dot"><t t-esc="s.n"/></div>
                    <div class="o_rcpflow_label">
                        <span class="o_rcpflow_num"><t t-esc="s.n"/></span>
                        <t t-esc="s.label"/>
                    </div>
                </div>
            </t>
            <div t-if="complete" class="o_rcpflow_done_badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                Flujo completo
            </div>
        </div>
    </t>
</templates>
