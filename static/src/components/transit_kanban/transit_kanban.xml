<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="stock_transit_allocation.TransitKanbanView" owl="1">
<div class="tk-root">

    <!-- ══════════════════════════════════════════════════════
         TOOLBAR
    ══════════════════════════════════════════════════════ -->
    <div class="tk-toolbar">
        <div class="tk-toolbar__left">
            <i class="fa fa-ship tk-toolbar__icon"/>
            <span class="tk-toolbar__title">Viajes y Contenedores</span>
            <span class="tk-badge-count" t-esc="totalVoyages"/>
        </div>

        <div class="tk-search-wrap">
            <i class="fa fa-search tk-search-icon"/>
            <input class="tk-search-input"
                   type="text"
                   placeholder="Buscar viaje, OC, BL, buque, contenedor..."
                   t-att-value="state.searchText"
                   t-on-input="onSearch"/>
            <button class="tk-search-clear" t-if="state.searchText" t-on-click="clearSearch">
                <i class="fa fa-times"/>
            </button>
        </div>

        <div class="tk-toolbar__right">
            <button t-attf-class="tk-btn-pending #{state.pendingOnly ? 'tk-btn-pending--active' : ''}"
                    t-on-click="togglePendingOnly"
                    title="PL procesado, en Puerto Origen o superior, pasados los días configurados y el inventario sigue SIN publicar. El objetivo es que este filtro esté vacío.">
                <i class="fa fa-eye-slash"/> Pendiente de publicar
                <span t-if="pendingCount" class="tk-btn-pending__count" t-esc="pendingCount"/>
            </button>
            <button class="tk-btn-refresh" t-on-click="refresh" title="Actualizar">
                <i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''}"/>
            </button>
            <button class="tk-btn-new" t-on-click="createVoyage">
                <i class="fa fa-plus"/> Nuevo Viaje
            </button>
        </div>
    </div>

    <!-- LOADING -->
    <div class="tk-loading" t-if="state.loading">
        <i class="fa fa-spinner fa-spin fa-2x"/>
        <span>Cargando viajes...</span>
    </div>

    <!-- ══════════════════════════════════════════════════════
         BOARD
    ══════════════════════════════════════════════════════ -->
    <div class="tk-board" t-elif="!state.loading">
        <t t-foreach="STAGES" t-as="stage" t-key="stage.key">
            <t t-set="cards"    t-value="colCards(stage.key)"/>
            <t t-set="total"    t-value="colTotal(stage.key)"/>
            <t t-set="collapsed" t-value="isCollapsed(stage.key)"/>

            <div t-attf-class="tk-column #{isDropTarget(stage.key) ? 'tk-column--drop-target' : ''} #{collapsed ? 'tk-column--collapsed' : ''}"
                 t-attf-style="--col-color: #{stage.color}; --col-bg: #{stage.bg}; --col-border: #{stage.border};"
                 t-on-dragenter="(ev) => this.onColumnDragEnter(stage.key, ev)"
                 t-on-dragover="(ev) => this.onColumnDragOver(stage.key, ev)"
                 t-on-dragleave="(ev) => this.onColumnDragLeave(stage.key, ev)"
                 t-on-drop="(ev) => this.onColumnDrop(stage.key, ev)">

                <!-- Cabecera de columna -->
                <div class="tk-col-header" t-on-click="() => this.toggleCollapse(stage.key)">
                    <div class="tk-col-header__top">
                        <div class="tk-col-indicator"/>
                        <i t-attf-class="fa #{stage.icon} tk-col-icon"/>
                        <span class="tk-col-title" t-esc="stage.label"/>
                        <span class="tk-col-count" t-esc="total.count"/>
                        <!-- Abrir/cerrar el DETALLE de todas las tarjetas de la columna -->
                        <button t-if="!collapsed and cards.length"
                                t-attf-class="tk-col-detail-btn #{colAllExpanded(stage.key) ? 'tk-col-detail-btn--on' : ''}"
                                t-att-title="colAllExpanded(stage.key) ? 'Cerrar detalle de todas' : 'Abrir detalle de todas'"
                                t-on-click="(ev) => this.toggleColumnDetail(stage.key, ev)">
                            <i t-attf-class="fa #{colAllExpanded(stage.key) ? 'fa-compress' : 'fa-expand'}"/>
                        </button>
                        <i t-attf-class="fa #{collapsed ? 'fa-chevron-down' : 'fa-chevron-up'} tk-col-chevron"/>
                    </div>
                    <!-- Subtítulo eliminado (redundante); solo el total de m² -->
                    <div t-if="total.m2 > 0" class="tk-col-header__sub">
                        <span class="tk-col-m2">
                            <t t-esc="fmtNum(total.m2)"/> m²
                        </span>
                    </div>
                </div>

                <!-- Cards -->
                <div t-if="!collapsed" class="tk-cards">

                    <!-- Empty state -->
                    <div t-if="cards.length === 0" class="tk-empty-col">
                        <i class="fa fa-inbox tk-empty-col__icon"/>
                        <span>Sin viajes</span>
                    </div>

                    <t t-foreach="cards" t-as="card" t-key="card.id">
                        <div t-attf-class="tk-card #{isReceived(card) ? 'tk-card--received tk-card--lab-' + (card.labeling_status || 'none') : ''} #{isDragging(card.id) ? 'tk-card--dragging' : ''} #{isUpdating(card.id) ? 'tk-card--updating' : ''}"
                             draggable="true"
                             t-att-aria-grabbed="isDragging(card.id) ? 'true' : 'false'"
                             title="Arrastrar para cambiar de estado"
                             t-on-dragstart="(ev) => this.onCardDragStart(card, ev)"
                             t-on-dragend="onCardDragEnd"
                             t-on-click="(ev) => this.openVoyage(card.id, ev)">

                            <!-- COMPACTO: proveedor + días + desplegar -->
                            <div class="tk-card__header">
                                <span class="tk-card__name tk-card__supplier-name"
                                      t-esc="strOf(card.tc_supplier_id) || card.name"/>
                                <span class="tk-card__header-right">
                                    <!-- Toggle EN PRODUCCIÓN (solo columna Ordenado) -->
                                    <button t-if="isOrderStage(card)"
                                            t-attf-class="tk-prod-toggle #{isInProduction(card) ? 'tk-prod-toggle--on' : ''}"
                                            t-att-title="isInProduction(card) ? 'EN PRODUCCIÓN — clic para regresar a Solicitud' : 'Marcar EN PRODUCCIÓN'"
                                            t-on-click="(ev) => this.toggleProduction(card, ev)">
                                        <i class="fa fa-industry"/>
                                    </button>
                                    <!-- En recibidas la etiqueta 'Recibido'
                                         sobraba: el chip de etiquetado ya
                                         dice el estado. -->
                                    <span t-if="!isReceived(card)"
                                          t-attf-class="tk-eta #{etaClass(card)}"
                                          t-att-title="etaTitle(card)"
                                          t-esc="etaLabel(card)"/>
                                </span>
                            </div>

                            <!-- Recibida: la TARJETA entera se tiñe por el
                                 sub-estado de etiquetado — amarillo =
                                 entregado sin imprimir, naranja = en
                                 impresión (auto), verde = etiquetado. -->
                            <div t-if="isReceived(card)" class="tk-card__received-line">
                                <span t-attf-class="tk-labeling {{ labelingMeta(card).cls }}"
                                      t-att-title="labelingMeta(card).title">
                                    <i t-attf-class="fa {{ labelingMeta(card).icon }}"/>
                                    <t t-esc="labelingMeta(card).label"/>
                                </span>
                                <span t-if="hasContainer(card.container_number)"
                                      class="tk-card__received-cont"
                                      t-esc="card.container_number"/>
                            </div>

                            <!-- SIEMPRE visible (sin abrir detalle): OC como
                                 hipervínculo + folios de invoice del portal -->
                            <div t-if="card.purchase_id or card.portal_invoices"
                                 class="tk-card__quick">
                                <a t-if="card.purchase_id" href="#"
                                   class="tk-card__po-link"
                                   title="Abrir la Orden de Compra"
                                   t-on-click="(ev) => this.openPurchase(card, ev)">
                                    <i class="fa fa-file-text-o"/>
                                    <t t-esc="strOf(card.purchase_id)"/>
                                </a>
                                <span t-if="card.portal_invoices"
                                      class="tk-card__portal-inv"
                                      t-att-title="'Invoices del portal: ' + card.portal_invoices">
                                    <i class="fa fa-files-o"/>
                                    <t t-esc="card.portal_invoices"/>
                                </span>
                            </div>

                            <!-- Recepción parcial en curso: números claros -->
                            <div t-if="card.reception_partial and !isReceived(card)"
                                 class="tk-card__partial" t-esc="card.reception_partial"/>

                            <!-- Inventario sin publicar (alerta operativa, siempre visible) -->
                            <div t-if="card.tc_publication_pending and !isReceived(card)" class="tk-card__pending">
                                <i class="fa fa-eye-slash"/> Inventario SIN publicar
                            </div>

                            <!-- COMPACTO: contenedor -->
                            <div t-if="!isReceived(card)" class="tk-card__compactline">
                                <span class="tk-card__container"
                                      t-esc="hasContainer(card.container_number) ? card.container_number : 'SIN CONTENEDOR'"/>
                            </div>

                            <!-- COMPACTO: fechas ETD → ETA siempre visibles -->
                            <div t-if="!isReceived(card)" class="tk-card__dates">
                                <div class="tk-card__date">
                                    <span class="tk-card__date-label">ETD</span>
                                    <span t-esc="fmtDate(card.etd)"/>
                                </div>
                                <i class="fa fa-long-arrow-right tk-card__date-arrow"/>
                                <div class="tk-card__date">
                                    <span class="tk-card__date-label">ETA</span>
                                    <span t-esc="fmtDate(card.eta)"/>
                                </div>
                            </div>

                            <!-- DETALLE (desplegable): proforma + OC + factura de carga -->
                            <div t-if="isExpanded(card.id)" class="tk-card__more">
                                <div class="tk-card__pairs">
                                    <div class="tk-card__kv">
                                        <span class="tk-card__k">Proforma</span>
                                        <span class="tk-card__v" t-esc="card.partner_ref || '—'"
                                              t-att-title="card.partner_ref"/>
                                    </div>
                                    <div class="tk-card__kv">
                                        <span class="tk-card__k">Orden de compra</span>
                                        <span class="tk-card__v tk-card__v--oc"
                                              t-esc="strOf(card.purchase_id) || '—'"/>
                                    </div>
                                </div>
                                <div class="tk-card__pairs">
                                    <div class="tk-card__kv">
                                        <span class="tk-card__k">Fact. carga</span>
                                        <span class="tk-card__v" t-esc="card.cargo_invoices || '—'"
                                              t-att-title="card.cargo_invoices"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Desplegar / plegar -->
                            <button t-attf-class="tk-card__expand #{isExpanded(card.id) ? 'tk-card__expand--open' : ''}"
                                    t-att-title="isExpanded(card.id) ? 'Ocultar detalle' : 'Ver detalle'"
                                    t-on-click="(ev) => this.toggleExpand(card, ev)">
                                <i class="fa fa-chevron-down"/>
                                <span t-esc="isExpanded(card.id) ? 'Menos' : 'Detalle'"/>
                            </button>

                        </div>
                    </t>

                </div><!-- /tk-cards -->

            </div><!-- /tk-column -->
        </t>
    </div><!-- /tk-board -->

</div>
</t>
</templates>
