<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ToBeLoading" owl="1">
        <div class="tbl-app">
            <div class="tbl-topbar">
                <div class="tbl-title">
                    <h1>To Load</h1>
                    <p>Pedidos con material embarcado DIFERENTE a lo solicitado</p>
                </div>
                <input class="tbl-search" type="text" placeholder="Buscar pedido, proveedor o PI…"
                       t-att-value="state.search" t-on-input="onSearchInput"/>
                <span class="tbl-count" t-if="!state.loading">
                    <t t-esc="state.filtered.length"/> pedidos
                </span>
            </div>

            <div t-if="state.loading" class="tbl-empty">Cargando…</div>
            <div t-elif="state.error" class="tbl-error">
                <span t-esc="state.error"/>
                <button t-on-click="loadData">Reintentar</button>
            </div>
            <div t-elif="!state.filtered.length" class="tbl-empty">
                Sin discrepancias: todo lo embarcado coincide con lo solicitado.
            </div>

            <div t-else="" class="tbl-tablewrap">
                <table class="tbl-table">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Proveedor</th>
                            <th>PI</th>
                            <th>Confirmado</th>
                            <th class="r">Solicitado</th>
                            <th class="r">Embarcado</th>
                            <th class="r">Diferencia</th>
                            <th>Productos con diferencia</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.filtered" t-as="row" t-key="row.po_id"
                            t-on-click="() => this.openOrder(row)">
                            <td class="mono" t-esc="row.name"/>
                            <td class="ell" t-esc="row.partner"/>
                            <td class="mono" t-esc="row.pi or '—'"/>
                            <td class="mut" t-esc="row.date"/>
                            <td class="r" t-esc="fmt(row.solicitado)"/>
                            <td class="r strong" t-esc="fmt(row.embarcado)"/>
                            <td t-att-class="'r diff ' + (row.diff &gt; 0 ? 'over' : 'under')">
                                <t t-esc="(row.diff &gt; 0 ? '+' : '') + fmt(row.diff)"/>
                            </td>
                            <td class="tbl-diffcell">
                                <span t-foreach="row.diff_lines" t-as="d" t-key="d_index"
                                      class="tbl-diffchip"
                                      t-att-title="d.product + ': solicitado ' + fmt(d.solicitado) + ' / embarcado ' + fmt(d.embarcado)">
                                    <t t-esc="d.product"/>
                                    <b t-att-class="d.diff &gt; 0 ? 'over' : 'under'">
                                        <t t-esc="(d.diff &gt; 0 ? '+' : '') + fmt(d.diff)"/>
                                    </b>
                                </span>
                            </td>
                            <td class="tbl-opencell"><span class="tbl-open">Abrir →</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
