<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ToBeLoading" owl="1">
        <div class="o_opo_root">

            <!-- Toolbar (mismo lenguaje que To Be Purchased) -->
            <div class="o_opo_toolbar">
                <div class="o_opo_search">
                    <i class="fa fa-search o_opo_search_icon"/>
                    <input type="text"
                           class="o_opo_search_input"
                           placeholder="Buscar pedido, proveedor, PI o producto..."
                           t-att-value="state.search"
                           t-on-input="onSearchInput"/>
                    <button class="o_opo_search_clear" t-if="state.search" t-on-click="clearSearch">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <div class="o_opo_group_buttons">
                    <button t-attf-class="o_opo_group_btn #{state.groupBy === 'order' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('order')"
                            title="Agrupar por pedido de compra">
                        <i class="fa fa-file-text-o me-1"/> Pedido
                    </button>
                    <button t-attf-class="o_opo_group_btn #{state.groupBy === 'vendor' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('vendor')"
                            title="Agrupar por proveedor">
                        <i class="fa fa-truck me-1"/> Proveedor
                    </button>
                    <button t-attf-class="o_opo_group_btn #{state.groupBy === 'product' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('product')"
                            title="Agrupar por producto">
                        <i class="fa fa-cube me-1"/> Producto
                    </button>
                </div>

                <div class="o_opo_toolbar_spacer"/>

                <div class="o_opo_metrics">
                    <div class="o_opo_metric">
                        <span class="o_opo_metric_label" t-esc="groupMetricLabel"/>
                        <span class="o_opo_metric_value"><t t-esc="filteredGroups.length"/></span>
                    </div>
                    <div class="o_opo_metric">
                        <span class="o_opo_metric_label">Faltantes</span>
                        <span class="o_opo_metric_value"><t t-esc="totalProducts"/></span>
                    </div>
                </div>

                <button type="button" class="o_opo_group_btn"
                        t-on-click="loadData" t-att-disabled="state.loading">
                    <i t-attf-class="fa #{state.loading ? 'fa-spinner fa-spin' : 'fa-refresh'} me-1"/>
                    Actualizar
                </button>
            </div>

            <div t-if="state.loading" class="o_opo_empty">
                <i class="fa fa-circle-o-notch fa-spin me-2"/> Cargando pedidos con faltantes...
            </div>
            <div t-elif="state.error" class="o_opo_empty o_opo_error">
                <span t-esc="state.error"/>
                <button class="btn btn-sm btn-primary ms-2" t-on-click="loadData">Reintentar</button>
            </div>
            <div t-elif="!filteredGroups.length" class="o_opo_empty">
                <i class="fa fa-check-circle me-2" style="color: #04D94F;"/>
                Sin faltantes: nada embarcado por debajo de lo solicitado.
            </div>

            <div t-else="" class="o_opo_groups">
                <div t-foreach="filteredGroups" t-as="g" t-key="g.key" class="o_opo_group">

                    <!-- Cabecera del grupo (PI / proveedor / producto) -->
                    <div class="o_opo_group_head" t-on-click="() => this.toggleGroup(g)">
                        <div class="o_opo_group_left">
                            <i t-attf-class="fa o_opo_chevron #{isCollapsed(g) ? 'fa-chevron-right' : 'fa-chevron-down'}"/>
                            <div class="o_opo_group_titles">
                                <div class="o_opo_group_title">
                                    <span class="o_opo_pi_tag" t-esc="g.tag"/>
                                    <span class="o_opo_pi" t-esc="g.title"/>
                                    <span t-if="g.po_name" class="o_opo_po mono" t-esc="g.po_name"/>
                                </div>
                                <div class="o_opo_group_sub" t-esc="g.sub"/>
                            </div>
                        </div>

                        <div class="o_opo_group_stats">
                            <span class="o_opo_pill">
                                <span class="o_opo_pill_label">Solicitado</span>
                                <span class="o_opo_pill_value"><t t-esc="fmt(g.solicitado)"/></span>
                            </span>
                            <span class="o_opo_pill">
                                <span class="o_opo_pill_label">Embarcado</span>
                                <span class="o_opo_pill_value"><t t-esc="fmt(g.embarcado)"/></span>
                            </span>
                            <span class="o_opo_pill o_opo_pill_diff under">
                                <span class="o_opo_pill_label">Faltante</span>
                                <span class="o_opo_pill_value"><t t-esc="diffLabel(g.diff)"/></span>
                            </span>
                            <button class="o_opo_close_all_btn"
                                    title="Cerrar la demanda de TODAS las líneas de este grupo (cada cantidad se ajusta a lo embarcado)"
                                    t-on-click.stop="(ev) => this.closeDemandGroup(g, ev)">
                                <i class="fa fa-scissors me-1"/> Cerrar todos
                            </button>
                            <button t-if="g.po_id" class="o_opo_open_btn"
                                    t-on-click.stop="() => this.openOrder(g)">
                                <i class="fa fa-external-link me-1"/> Abrir orden
                            </button>
                        </div>
                    </div>

                    <!-- Líneas con faltante -->
                    <div t-if="!isCollapsed(g)" class="o_opo_group_body">
                        <table class="o_opo_table">
                            <thead>
                                <tr>
                                    <th t-if="state.groupBy !== 'order'">Pedido</th>
                                    <th t-if="state.groupBy === 'product'">Proveedor</th>
                                    <th t-if="state.groupBy !== 'product'">Producto</th>
                                    <th class="r">Solicitado</th>
                                    <th class="r">Embarcado</th>
                                    <th class="r">Faltante</th>
                                    <th class="c">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="g.rows" t-as="p" t-key="p.line_id">
                                    <td t-if="state.groupBy !== 'order'">
                                        <button class="o_opo_po_link mono"
                                                title="Abrir orden de compra"
                                                t-on-click="() => this.openOrderById(p.po_id)">
                                            <t t-esc="p.po_name"/>
                                        </button>
                                    </td>
                                    <td t-if="state.groupBy === 'product'" t-esc="p.partner"/>
                                    <td t-if="state.groupBy !== 'product'" class="o_opo_prod" t-esc="p.product"/>
                                    <td class="r"><t t-esc="fmt(p.solicitado)"/> <span class="o_opo_uom" t-esc="p.uom"/></td>
                                    <td class="r strong"><t t-esc="fmt(p.embarcado)"/></td>
                                    <td class="r o_opo_diff under">
                                        <t t-esc="diffLabel(p.diff)"/>
                                    </td>
                                    <td class="c">
                                        <button class="btn btn-sm btn-outline-danger o_opo_close_btn"
                                                t-att-disabled="state.closing[p.line_id]"
                                                t-on-click="() => this.closeDemand(g, p)">
                                            <i t-attf-class="fa #{state.closing[p.line_id] ? 'fa-spinner fa-spin' : 'fa-scissors'} me-1"/>
                                            Cerrar demanda
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
