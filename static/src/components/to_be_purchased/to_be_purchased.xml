<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ToBePurchased" owl="1">
        <div class="o_purchase_tbp_container p-3 bg-white" style="height: 100%; overflow-y: auto; font-size: 11px;">
            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="fa fa-industry me-2"/>To Be Purchased
                </h5>
                <button class="btn btn-sm btn-primary" t-on-click="openPurchaseModal" t-att-disabled="state.selectedLines.length === 0">
                    <i class="fa fa-cart-plus me-1"/> Generar OC (<t t-esc="state.selectedLines.length"/>)
                </button>
            </div>

            <!-- BARRA DE FILTROS -->
            <div class="d-flex gap-2 mb-3 align-items-center flex-wrap">
                <!-- Búsqueda -->
                <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text bg-white">
                        <i class="fa fa-search text-muted"/>
                    </span>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Buscar producto..."
                           t-att-value="state.searchQuery"
                           t-on-input="onSearchInput"/>
                    <button class="btn btn-outline-secondary" 
                            type="button" 
                            t-on-click="clearSearch"
                            t-att-disabled="!state.searchQuery">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <!-- Toggle Solo Pendientes -->
                <button t-attf-class="btn btn-sm #{state.showOnlyPending ? 'btn-warning' : 'btn-outline-secondary'}"
                        t-on-click="togglePendingFilter">
                    <i t-attf-class="fa #{state.showOnlyPending ? 'fa-filter' : 'fa-list'} me-1"/>
                    <t t-if="state.showOnlyPending">Solo Pendientes</t>
                    <t t-else="">Mostrar Todo</t>
                </button>

                <!-- SELECTOR DE AGRUPACIÓN -->
                <div class="btn-group btn-group-sm" role="group">
                    <button t-attf-class="btn #{state.groupBy === 'product' ? 'btn-primary' : 'btn-outline-primary'}"
                            t-on-click="() => this.setGroupBy('product')"
                            title="Agrupar por Producto">
                        <i class="fa fa-cube me-1"/>Producto
                    </button>
                    <button t-attf-class="btn #{state.groupBy === 'sale_order' ? 'btn-primary' : 'btn-outline-primary'}"
                            t-on-click="() => this.setGroupBy('sale_order')"
                            title="Agrupar por Orden de Venta">
                        <i class="fa fa-file-text-o me-1"/>Orden Venta
                    </button>
                    <button t-attf-class="btn #{state.groupBy === 'vendor' ? 'btn-primary' : 'btn-outline-primary'}"
                            t-on-click="() => this.setGroupBy('vendor')"
                            title="Agrupar por Proveedor">
                        <i class="fa fa-truck me-1"/>Proveedor
                    </button>
                </div>

                <!-- Contador de resultados -->
                <span class="text-muted small ms-auto">
                    <t t-esc="state.filteredData.length"/> 
                    <t t-if="state.groupBy === 'product'">producto(s)</t>
                    <t t-elif="state.groupBy === 'sale_order'">orden(es)</t>
                    <t t-else="">proveedor(es)</t>
                </span>
            </div>

            <!-- ============================================ -->
            <!-- VISTA AGRUPADA POR PRODUCTO (DEFAULT)       -->
            <!-- ============================================ -->
            <div class="table-responsive" t-if="state.groupBy === 'product'">
                <table class="table table-sm table-bordered table-hover mb-0" style="font-size: 10px;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 25px;"></th>
                            <th>Artículo</th>
                            <th>Tipo</th>
                            <th>Grupo</th>
                            <th>Categoría</th>
                            <th>Proveedor</th>
                            <th class="text-center" style="width: 50px;">A</th>
                            <th class="text-center" style="width: 50px;">I</th>
                            <th class="text-center" style="width: 50px;">P</th>
                            <th class="text-center" style="width: 60px;">Total</th>
                            <th class="text-center" style="width: 50px;">SO</th>
                            <th class="text-center" style="width: 60px;">Comprar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="state.filteredData.length === 0">
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                                    No hay productos pendientes por comprar
                                </td>
                            </tr>
                        </t>
                        <t t-foreach="state.filteredData" t-as="product" t-key="product.id">
                            <!-- Fila de Producto -->
                            <tr class="table-light" t-on-click="() => this.toggleExpand(product.id)" style="cursor: pointer;">
                                <td class="text-center p-1">
                                    <i t-attf-class="fa fa-xs #{state.expanded[product.id] ? 'fa-chevron-down' : 'fa-chevron-right'} text-primary"/>
                                </td>
                                <td class="fw-semibold text-truncate" style="max-width: 200px;" t-att-title="product.name">
                                    <t t-esc="product.name"/>
                                </td>
                                <td><t t-esc="product.type"/></td>
                                <td><t t-esc="product.group"/></td>
                                <td><t t-esc="product.category"/></td>
                                <td><t t-esc="product.vendor"/></td>
                                <td class="text-center"><t t-esc="product.qty_a.toFixed(2)"/></td>
                                <td class="text-center"><t t-esc="product.qty_i.toFixed(2)"/></td>
                                <td class="text-center"><t t-esc="product.qty_p.toFixed(2)"/></td>
                                <td class="text-center fw-semibold"><t t-esc="product.qty_total.toFixed(2)"/></td>
                                <td class="text-center"><t t-esc="product.qty_so.toFixed(2)"/></td>
                                <td t-attf-class="text-center fw-bold #{product.qty_to_buy > 0 ? 'text-danger' : 'text-success'}">
                                    <t t-esc="product.qty_to_buy.toFixed(2)"/>
                                </td>
                            </tr>
                            
                            <!-- Detalle de SO -->
                            <tr t-if="state.expanded[product.id]">
                                <td colspan="12" class="p-0 bg-light">
                                    <div class="p-2">
                                        <table class="table table-sm table-bordered bg-white mb-0" style="font-size: 9px;">
                                            <thead class="bg-secondary text-white">
                                                <tr>
                                                    <th class="text-center" style="width: 30px;">Sel</th>
                                                    <th style="width: 80px;">SO#</th>
                                                    <th style="width: 70px;">Fecha</th>
                                                    <th style="width: 70px;">Requerido</th>
                                                    <th>Cliente</th>
                                                    <th>Ubicación</th>
                                                    <th>Descripción</th>
                                                    <th class="text-end" style="width: 50px;">Cant</th>
                                                    <th class="text-end" style="width: 50px;">Asig</th>
                                                    <th class="text-end" style="width: 50px;">Pend</th>
                                                    <th style="width: 100px;">Nota</th>
                                                    <th style="width: 120px;">OC Vinculada</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="product.so_lines" t-as="so" t-key="so.id">
                                                    <tr>
                                                        <td class="text-center p-1">
                                                            <input type="checkbox" 
                                                                   class="form-check-input form-check-input-sm"
                                                                   style="width: 12px; height: 12px;"
                                                                   t-att-checked="state.selectedLines.includes(so.id)"
                                                                   t-on-change="(ev) => this.toggleSelection(so.id, ev)"
                                                                   t-att-disabled="so.po_id"/>
                                                        </td>
                                                        <td>
                                                            <a href="#" class="text-primary fw-semibold" 
                                                               t-on-click="(ev) => this.openSaleOrder(so.so_id, ev)">
                                                                <t t-esc="so.so_name"/>
                                                            </a>
                                                        </td>
                                                        <td><t t-esc="so.date"/></td>
                                                        <td><t t-esc="so.commitment_date"/></td>
                                                        <td class="text-truncate" style="max-width: 120px;" t-att-title="so.customer">
                                                            <t t-esc="so.customer"/>
                                                        </td>
                                                        <td><t t-esc="so.location"/></td>
                                                        <td class="text-muted text-truncate" style="max-width: 150px;" t-att-title="so.description">
                                                            <t t-esc="so.description"/>
                                                        </td>
                                                        <td class="text-end"><t t-esc="so.qty_orig.toFixed(2)"/></td>
                                                        <td class="text-end"><t t-esc="so.qty_assigned.toFixed(2)"/></td>
                                                        <td class="text-end fw-semibold text-primary"><t t-esc="so.qty_pending.toFixed(2)"/></td>
                                                        <td class="text-truncate" style="max-width: 100px;" t-att-title="so.note">
                                                            <t t-esc="so.note"/>
                                                        </td>
                                                        <td>
                                                            <t t-if="so.po_id">
                                                                <a href="#" 
                                                                   class="badge rounded-pill bg-success text-decoration-none"
                                                                   style="font-size: 9px; cursor: pointer;"
                                                                   t-on-click="(ev) => this.openPurchaseOrder(so.po_id, ev)"
                                                                   t-att-title="'Abrir ' + so.po_name">
                                                                    <i class="fa fa-external-link me-1"/>
                                                                    <t t-esc="so.po_name"/> (<t t-esc="so.po_qty.toFixed(2)"/>)
                                                                </a>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted" style="font-size: 9px;">Sin OC</span>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- ============================================ -->
            <!-- VISTA AGRUPADA POR ORDEN DE VENTA           -->
            <!-- ============================================ -->
            <div class="table-responsive" t-if="state.groupBy === 'sale_order'">
                <table class="table table-sm table-bordered table-hover mb-0" style="font-size: 10px;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 25px;"></th>
                            <th style="width: 100px;">Orden Venta</th>
                            <th style="width: 80px;">Fecha</th>
                            <th style="width: 80px;">Requerido</th>
                            <th>Cliente</th>
                            <th>Ubicación</th>
                            <th class="text-center" style="width: 80px;">Total Pend.</th>
                            <th style="width: 150px;">Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="state.filteredData.length === 0">
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                                    No hay órdenes pendientes
                                </td>
                            </tr>
                        </t>
                        <t t-foreach="state.filteredData" t-as="so" t-key="so.id">
                            <tr class="table-light" t-on-click="() => this.toggleExpand('so_' + so.id)" style="cursor: pointer;">
                                <td class="text-center p-1">
                                    <i t-attf-class="fa fa-xs #{state.expanded['so_' + so.id] ? 'fa-chevron-down' : 'fa-chevron-right'} text-primary"/>
                                </td>
                                <td>
                                    <a href="#" class="text-primary fw-bold" 
                                       t-on-click="(ev) => this.openSaleOrder(so.so_id, ev)">
                                        <t t-esc="so.so_name"/>
                                    </a>
                                </td>
                                <td><t t-esc="so.date"/></td>
                                <td><t t-esc="so.commitment_date"/></td>
                                <td class="fw-semibold"><t t-esc="so.customer"/></td>
                                <td><t t-esc="so.location"/></td>
                                <td class="text-center fw-bold text-danger"><t t-esc="so.total_pending.toFixed(2)"/></td>
                                <td class="text-truncate" style="max-width: 150px;" t-att-title="so.note">
                                    <t t-esc="so.note"/>
                                </td>
                            </tr>
                            
                            <tr t-if="state.expanded['so_' + so.id]">
                                <td colspan="8" class="p-0 bg-light">
                                    <div class="p-2">
                                        <table class="table table-sm table-bordered bg-white mb-0" style="font-size: 9px;">
                                            <thead class="bg-secondary text-white">
                                                <tr>
                                                    <th class="text-center" style="width: 30px;">Sel</th>
                                                    <th>Producto</th>
                                                    <th>Proveedor</th>
                                                    <th class="text-center" style="width: 45px;">A</th>
                                                    <th class="text-center" style="width: 45px;">I</th>
                                                    <th class="text-center" style="width: 45px;">P</th>
                                                    <th class="text-end" style="width: 60px;">Cant</th>
                                                    <th class="text-end" style="width: 60px;">Asig</th>
                                                    <th class="text-end" style="width: 60px;">Pend</th>
                                                    <th style="width: 120px;">OC Vinculada</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="so.products" t-as="prod" t-key="prod.id">
                                                    <tr>
                                                        <td class="text-center p-1">
                                                            <input type="checkbox" 
                                                                   class="form-check-input form-check-input-sm"
                                                                   style="width: 12px; height: 12px;"
                                                                   t-att-checked="state.selectedLines.includes(prod.id)"
                                                                   t-on-change="(ev) => this.toggleSelection(prod.id, ev)"
                                                                   t-att-disabled="prod.po_id"/>
                                                        </td>
                                                        <td class="fw-semibold text-truncate" style="max-width: 200px;" t-att-title="prod.product_name">
                                                            <t t-esc="prod.product_name"/>
                                                        </td>
                                                        <td><t t-esc="prod.vendor"/></td>
                                                        <td class="text-center"><t t-esc="prod.qty_a.toFixed(2)"/></td>
                                                        <td class="text-center"><t t-esc="prod.qty_i.toFixed(2)"/></td>
                                                        <td class="text-center"><t t-esc="prod.qty_p.toFixed(2)"/></td>
                                                        <td class="text-end"><t t-esc="prod.qty_orig.toFixed(2)"/></td>
                                                        <td class="text-end"><t t-esc="prod.qty_assigned.toFixed(2)"/></td>
                                                        <td class="text-end fw-semibold text-primary"><t t-esc="prod.qty_pending.toFixed(2)"/></td>
                                                        <td>
                                                            <t t-if="prod.po_id">
                                                                <a href="#" 
                                                                   class="badge rounded-pill bg-success text-decoration-none"
                                                                   style="font-size: 9px; cursor: pointer;"
                                                                   t-on-click="(ev) => this.openPurchaseOrder(prod.po_id, ev)"
                                                                   t-att-title="'Abrir ' + prod.po_name">
                                                                    <i class="fa fa-external-link me-1"/>
                                                                    <t t-esc="prod.po_name"/>
                                                                </a>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted" style="font-size: 9px;">Sin OC</span>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- ============================================ -->
            <!-- VISTA AGRUPADA POR PROVEEDOR                -->
            <!-- ============================================ -->
            <div class="table-responsive" t-if="state.groupBy === 'vendor'">
                <table class="table table-sm table-bordered table-hover mb-0" style="font-size: 10px;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 25px;"></th>
                            <th>Proveedor</th>
                            <th class="text-center" style="width: 100px;">Líneas</th>
                            <th class="text-center" style="width: 100px;">Total Pend.</th>
                            <th class="text-center" style="width: 100px;">A Comprar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="state.filteredData.length === 0">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                                    No hay proveedores con pendientes
                                </td>
                            </tr>
                        </t>
                        <t t-foreach="state.filteredData" t-as="vendor" t-key="vendor.vendor_name">
                            <tr class="table-light" t-on-click="() => this.toggleExpand('vendor_' + vendor.vendor_name)" style="cursor: pointer;">
                                <td class="text-center p-1">
                                    <i t-attf-class="fa fa-xs #{state.expanded['vendor_' + vendor.vendor_name] ? 'fa-chevron-down' : 'fa-chevron-right'} text-primary"/>
                                </td>
                                <td class="fw-bold">
                                    <i class="fa fa-truck me-2 text-muted"/>
                                    <t t-esc="vendor.vendor_name"/>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary"><t t-esc="vendor.products.length"/></span>
                                </td>
                                <td class="text-center fw-semibold"><t t-esc="vendor.total_pending.toFixed(2)"/></td>
                                <td t-attf-class="text-center fw-bold #{vendor.total_to_buy > 0 ? 'text-danger' : 'text-success'}">
                                    <t t-esc="vendor.total_to_buy.toFixed(2)"/>
                                </td>
                            </tr>
                            
                            <tr t-if="state.expanded['vendor_' + vendor.vendor_name]">
                                <td colspan="5" class="p-0 bg-light">
                                    <div class="p-2">
                                        <table class="table table-sm table-bordered bg-white mb-0" style="font-size: 9px;">
                                            <thead class="bg-secondary text-white">
                                                <tr>
                                                    <th class="text-center" style="width: 30px;">Sel</th>
                                                    <th>Producto</th>
                                                    <th style="width: 80px;">SO#</th>
                                                    <th>Cliente</th>
                                                    <th style="width: 70px;">Fecha</th>
                                                    <th class="text-center" style="width: 45px;">A</th>
                                                    <th class="text-center" style="width: 45px;">I</th>
                                                    <th class="text-center" style="width: 45px;">P</th>
                                                    <th class="text-end" style="width: 60px;">Pend</th>
                                                    <th style="width: 120px;">OC Vinculada</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="vendor.products" t-as="prod" t-key="prod.id">
                                                    <tr>
                                                        <td class="text-center p-1">
                                                            <input type="checkbox" 
                                                                   class="form-check-input form-check-input-sm"
                                                                   style="width: 12px; height: 12px;"
                                                                   t-att-checked="state.selectedLines.includes(prod.id)"
                                                                   t-on-change="(ev) => this.toggleSelection(prod.id, ev)"
                                                                   t-att-disabled="prod.po_id"/>
                                                        </td>
                                                        <td class="fw-semibold text-truncate" style="max-width: 180px;" t-att-title="prod.product_name">
                                                            <t t-esc="prod.product_name"/>
                                                        </td>
                                                        <td>
                                                            <a href="#" class="text-primary" 
                                                               t-on-click="(ev) => this.openSaleOrder(prod.so_id, ev)">
                                                                <t t-esc="prod.so_name"/>
                                                            </a>
                                                        </td>
                                                        <td class="text-truncate" style="max-width: 100px;" t-att-title="prod.customer">
                                                            <t t-esc="prod.customer"/>
                                                        </td>
                                                        <td><t t-esc="prod.date"/></td>
                                                        <td class="text-center"><t t-esc="prod.qty_a.toFixed(2)"/></td>
                                                        <td class="text-center"><t t-esc="prod.qty_i.toFixed(2)"/></td>
                                                        <td class="text-center"><t t-esc="prod.qty_p.toFixed(2)"/></td>
                                                        <td class="text-end fw-semibold text-primary"><t t-esc="prod.qty_pending.toFixed(2)"/></td>
                                                        <td>
                                                            <t t-if="prod.po_id">
                                                                <a href="#" 
                                                                   class="badge rounded-pill bg-success text-decoration-none"
                                                                   style="font-size: 9px; cursor: pointer;"
                                                                   t-on-click="(ev) => this.openPurchaseOrder(prod.po_id, ev)"
                                                                   t-att-title="'Abrir ' + prod.po_name">
                                                                    <i class="fa fa-external-link me-1"/>
                                                                    <t t-esc="prod.po_name"/>
                                                                </a>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted" style="font-size: 9px;">Sin OC</span>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- ================================================================ -->
            <!-- MODAL REDISEÑADO - ESTILO ODOO - SELECCIÓN DE PROVEEDOR          -->
            <!-- ================================================================ -->
            <t t-if="state.showModal">
                <div class="o_tbp_modal_backdrop" t-on-click="closeModal">
                    <div class="o_tbp_modal_dialog" t-on-click.stop="">
                        
                        <!-- HEADER -->
                        <div class="o_tbp_modal_header">
                            <div class="d-flex align-items-center gap-2">
                                <div class="o_tbp_modal_icon">
                                    <i class="fa fa-shopping-cart"/>
                                </div>
                                <div>
                                    <h4 class="mb-0 fw-bold">Generar Orden de Compra</h4>
                                    <small class="text-muted">Seleccione proveedor y configure la orden</small>
                                </div>
                            </div>
                            <button class="o_tbp_modal_close" t-on-click="closeModal">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <!-- BODY -->
                        <div class="o_tbp_modal_body">
                            
                            <!-- Resumen de selección -->
                            <div class="o_tbp_summary_banner">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="o_tbp_summary_count">
                                        <span class="o_tbp_count_number"><t t-esc="state.selectedLines.length"/></span>
                                    </div>
                                    <div>
                                        <div class="fw-semibold" style="font-size: 14px;">
                                            Línea(s) seleccionada(s)
                                        </div>
                                        <div class="text-muted" style="font-size: 12px;">
                                            Se generará una línea consolidada por producto
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SECCIÓN 1: PROVEEDOR -->
                            <div class="o_tbp_section">
                                <label class="o_tbp_section_label">
                                    <i class="fa fa-truck me-2"/>Proveedor
                                    <span class="text-danger ms-1">*</span>
                                </label>
                                
                                <div class="o_tbp_vendor_search_wrapper">
                                    <div class="o_tbp_search_input_container">
                                        <i class="fa fa-search o_tbp_search_icon"/>
                                        <input type="text" 
                                               class="o_tbp_search_input"
                                               placeholder="Escriba para buscar proveedor..."
                                               t-att-value="state.vendorSearch"
                                               t-on-input="onVendorSearchInput"
                                               t-on-focus="onVendorSearchFocus"
                                               t-on-blur="onVendorSearchBlur"
                                               autocomplete="off"/>
                                        <button class="o_tbp_search_clear" 
                                                t-on-click="clearVendorSelection"
                                                t-if="state.vendorSearch">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                    
                                    <!-- Dropdown de resultados -->
                                    <div t-if="state.showVendorDropdown and filteredVendors.length > 0" 
                                         class="o_tbp_vendor_dropdown">
                                        <t t-foreach="filteredVendors" t-as="vendor" t-key="vendor.id">
                                            <div t-attf-class="o_tbp_vendor_option #{state.selectedVendor === vendor.id ? 'selected' : ''}"
                                                 t-on-click="() => this.selectVendor(vendor)">
                                                <div class="o_tbp_vendor_avatar">
                                                    <i class="fa fa-building"/>
                                                </div>
                                                <div class="o_tbp_vendor_info">
                                                    <div class="o_tbp_vendor_name"><t t-esc="vendor.name"/></div>
                                                </div>
                                                <i t-if="state.selectedVendor === vendor.id" 
                                                   class="fa fa-check text-primary ms-auto"/>
                                            </div>
                                        </t>
                                    </div>
                                    
                                    <!-- Sin resultados -->
                                    <div t-if="state.showVendorDropdown and state.vendorSearch and filteredVendors.length === 0" 
                                         class="o_tbp_vendor_dropdown">
                                        <div class="o_tbp_vendor_empty">
                                            <i class="fa fa-search me-2 text-muted"/>
                                            No se encontraron proveedores para "<t t-esc="state.vendorSearch"/>"
                                        </div>
                                    </div>
                                </div>

                                <!-- Proveedor seleccionado -->
                                <div t-if="state.selectedVendor" class="o_tbp_vendor_selected">
                                    <div class="o_tbp_vendor_selected_badge">
                                        <div class="o_tbp_vendor_selected_avatar">
                                            <i class="fa fa-building"/>
                                        </div>
                                        <span class="fw-semibold"><t t-esc="state.selectedVendorName"/></span>
                                        <button class="o_tbp_vendor_remove" t-on-click="clearVendorSelection">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- SECCIÓN 2: OC EXISTENTE (solo si hay proveedor) -->
                            <t t-if="state.selectedVendor">
                                <div class="o_tbp_section">
                                    <label class="o_tbp_section_label">
                                        <i class="fa fa-file-text-o me-2"/>Orden de Compra
                                        <span class="text-muted fw-normal ms-2" style="font-size: 12px;">(opcional)</span>
                                    </label>
                                    
                                    <t t-if="state.loadingPOs">
                                        <div class="o_tbp_loading">
                                            <i class="fa fa-spinner fa-spin fa-lg me-2"/> 
                                            Buscando órdenes abiertas...
                                        </div>
                                    </t>
                                    
                                    <t t-elif="state.openPOs.length > 0">
                                        <!-- Opción: Crear nueva -->
                                        <div t-attf-class="o_tbp_po_option #{!state.selectedPO ? 'selected' : ''}"
                                             t-on-click="() => this.selectPO(null)">
                                            <div class="o_tbp_po_icon new">
                                                <i class="fa fa-plus"/>
                                            </div>
                                            <div class="o_tbp_po_info">
                                                <div class="fw-semibold">Crear Nueva Orden de Compra</div>
                                                <div class="text-muted" style="font-size: 11px;">Se generará una OC nueva para este proveedor</div>
                                            </div>
                                            <i t-if="!state.selectedPO" class="fa fa-check-circle text-primary ms-auto" style="font-size: 18px;"/>
                                        </div>
                                        
                                        <!-- Opciones: OCs existentes -->
                                        <t t-foreach="state.openPOs" t-as="po" t-key="po.id">
                                            <div t-attf-class="o_tbp_po_option #{state.selectedPO === po.id ? 'selected' : ''}"
                                                 t-on-click="() => this.selectPO(po.id)">
                                                <div class="o_tbp_po_icon existing">
                                                    <i class="fa fa-file-text"/>
                                                </div>
                                                <div class="o_tbp_po_info">
                                                    <div class="fw-semibold"><t t-esc="po.name"/></div>
                                                    <div class="d-flex gap-3 text-muted" style="font-size: 11px;">
                                                        <span><i class="fa fa-calendar me-1"/><t t-esc="po.date"/></span>
                                                        <span><i class="fa fa-list me-1"/><t t-esc="po.lines_count"/> líneas</span>
                                                        <span t-if="po.origin"><i class="fa fa-link me-1"/><t t-esc="po.origin"/></span>
                                                    </div>
                                                </div>
                                                <i t-if="state.selectedPO === po.id" class="fa fa-check-circle text-primary ms-auto" style="font-size: 18px;"/>
                                            </div>
                                        </t>
                                    </t>
                                    
                                    <t t-else="">
                                        <div class="o_tbp_po_empty">
                                            <i class="fa fa-info-circle me-2 text-primary"/>
                                            No hay OCs abiertas para este proveedor. Se creará una nueva automáticamente.
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <!-- FOOTER -->
                        <div class="o_tbp_modal_footer">
                            <button class="btn btn-light btn-lg px-4" t-on-click="closeModal">
                                Descartar
                            </button>
                            <button t-attf-class="btn btn-primary btn-lg px-4 #{!state.selectedVendor ? 'disabled' : ''}" 
                                    t-on-click="confirmPurchase"
                                    t-att-disabled="!state.selectedVendor">
                                <i t-attf-class="fa #{state.selectedPO ? 'fa-plus-circle' : 'fa-check'} me-2"/>
                                <t t-if="state.selectedPO">Agregar a OC Existente</t>
                                <t t-else="">Crear Orden de Compra</t>
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
