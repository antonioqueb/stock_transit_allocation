<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══ Íconos SVG hechos a mano (trazo 1.8, sin emojis) ═══ -->
    <t t-name="stock_transit_allocation.icon_anchor">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="5" r="2.4"/>
            <path d="M12 7.4V21"/>
            <path d="M8 10h8"/>
            <path d="M4 14c0 4 3.5 7 8 7s8-3 8-7"/>
            <path d="M4 14l-1.6 2.4M4 14l2.6 1.2M20 14l1.6 2.4M20 14l-2.6 1.2"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_boxcheck">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8l9-4.5L21 8v8l-9 4.5L3 16V8z"/>
            <path d="M3 8l9 4.5L21 8"/>
            <path d="M12 12.5V21"/>
            <path d="M8.5 14.8l2.2 2.2 4.4-4.4"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_warehouse">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21V9l9-5.5L21 9v12"/>
            <path d="M7 21v-7h10v7"/>
            <path d="M7 17.5h10"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3.5L22 20H2L12 3.5z"/>
            <path d="M12 10v4.5"/>
            <circle cx="12" cy="17.2" r="0.4" fill="currentColor"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_calendar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="5" width="17" height="16" rx="2.5"/>
            <path d="M8 3v4M16 3v4M3.5 10h17"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_open">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 4h6v6"/>
            <path d="M20 4L11 13"/>
            <path d="M19 14v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_user">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.6"/>
            <path d="M5 20.5c1.3-3.4 4-5 7-5s5.7 1.6 7 5"/>
        </svg>
    </t>
    <t t-name="stock_transit_allocation.icon_chevron">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6"/>
        </svg>
    </t>

    <!-- ═══ Tarjeta de viaje: compacta, click para desplegar ═══ -->
    <t t-name="stock_transit_allocation.ReceptionCard">
        <div t-attf-class="o_rcp_card {{ card.late_days ? 'late' : '' }} {{ this.isExpanded(card) ? 'open' : '' }}">
            <div class="o_rcp_card_head" t-on-click="() => this.toggleCard(card)">
                <div class="o_rcp_card_headmain">
                    <!-- Jerarquía: PROVEEDOR manda, contenedor visible,
                         el folio del embarque al final sin protagonismo. -->
                    <div class="o_rcp_card_name" t-esc="card.supplier or card.name"/>
                    <div class="o_rcp_card_cont main" t-if="card.containers" t-esc="card.containers"/>
                    <div class="o_rcp_card_sub">
                        <t t-if="card.po"><t t-esc="card.po"/> · </t>
                        <span class="o_rcp_folio" t-esc="card.name"/>
                    </div>
                    <div t-if="card.partial_info" class="o_rcp_partial">
                        <div class="o_rcp_partial_txt" t-esc="card.partial_info"/>
                        <div class="o_rcp_partial_bar">
                            <div t-attf-style="width: {{ card.partial_pct }}%;"/>
                            <span t-esc="card.partial_pct + '%'"/>
                        </div>
                    </div>
                    <!-- Contenedor SIEMPRE visible, aun con la tarjeta
                         compactada. -->
                </div>
                <span t-if="card.late_days" class="o_rcp_badge red">
                    <t t-call="stock_transit_allocation.icon_alert"/>
                    <t t-esc="card.late_days"/> días
                </span>
                <span t-else=""
                      t-attf-class="o_rcp_badge {{ this.etaBadge(card).cls }}">
                    <t t-call="stock_transit_allocation.icon_calendar"/>
                    <t t-esc="this.etaBadge(card).text"/>
                </span>
                <span class="o_rcp_chev"><t t-call="stock_transit_allocation.icon_chevron"/></span>
            </div>

            <div t-if="this.isExpanded(card)" class="o_rcp_card_body">
                <div class="o_rcp_card_sub muted" t-if="card.vessel" t-esc="card.vessel"/>

                <div class="o_rcp_card_stats">
                    <span><b t-esc="card.qty_label or '0'"/></span>
                    <span><b t-esc="card.lots"/> lotes</span>
                    <span><b t-esc="card.products"/> productos</span>
                    <span t-if="card.eta">ETA <b t-esc="card.eta"/></span>
                </div>

                <div t-if="card.published" class="o_rcp_pub">
                    <t t-call="stock_transit_allocation.icon_user"/>
                    <span>Publicado por <b t-esc="card.published_by"/> · <t t-esc="card.published_at"/></span>
                </div>

                <div class="o_rcp_card_actions">
                    <button class="o_rcp_btn ghost" t-on-click.stop="() => this.showMaterials(card)">
                        Materiales
                    </button>
                    <button t-if="card.reception_id and card.phase === 'ready' and !card.needs_reopen"
                            class="o_rcp_btn primary"
                            t-on-click.stop="() => this.openReception(card.reception_id)">
                        Recepción <t t-esc="card.reception_name ? '· ' + card.reception_name : ''"/>
                    </button>
                    <button t-if="card.needs_reopen"
                            class="o_rcp_btn primary"
                            title="Crear la recepción del material pendiente"
                            t-on-click.stop="(ev) => this.reopenReception(card, ev)">
                        Reabrir recepción
                    </button>
                    <button t-if="card.reception_id"
                            class="o_rcp_btn ghost"
                            title="Imprimir Worksheet"
                            t-on-click.stop="(ev) => this.printWorksheet(card.reception_id, ev)">
                        Worksheet
                    </button>
                </div>
            </div>
        </div>
    </t>

    <!-- ═══ Popup de materiales (todo lo que almacén ve del embarque) ═══ -->
    <t t-name="stock_transit_allocation.MaterialsModal">
        <div class="o_rcp_modal_bg" t-on-click="closeMaterials">
            <div class="o_rcp_modal" t-on-click.stop="">
                <div class="o_rcp_modal_head">
                    <div>
                        <div class="t" t-esc="state.detail.name"/>
                        <div class="s">
                            <t t-if="state.detail.supplier"><t t-esc="state.detail.supplier"/></t>
                            <t t-if="state.detail.vessel"> · <t t-esc="state.detail.vessel"/></t>
                            <t t-if="state.detail.eta"> · ETA <t t-esc="state.detail.eta"/></t>
                        </div>
                        <div class="s muted" t-if="state.detail.containers" t-esc="state.detail.containers"/>
                    </div>
                    <button class="o_rcp_modal_x" t-on-click="closeMaterials">✕</button>
                </div>
                <div class="o_rcp_modal_body">
                    <div class="o_rcp_mat_row head">
                        <span>Material</span><b>Cantidad</b>
                    </div>
                    <div class="o_rcp_mat_row" t-foreach="state.detail.materials" t-as="m" t-key="m.product + m.uom">
                        <span t-att-title="m.product" t-esc="m.product"/>
                        <b><t t-esc="m.qty"/> <small t-esc="m.uom"/></b>
                    </div>
                    <div t-if="!state.detail.materials.length" class="o_rcp_empty">
                        Sin materiales capturados aún
                    </div>
                </div>
                <div class="o_rcp_modal_foot">
                    <span><b t-esc="state.detail.lots"/> lotes · <b t-esc="state.detail.products"/> productos</span>
                    <span class="tot"><b t-esc="state.detail.qty_label"/></span>
                </div>
            </div>
        </div>
    </t>

    <!-- ═══ Tablero ═══ -->
    <t t-name="stock_transit_allocation.ReceptionsDashboard">
        <div class="o_receptions_dash">
            <div class="o_rcp_topbar">
                <div class="o_rcp_title">Recepciones</div>
                <button class="o_rcp_btn ghost" t-on-click="openReceptionsList">
                    Ver todas las recepciones <t t-call="stock_transit_allocation.icon_open"/>
                </button>
            </div>

            <div t-if="state.loading" class="o_rcp_loading">Cargando…</div>

            <t t-if="!state.loading and state.data">
                <div class="o_rcp_cols">
                    <div class="o_rcp_col">
                        <div class="o_rcp_col_head blue">
                            <t t-call="stock_transit_allocation.icon_anchor"/>
                            <span>En puerto</span>
                            <b t-esc="state.data.port.length"/>
                        </div>
                        <t t-foreach="state.data.port" t-as="card" t-key="card.id">
                            <t t-call="stock_transit_allocation.ReceptionCard"/>
                        </t>
                        <div t-if="!state.data.port.length" class="o_rcp_empty">Sin contenedores en puerto</div>
                    </div>
                    <div class="o_rcp_col">
                        <div class="o_rcp_col_head strong">
                            <t t-call="stock_transit_allocation.icon_boxcheck"/>
                            <span>Listos para recibir</span>
                            <b t-esc="state.data.ready.length"/>
                        </div>
                        <t t-foreach="state.data.ready" t-as="card" t-key="card.id">
                            <t t-call="stock_transit_allocation.ReceptionCard"/>
                        </t>
                        <div t-if="!state.data.ready.length" class="o_rcp_empty">Nada pendiente de recibir</div>
                    </div>
                    <div class="o_rcp_col">
                        <div class="o_rcp_col_head green">
                            <t t-call="stock_transit_allocation.icon_warehouse"/>
                            <span>Recepcionados</span>
                            <b t-esc="state.data.done.length"/>
                        </div>
                        <div t-if="state.data.done.length" class="o_rcp_done_list">
                            <div class="o_rcp_done_row rich"
                                 t-foreach="state.data.done" t-as="row" t-key="row.id"
                                 t-on-click="() => this.openReception(row.reception_id)">
                                <div class="o_rcp_done_main">
                                    <span class="s" t-esc="row.supplier or row.folio"/>
                                    <span class="c" t-if="row.containers" t-esc="row.containers"/>
                                    <span class="q" t-if="row.qty_label" t-esc="row.qty_label"/>
                                </div>
                                <div class="o_rcp_done_meta">
                                    <span t-if="row.po" t-esc="row.po"/>
                                    <span t-if="row.po"> · </span>
                                    <span class="f" t-esc="row.folio"/>
                                    <span t-if="row.partial_tag" class="o_rcp_partial_tag">
                                        · <t t-esc="row.partial_tag"/>
                                    </span>
                                    <span t-if="row.embarque"> · <t t-esc="row.embarque"/></span>
                                    <span class="d"> · <t t-esc="row.done"/></span>
                                </div>
                                <div class="o_rcp_row_actions">
                                    <button class="o_rcp_ws_btn"
                                            title="Imprimir Worksheet"
                                            t-on-click.stop="(ev) => this.printWorksheet(row.reception_id, ev)">
                                        Worksheet
                                    </button>
                                    <!-- Check de ETIQUETADO: se habilita solo
                                         cuando ya hubo impresión. -->
                                    <button t-attf-class="o_rcp_lab_check o_rcp_lab_check--{{ row.labeling_status || 'none' }}"
                                            t-att-disabled="labCheckDisabled(row)"
                                            t-att-title="labCheckTitle(row)"
                                            t-on-click.stop="(ev) => this.toggleLabeled(row, ev)">
                                        <i t-attf-class="fa {{ row.labeling_status === 'labeled' ? 'fa-check-square' : 'fa-square-o' }}"/>
                                        <span t-esc="labCheckLabel(row)"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div t-if="!state.data.done.length" class="o_rcp_empty">Sin recepciones en 7 días</div>
                    </div>
                </div>
            </t>

            <t t-if="state.detail" t-call="stock_transit_allocation.MaterialsModal"/>
        </div>
    </t>
</templates>
