<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ToBeAllocated" owl="1">
        <div class="o_tba_root">
            <div class="o_tba_header">
                <div class="o_tba_title_block">
                    <div class="o_tba_title">
                        <i class="fa fa-object-group me-2"/>
                        To Be Allocated
                    </div>
                    <div class="o_tba_subtitle">
                        Pedidos confirmados con demanda pendiente y stock disponible.
                    </div>
                </div>

                <div class="o_tba_kpis">
                    <div class="o_tba_kpi">
                        <span class="o_tba_kpi_label">Líneas</span>
                        <strong><t t-esc="totalLines"/></strong>
                    </div>
                    <div class="o_tba_kpi">
                        <span class="o_tba_kpi_label">Solicitado</span>
                        <strong><t t-esc="fmtNum(totalRequested)"/></strong>
                    </div>
                    <div class="o_tba_kpi">
                        <span class="o_tba_kpi_label">Asignado</span>
                        <strong><t t-esc="fmtNum(totalAssigned)"/></strong>
                    </div>
                    <div class="o_tba_kpi o_tba_kpi_pending">
                        <span class="o_tba_kpi_label">Pendiente</span>
                        <strong><t t-esc="fmtNum(totalPending)"/></strong>
                    </div>
                </div>

                <div class="o_tba_header_actions">
                    <button class="btn btn-sm btn-outline-primary"
                            t-on-click="refresh"
                            t-att-disabled="state.loading">
                        <i t-attf-class="fa #{state.loading ? 'fa-spinner fa-spin' : 'fa-refresh'} me-1"/>
                        Actualizar
                    </button>
                </div>
            </div>

            <div class="o_tba_toolbar">
                <div class="o_tba_search">
                    <i class="fa fa-search"/>
                    <input type="text"
                           placeholder="Buscar por pedido, cliente, producto o vendedor..."
                           t-att-value="state.searchQuery"
                           t-on-input="onSearchInput"/>
                    <button t-if="state.searchQuery"
                            class="o_tba_search_clear"
                            t-on-click="clearSearch">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <div class="o_tba_group_buttons">
                    <button t-att-class="state.groupBy === 'product' ? 'active' : ''"
                            t-on-click="() => this.setGroupBy('product')">
                        Producto
                    </button>
                    <button t-att-class="state.groupBy === 'sale_order' ? 'active' : ''"
                            t-on-click="() => this.setGroupBy('sale_order')">
                        Pedido
                    </button>
                    <button t-att-class="state.groupBy === 'salesperson' ? 'active' : ''"
                            t-on-click="() => this.setGroupBy('salesperson')">
                        Vendedor
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="o_tba_loading">
                <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                <span>Cargando requerimientos...</span>
            </div>

            <div t-elif="!state.filteredData.length" class="o_tba_empty">
                <i class="fa fa-check-circle fa-3x"/>
                <strong>Sin pendientes para asignar</strong>
                <span>No hay líneas con demanda pendiente y stock disponible.</span>
            </div>

            <div t-else="" class="o_tba_content">
                <t t-foreach="state.filteredData" t-as="group" t-key="group.key">
                    <div class="o_tba_group">
                        <div class="o_tba_group_header"
                             t-on-click="() => this.toggleExpand(group.key)">
                            <div class="o_tba_group_left">
                                <i t-attf-class="fa #{isExpanded(group.key) ? 'fa-chevron-down' : 'fa-chevron-right'} me-2"/>
                                <div>
                                    <strong><t t-esc="group.label"/></strong>
                                    <span><t t-esc="group.sublabel"/></span>
                                </div>
                            </div>

                            <div class="o_tba_group_metrics">
                                <span>
                                    Solicitado:
                                    <strong><t t-esc="fmtNum(group.qty_requested)"/></strong>
                                </span>
                                <span>
                                    Asignado:
                                    <strong><t t-esc="fmtNum(group.qty_assigned)"/></strong>
                                </span>
                                <span>
                                    Pendiente:
                                    <strong><t t-esc="fmtNum(group.qty_pending)"/></strong>
                                </span>
                                <span>
                                    Disponible:
                                    <strong><t t-esc="fmtNum(group.qty_available)"/></strong>
                                </span>
                            </div>
                        </div>

                        <div t-if="isExpanded(group.key)" class="o_tba_group_body">
                            <table class="o_tba_table">
                                <thead>
                                    <tr>
                                        <th>Pedido</th>
                                        <th>Cliente</th>
                                        <th>Producto</th>
                                        <th>Vendedor</th>
                                        <th class="text-end">Pago</th>
                                        <th class="text-end">Solicitado</th>
                                        <th class="text-end">Asignado</th>
                                        <th class="text-end">Pendiente</th>
                                        <th class="text-end">Disponible</th>
                                        <th class="text-end">% Asig.</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="group.lines" t-as="line" t-key="line.id">
                                        <tr>
                                            <td>
                                                <button class="btn btn-link p-0 fw-bold"
                                                        t-on-click="(ev) => this.openSaleOrder(line.so_id, ev)">
                                                    <t t-esc="line.so_name"/>
                                                </button>
                                                <div class="text-muted small">
                                                    <t t-esc="line.commitment_date"/>
                                                </div>
                                            </td>

                                            <td>
                                                <t t-esc="line.customer"/>
                                            </td>

                                            <td>
                                                <strong><t t-esc="line.product_name"/></strong>
                                                <div t-if="line.description" class="text-muted small">
                                                    <t t-esc="line.description"/>
                                                </div>
                                            </td>

                                            <td>
                                                <t t-esc="line.salesperson or '-'"/>
                                            </td>

                                            <td class="text-end">
                                                <span t-att-class="'o_tba_payment_badge ' + paymentClass(line.payment_percent)">
                                                    <t t-esc="fmtPercent(line.payment_percent)"/>
                                                </span>
                                            </td>

                                            <td class="text-end fw-bold">
                                                <t t-esc="fmtNum(line.qty_ordered)"/>
                                            </td>

                                            <td class="text-end">
                                                <t t-esc="fmtNum(line.qty_assigned)"/>
                                            </td>

                                            <td class="text-end text-danger fw-bold">
                                                <t t-esc="fmtNum(line.qty_pending)"/>
                                            </td>

                                            <td class="text-end">
                                                <t t-esc="fmtNum(line.qty_available)"/>
                                            </td>

                                            <td class="text-end">
                                                <t t-esc="fmtPercent(line.assignment_percent || 0)"/>
                                            </td>

                                            <td>
                                                <span t-attf-class="badge rounded-pill #{line.assignment_state === 'partial' ? 'text-bg-warning' : line.assignment_state === 'open' ? 'text-bg-secondary' : line.assignment_state === 'over_assigned' ? 'text-bg-danger' : 'text-bg-light'}">
                                                    <t t-esc="assignmentStateLabel(line.assignment_state)"/>
                                                </span>
                                            </td>

                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        t-att-disabled="state.assigning[line.id]"
                                                        t-on-click="(ev) => this.openAllocationPopup(line, ev)"
                                                        title="Abrir selector de placas para esta línea">
                                                    <i t-attf-class="fa #{state.assigning[line.id] ? 'fa-spinner fa-spin' : 'fa-th'} me-1"/>
                                                    Asignar
                                                </button>

                                                <button class="btn btn-sm btn-warning me-1"
                                                        t-att-disabled="state.sending[line.id]"
                                                        t-on-click="(ev) => this.sendToPurchase(line, ev)"
                                                        title="El vendedor rechaza el stock y manda a compra">
                                                    <i t-attf-class="fa #{state.sending[line.id] ? 'fa-spinner fa-spin' : 'fa-shopping-cart'} me-1"/>
                                                    Mandar pedido
                                                </button>

                                                <button class="btn btn-sm btn-outline-secondary"
                                                        t-att-disabled="state.closing[line.id]"
                                                        t-on-click="(ev) => this.closeShort(line, ev)"
                                                        title="Cerrar el pendiente sin modificar la cantidad solicitada">
                                                    <i t-attf-class="fa #{state.closing[line.id] ? 'fa-spinner fa-spin' : 'fa-lock'} me-1"/>
                                                    Cerrar
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>