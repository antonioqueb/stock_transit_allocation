<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ToBeAllocated" owl="1">
        <div class="o_tba_root">
            <!-- Header -->
            <div class="o_tba_header">
                <div class="o_tba_title_box">
                    <div class="o_tba_icon">
                        <i class="fa fa-th-large"/>
                    </div>
                    <div>
                        <h3 class="o_tba_title">To Be Allocated</h3>
                        <div class="o_tba_subtitle">
                            Pedidos con pendiente comercial y stock disponible para seleccionar placas.
                        </div>
                    </div>
                </div>

                <div class="o_tba_metrics">
                    <div class="o_tba_metric">
                        <span class="o_tba_metric_label">Líneas</span>
                        <span class="o_tba_metric_value"><t t-esc="totalLines"/></span>
                    </div>
                    <div class="o_tba_metric">
                        <span class="o_tba_metric_label">Pendiente</span>
                        <span class="o_tba_metric_value"><t t-esc="fmtNum(totalPending)"/></span>
                    </div>
                </div>

                <button class="btn btn-sm btn-outline-primary" t-on-click="refresh">
                    <i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''} me-1"/>
                    Actualizar
                </button>
            </div>

            <!-- Toolbar -->
            <div class="o_tba_toolbar">
                <div class="o_tba_search">
                    <i class="fa fa-search o_tba_search_icon"/>
                    <input type="text"
                           class="o_tba_search_input"
                           placeholder="Buscar SO, cliente, producto, vendedor..."
                           t-att-value="state.searchQuery"
                           t-on-input="onSearchInput"/>
                    <button class="o_tba_search_clear"
                            t-if="state.searchQuery"
                            t-on-click="clearSearch">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <div class="o_tba_group_buttons">
                    <button t-attf-class="o_tba_group_btn #{state.groupBy === 'product' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('product')">
                        <i class="fa fa-cube me-1"/> Producto
                    </button>
                    <button t-attf-class="o_tba_group_btn #{state.groupBy === 'sale_order' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('sale_order')">
                        <i class="fa fa-file-text-o me-1"/> Orden
                    </button>
                    <button t-attf-class="o_tba_group_btn #{state.groupBy === 'salesperson' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('salesperson')">
                        <i class="fa fa-user me-1"/> Vendedor
                    </button>
                </div>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="o_tba_loading">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <span>Cargando pendientes por asignar...</span>
            </div>

            <!-- Empty -->
            <div t-elif="!state.loading and state.filteredData.length === 0" class="o_tba_empty">
                <i class="fa fa-check-circle"/>
                <h4>Sin pendientes por asignar</h4>
                <p>No hay líneas con stock disponible esperando selección de placas.</p>
            </div>

            <!-- Groups -->
            <div t-else="" class="o_tba_groups">
                <t t-foreach="state.filteredData" t-as="group" t-key="group.key">
                    <div class="o_tba_group">
                        <div class="o_tba_group_header" t-on-click="() => this.toggleExpand(group.key)">
                            <div class="o_tba_group_left">
                                <i t-attf-class="fa #{isExpanded(group.key) ? 'fa-chevron-down' : 'fa-chevron-right'} o_tba_chevron"/>
                                <div>
                                    <div class="o_tba_group_title">
                                        <t t-esc="group.label"/>
                                    </div>
                                    <div class="o_tba_group_subtitle">
                                        <t t-esc="group.sublabel"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_tba_group_stats">
                                <span t-attf-class="o_tba_payment_badge #{paymentClass(group.max_payment_percent)}">
                                    Pago <t t-esc="fmtPercent(group.max_payment_percent)"/>
                                </span>
                                <span class="o_tba_stat">
                                    <b><t t-esc="group.lines.length"/></b> línea(s)
                                </span>
                                <span class="o_tba_stat">
                                    Pend. <b><t t-esc="fmtNum(group.qty_pending)"/></b>
                                </span>
                                <span class="o_tba_stat o_tba_stat_available">
                                    Stock <b><t t-esc="fmtNum(group.qty_available)"/></b>
                                </span>
                            </div>
                        </div>

                        <div t-if="isExpanded(group.key)" class="o_tba_table_wrap">
                            <table class="o_tba_table">
                                <thead>
                                    <tr>
                                        <th>SO</th>
                                        <th>Cliente</th>
                                        <th>Producto</th>
                                        <th>Vendedor</th>
                                        <th>Fecha</th>
                                        <th>Requerido</th>
                                        <th class="text-end">Pedido</th>
                                        <th class="text-end">Asignado</th>
                                        <th class="text-end">Pendiente</th>
                                        <th class="text-end">Stock libre</th>
                                        <th class="text-center">Pago</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="group.lines" t-as="line" t-key="line.id">
                                        <tr>
                                            <td>
                                                <a href="#"
                                                   class="o_tba_so_link"
                                                   t-on-click="(ev) => this.openSaleOrder(line.so_id, ev)">
                                                    <t t-esc="line.so_name"/>
                                                </a>
                                            </td>
                                            <td>
                                                <div class="o_tba_cell_main"><t t-esc="line.customer"/></div>
                                                <div t-if="line.note" class="o_tba_cell_note" t-att-title="line.note">
                                                    <i class="fa fa-sticky-note-o me-1"/>
                                                    Nota
                                                </div>
                                            </td>
                                            <td>
                                                <div class="o_tba_cell_main"><t t-esc="line.product_name"/></div>
                                                <div class="o_tba_cell_sub" t-att-title="line.description">
                                                    <t t-esc="line.description"/>
                                                </div>
                                            </td>
                                            <td><t t-esc="line.salesperson || '—'"/></td>
                                            <td><t t-esc="line.date"/></td>
                                            <td><t t-esc="line.commitment_date"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(line.qty_ordered)"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(line.qty_assigned)"/></td>
                                            <td class="text-end o_tba_pending_qty"><t t-esc="fmtNum(line.qty_pending)"/></td>
                                            <td class="text-end o_tba_available_qty"><t t-esc="fmtNum(line.qty_available)"/></td>
                                            <td class="text-center">
                                                <span t-attf-class="o_tba_payment_badge #{paymentClass(line.payment_percent)}">
                                                    <t t-esc="fmtPercent(line.payment_percent)"/>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        t-att-disabled="state.assigning[line.id]"
                                                        t-on-click="(ev) => this.openAllocationPopup(line, ev)"
                                                        title="Abrir selector de placas para esta línea">
                                                    <i t-attf-class="fa #{state.assigning[line.id] ? 'fa-spinner fa-spin' : 'fa-th'} me-1"/>
                                                    Asignar
                                                </button>
                                                <button class="btn btn-sm btn-warning"
                                                        t-att-disabled="state.sending[line.id]"
                                                        t-on-click="(ev) => this.sendToPurchase(line, ev)"
                                                        title="El vendedor rechaza el stock y manda a compra">
                                                    <i t-attf-class="fa #{state.sending[line.id] ? 'fa-spinner fa-spin' : 'fa-shopping-cart'} me-1"/>
                                                    Mandar pedido
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>