<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_transit_allocation.ToBePurchased" owl="1">
        <div class="o_purchase_tbp_container o_tbp_root">

            <!-- Toolbar superior: sin repetir el título de la acción -->
            <div class="o_tbp_toolbar">
                <div class="o_tbp_search">
                    <i class="fa fa-search o_tbp_search_icon"/>
                    <input type="text"
                           class="o_tbp_search_input"
                           placeholder="Buscar producto, SO, cliente, proveedor..."
                           t-att-value="state.searchQuery"
                           t-on-input="onSearchInput"/>
                    <button class="o_tbp_search_clear"
                            t-if="state.searchQuery"
                            t-on-click="clearSearch">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <button t-attf-class="o_tbp_filter_btn #{state.showOnlyPending ? 'active' : ''}"
                        t-on-click="togglePendingFilter">
                    <i t-attf-class="fa #{state.showOnlyPending ? 'fa-filter' : 'fa-list'} me-1"/>
                    <t t-if="state.showOnlyPending">Solo pendientes</t>
                    <t t-else="">Mostrar todo</t>
                </button>

                <div class="o_tbp_group_buttons">
                    <button t-attf-class="o_tbp_group_btn #{state.groupBy === 'product' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('product')"
                            title="Agrupar por producto">
                        <i class="fa fa-cube me-1"/> Producto
                    </button>
                    <button t-attf-class="o_tbp_group_btn #{state.groupBy === 'sale_order' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('sale_order')"
                            title="Agrupar por orden de venta">
                        <i class="fa fa-file-text-o me-1"/> Orden
                    </button>
                    <button t-attf-class="o_tbp_group_btn #{state.groupBy === 'vendor' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('vendor')"
                            title="Agrupar por proveedor">
                        <i class="fa fa-truck me-1"/> Proveedor
                    </button>
                    <button t-attf-class="o_tbp_group_btn #{state.groupBy === 'customer' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('customer')"
                            title="Agrupar por cliente">
                        <i class="fa fa-users me-1"/> Cliente
                    </button>
                    <button t-attf-class="o_tbp_group_btn #{state.groupBy === 'unit_type' ? 'active' : ''}"
                            t-on-click="() => this.setGroupBy('unit_type')"
                            title="Agrupar por tipo de producto">
                        <i class="fa fa-balance-scale me-1"/> Tipo
                    </button>
                </div>

                <div class="o_tbp_toolbar_spacer"/>

                <div class="o_tbp_metrics">
                    <div class="o_tbp_metric">
                        <span class="o_tbp_metric_label">Grupos</span>
                        <span class="o_tbp_metric_value"><t t-esc="state.filteredData.length"/></span>
                    </div>

                    <div class="o_tbp_metric">
                        <span class="o_tbp_metric_label">Seleccionadas</span>
                        <span class="o_tbp_metric_value"><t t-esc="state.selectedLines.length"/></span>
                    </div>

                    <div class="o_tbp_metric">
                        <span class="o_tbp_metric_label">SO m²</span>
                        <span class="o_tbp_metric_value"><t t-esc="fmtNum(totalDemandM2)"/></span>
                    </div>

                    <div class="o_tbp_metric">
                        <span class="o_tbp_metric_label">SO pzas</span>
                        <span class="o_tbp_metric_value"><t t-esc="fmtNum(totalDemandPieces)"/></span>
                    </div>

                    <div class="o_tbp_metric">
                        <span class="o_tbp_metric_label">Comprar m²</span>
                        <span class="o_tbp_metric_value"><t t-esc="fmtNum(totalToBuyM2)"/></span>
                    </div>

                    <div class="o_tbp_metric">
                        <span class="o_tbp_metric_label">Comprar pzas</span>
                        <span class="o_tbp_metric_value"><t t-esc="fmtNum(totalToBuyPieces)"/></span>
                    </div>
                </div>

                <button class="btn btn-sm btn-primary o_tbp_generate_btn"
                        t-on-click="openPurchaseModal"
                        t-att-disabled="state.selectedLines.length === 0">
                    <i class="fa fa-cart-plus me-1"/>
                    Generar OC
                    <span class="o_tbp_btn_count">(<t t-esc="state.selectedLines.length"/>)</span>
                </button>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="o_tbp_loading_state">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <span>Cargando pendientes por compra...</span>
            </div>

            <!-- Empty general -->
            <div t-elif="!state.loading and state.filteredData.length === 0" class="o_tbp_empty_state">
                <i class="fa fa-check-circle"/>
                <h4>Sin pendientes por comprar</h4>
                <p>No hay líneas pendientes que requieran generar orden de compra.</p>
            </div>

            <!-- ============================================================ -->
            <!-- AGRUPADO POR PRODUCTO                                       -->
            <!-- ============================================================ -->
            <div t-else="" class="o_tbp_groups">

                <t t-if="state.groupBy === 'product'">
                    <t t-foreach="state.filteredData" t-as="product" t-key="product.id">
                        <div class="o_tbp_group">
                            <div class="o_tbp_group_header" t-on-click="() => this.toggleExpand(product.id)">
                                <div class="o_tbp_group_left">
                                    <i t-attf-class="fa #{state.expanded[product.id] ? 'fa-chevron-down' : 'fa-chevron-right'} o_tbp_chevron"/>
                                    <div>
                                        <div class="o_tbp_group_title">
                                            <t t-esc="product.name"/>
                                        </div>
                                        <div class="o_tbp_group_subtitle">
                                            <span><t t-esc="product.vendor || 'Sin proveedor'"/></span>
                                            <span class="o_tbp_dot">•</span>
                                            <span><t t-esc="product.product_type || product.type || 'Sin tipo'"/></span>
                                            <span class="o_tbp_dot">•</span>
                                            <span><t t-esc="product.category || 'Sin categoría'"/></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_tbp_group_stats">
                                    <span class="o_tbp_stat">
                                        A <b><t t-esc="fmtQtyWithUnit(product.qty_a, product.unit_label)"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        I <b><t t-esc="fmtQtyWithUnit(product.qty_i, product.unit_label)"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        P <b><t t-esc="fmtQtyWithUnit(product.qty_p, product.unit_label)"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        SO <b><t t-esc="fmtQtyWithUnit(product.qty_so, product.unit_label)"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        Total <b><t t-esc="fmtQtyWithUnit(product.qty_total, product.unit_label)"/></b>
                                    </span>
                                    <span t-attf-class="o_tbp_stat o_tbp_stat_buy #{product.qty_to_buy > 0 ? 'is-positive' : 'is-ok'}">
                                        Comprar <b><t t-esc="fmtQtyWithUnit(product.qty_to_buy, product.unit_label)"/></b>
                                    </span>
                                </div>
                            </div>

                            <div t-if="state.expanded[product.id]" class="o_tbp_table_wrap">
                                <table class="o_tbp_table">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 42px;">Sel</th>
                                            <th style="width: 90px;">SO</th>
                                            <th style="width: 88px;">Fecha</th>
                                            <th style="width: 98px;">Requerido</th>
                                            <th>Cliente</th>
                                            <th>Ubicación</th>
                                            <th>Descripción</th>
                                            <th>Tipo</th>
                                            <th class="text-end" style="width: 92px;">Días</th>
                                            <th class="text-end" style="width: 84px;">Cant.</th>
                                            <th class="text-end" style="width: 74px;">Asig.</th>
                                            <th class="text-end" style="width: 74px;">Pend.</th>
                                            <th style="width: 130px;">Nota</th>
                                            <th style="width: 160px;">OC vinculada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="product.so_lines" t-as="so" t-key="so.id">
                                            <tr>
                                                <td class="text-center o_tbp_select_cell">
                                                    <input type="checkbox"
                                                           class="form-check-input o_tbp_checkbox"
                                                           t-att-checked="state.selectedLines.includes(so.id)"
                                                           t-on-change="(ev) => this.toggleSelection(so.id, ev)"
                                                           t-att-disabled="so.po_id"/>
                                                </td>
                                                <td>
                                                    <a href="#"
                                                       class="o_tbp_link"
                                                       t-on-click="(ev) => this.openSaleOrder(so.so_id, ev)">
                                                        <t t-esc="so.so_name"/>
                                                    </a>
                                                </td>
                                                <td><t t-esc="so.date"/></td>
                                                <td><t t-esc="so.commitment_date"/></td>
                                                <td>
                                                    <div class="o_tbp_cell_main" t-att-title="so.customer">
                                                        <t t-esc="so.customer"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="o_tbp_cell_sub" t-att-title="so.location">
                                                        <t t-esc="so.location"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="o_tbp_cell_sub" t-att-title="so.description">
                                                        <t t-esc="so.description"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="o_tbp_empty_badge"><t t-esc="so.product_type || so.unit_label || '-'"/></span>
                                                </td>
                                                <td class="text-end"><t t-esc="fmtDays(so.days_unassigned || 0)"/></td>
                                                <td class="text-end"><t t-esc="fmtQtyWithUnit(so.qty_orig, so.unit_label)"/></td>
                                                <td class="text-end"><t t-esc="fmtQtyWithUnit(so.qty_assigned, so.unit_label)"/></td>
                                                <td class="text-end o_tbp_pending_qty"><t t-esc="fmtQtyWithUnit(so.qty_pending, so.unit_label)"/></td>
                                                <td>
                                                    <div t-if="so.note" class="o_tbp_cell_note" t-att-title="so.note">
                                                        <i class="fa fa-sticky-note-o me-1"/>
                                                        Nota
                                                    </div>
                                                    <span t-else="" class="o_tbp_empty_text">—</span>
                                                </td>
                                                <td>
                                                    <t t-if="so.po_id">
                                                        <a href="#"
                                                           class="o_tbp_po_badge"
                                                           t-on-click="(ev) => this.openPurchaseOrder(so.po_id, ev)"
                                                           t-att-title="'Abrir ' + so.po_name">
                                                            <i class="fa fa-external-link me-1"/>
                                                            <t t-esc="so.po_name"/>
                                                            <span class="o_tbp_po_qty">(<t t-esc="fmtQtyWithUnit(so.po_qty, so.unit_label)"/>)</span>
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="o_tbp_empty_badge">Sin OC</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- ======================================================== -->
                <!-- AGRUPADO POR ORDEN DE VENTA                             -->
                <!-- ======================================================== -->
                <t t-elif="state.groupBy === 'sale_order'">
                    <t t-foreach="state.filteredData" t-as="so" t-key="so.id">
                        <div class="o_tbp_group">
                            <div class="o_tbp_group_header" t-on-click="() => this.toggleExpand('so_' + so.id)">
                                <div class="o_tbp_group_left">
                                    <i t-attf-class="fa #{state.expanded['so_' + so.id] ? 'fa-chevron-down' : 'fa-chevron-right'} o_tbp_chevron"/>
                                    <div>
                                        <div class="o_tbp_group_title">
                                            <a href="#"
                                               class="o_tbp_link"
                                               t-on-click="(ev) => this.openSaleOrder(so.so_id, ev)">
                                                <t t-esc="so.so_name"/>
                                            </a>
                                        </div>
                                        <div class="o_tbp_group_subtitle">
                                            <span><t t-esc="so.customer"/></span>
                                            <span class="o_tbp_dot">•</span>
                                            <span><t t-esc="so.location || 'Sin ubicación'"/></span>
                                            <span class="o_tbp_dot">•</span>
                                            <span>Req. <t t-esc="so.commitment_date"/></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_tbp_group_stats">
                                    <span class="o_tbp_stat">
                                        Fecha <b><t t-esc="so.date"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        Líneas <b><t t-esc="so.products.length"/></b>
                                    </span>
                                    <span class="o_tbp_stat o_tbp_stat_buy is-positive">
                                        Pendiente <b><t t-esc="fmtSplitQty(so.total_pending_m2, so.total_pending_pieces)"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        Días <b><t t-esc="fmtDays(so.max_days_unassigned)"/></b>
                                    </span>
                                </div>
                            </div>

                            <div t-if="state.expanded['so_' + so.id]" class="o_tbp_table_wrap">
                                <table class="o_tbp_table">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 42px;">Sel</th>
                                            <th>Producto</th>
                                            <th>Proveedor</th>
                                            <th>Tipo</th>
                                            <th class="text-end" style="width: 92px;">Días</th>
                                            <th class="text-center" style="width: 72px;">A</th>
                                            <th class="text-center" style="width: 60px;">I</th>
                                            <th class="text-center" style="width: 60px;">P</th>
                                            <th class="text-end" style="width: 76px;">Cant.</th>
                                            <th class="text-end" style="width: 76px;">Asig.</th>
                                            <th class="text-end" style="width: 76px;">Pend.</th>
                                            <th style="width: 160px;">OC vinculada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="so.products" t-as="prod" t-key="prod.id">
                                            <tr>
                                                <td class="text-center o_tbp_select_cell">
                                                    <input type="checkbox"
                                                           class="form-check-input o_tbp_checkbox"
                                                           t-att-checked="state.selectedLines.includes(prod.id)"
                                                           t-on-change="(ev) => this.toggleSelection(prod.id, ev)"
                                                           t-att-disabled="prod.po_id"/>
                                                </td>
                                                <td>
                                                    <div class="o_tbp_cell_main" t-att-title="prod.product_name">
                                                        <t t-esc="prod.product_name"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="o_tbp_cell_sub" t-att-title="prod.vendor">
                                                        <t t-esc="prod.vendor"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="o_tbp_empty_badge"><t t-esc="prod.product_type || prod.unit_label || '-'"/></span>
                                                </td>
                                                <td class="text-end"><t t-esc="fmtDays(prod.days_unassigned || 0)"/></td>
                                                <td class="text-center"><t t-esc="fmtQtyWithUnit(prod.qty_a, prod.unit_label)"/></td>
                                                <td class="text-center"><t t-esc="fmtQtyWithUnit(prod.qty_i, prod.unit_label)"/></td>
                                                <td class="text-center"><t t-esc="fmtQtyWithUnit(prod.qty_p, prod.unit_label)"/></td>
                                                <td class="text-end"><t t-esc="fmtQtyWithUnit(prod.qty_orig, prod.unit_label)"/></td>
                                                <td class="text-end"><t t-esc="fmtQtyWithUnit(prod.qty_assigned, prod.unit_label)"/></td>
                                                <td class="text-end o_tbp_pending_qty"><t t-esc="fmtQtyWithUnit(prod.qty_pending, prod.unit_label)"/></td>
                                                <td>
                                                    <t t-if="prod.po_id">
                                                        <a href="#"
                                                           class="o_tbp_po_badge"
                                                           t-on-click="(ev) => this.openPurchaseOrder(prod.po_id, ev)"
                                                           t-att-title="'Abrir ' + prod.po_name">
                                                            <i class="fa fa-external-link me-1"/>
                                                            <t t-esc="prod.po_name"/>
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="o_tbp_empty_badge">Sin OC</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- ======================================================== -->
                <!-- AGRUPADO OPERATIVO: PROVEEDOR / CLIENTE / TIPO          -->
                <!-- ======================================================== -->
                <t t-else="">
                    <t t-foreach="state.filteredData" t-as="vendor" t-key="vendor.group_key">
                        <div class="o_tbp_group">
                            <div class="o_tbp_group_header" t-on-click="() => this.toggleExpand(vendor.group_key)">
                                <div class="o_tbp_group_left">
                                    <i t-attf-class="fa #{state.expanded[vendor.group_key] ? 'fa-chevron-down' : 'fa-chevron-right'} o_tbp_chevron"/>
                                    <div>
                                        <div class="o_tbp_group_title">
                                            <t t-esc="vendor.group_name"/>
                                        </div>
                                        <div class="o_tbp_group_subtitle">
                                            <t t-esc="vendor.group_subtitle"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_tbp_group_stats">
                                    <span class="o_tbp_stat">
                                        Líneas <b><t t-esc="vendor.products.length"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        Pendiente <b><t t-esc="fmtSplitQty(vendor.total_pending_m2, vendor.total_pending_pieces)"/></b>
                                    </span>
                                    <span t-attf-class="o_tbp_stat o_tbp_stat_buy #{vendor.total_to_buy > 0 ? 'is-positive' : 'is-ok'}">
                                        Comprar <b><t t-esc="fmtSplitQty(vendor.total_to_buy_m2, vendor.total_to_buy_pieces)"/></b>
                                    </span>
                                    <span class="o_tbp_stat">
                                        Días <b><t t-esc="fmtDays(vendor.max_days_unassigned)"/></b>
                                    </span>
                                </div>
                            </div>

                            <div t-if="state.expanded[vendor.group_key]" class="o_tbp_table_wrap">
                                <table class="o_tbp_table">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 42px;">Sel</th>
                                            <th>Producto</th>
                                            <th style="width: 90px;">SO</th>
                                            <th>Cliente</th>
                                            <th style="width: 88px;">Fecha</th>
                                            <th>Tipo</th>
                                            <th class="text-end" style="width: 92px;">Días</th>
                                            <th class="text-center" style="width: 72px;">A</th>
                                            <th class="text-center" style="width: 60px;">I</th>
                                            <th class="text-center" style="width: 60px;">P</th>
                                            <th class="text-end" style="width: 76px;">Pend.</th>
                                            <th style="width: 160px;">OC vinculada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="vendor.products" t-as="prod" t-key="prod.id">
                                            <tr>
                                                <td class="text-center o_tbp_select_cell">
                                                    <input type="checkbox"
                                                           class="form-check-input o_tbp_checkbox"
                                                           t-att-checked="state.selectedLines.includes(prod.id)"
                                                           t-on-change="(ev) => this.toggleSelection(prod.id, ev)"
                                                           t-att-disabled="prod.po_id"/>
                                                </td>
                                                <td>
                                                    <div class="o_tbp_cell_main" t-att-title="prod.product_name">
                                                        <t t-esc="prod.product_name"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <a href="#"
                                                       class="o_tbp_link"
                                                       t-on-click="(ev) => this.openSaleOrder(prod.so_id, ev)">
                                                        <t t-esc="prod.so_name"/>
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="o_tbp_cell_sub" t-att-title="prod.customer">
                                                        <t t-esc="prod.customer"/>
                                                    </div>
                                                </td>
                                                <td><t t-esc="prod.date"/></td>
                                                <td>
                                                    <span class="o_tbp_empty_badge"><t t-esc="prod.product_type || prod.unit_label || '-'"/></span>
                                                </td>
                                                <td class="text-end"><t t-esc="fmtDays(prod.days_unassigned || 0)"/></td>
                                                <td class="text-center"><t t-esc="fmtQtyWithUnit(prod.qty_a, prod.unit_label)"/></td>
                                                <td class="text-center"><t t-esc="fmtQtyWithUnit(prod.qty_i, prod.unit_label)"/></td>
                                                <td class="text-center"><t t-esc="fmtQtyWithUnit(prod.qty_p, prod.unit_label)"/></td>
                                                <td class="text-end o_tbp_pending_qty"><t t-esc="fmtQtyWithUnit(prod.qty_pending, prod.unit_label)"/></td>
                                                <td>
                                                    <t t-if="prod.po_id">
                                                        <a href="#"
                                                           class="o_tbp_po_badge"
                                                           t-on-click="(ev) => this.openPurchaseOrder(prod.po_id, ev)"
                                                           t-att-title="'Abrir ' + prod.po_name">
                                                            <i class="fa fa-external-link me-1"/>
                                                            <t t-esc="prod.po_name"/>
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="o_tbp_empty_badge">Sin OC</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </div>

            <!-- ================================================================ -->
            <!-- MODAL - SELECCIÓN DE PROVEEDOR                                  -->
            <!-- ================================================================ -->
            <t t-if="state.showModal">
                <div class="o_tbp_modal_backdrop" t-on-click="closeModal">
                    <div class="o_tbp_modal_dialog" t-on-click.stop="">

                        <div class="o_tbp_modal_header">
                            <div class="d-flex align-items-center gap-2">
                                <div class="o_tbp_modal_icon">
                                    <i class="fa fa-shopping-cart"/>
                                </div>
                                <div>
                                    <h4 class="mb-0 fw-bold">Generar Orden de Compra</h4>
                                    <small class="text-muted">Seleccione proveedor y configure la orden</small>
                                </div>
                            </div>
                            <button class="o_tbp_modal_close" t-on-click="closeModal">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <div class="o_tbp_modal_body">

                            <div class="o_tbp_summary_banner">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="o_tbp_summary_count">
                                        <span class="o_tbp_count_number"><t t-esc="state.selectedLines.length"/></span>
                                    </div>
                                    <div>
                                        <div class="fw-semibold" style="font-size: 14px;">
                                            Línea(s) seleccionada(s)
                                        </div>
                                        <div class="text-muted" style="font-size: 12px;">
                                            Se generará una línea consolidada por producto
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="o_tbp_section">
                                <label class="o_tbp_section_label">
                                    <i class="fa fa-truck me-2"/>Proveedor
                                    <span class="text-danger ms-1">*</span>
                                </label>

                                <div class="o_tbp_vendor_search_wrapper">
                                    <div class="o_tbp_search_input_container">
                                        <i class="fa fa-search o_tbp_search_icon"/>
                                        <input type="text"
                                               class="o_tbp_search_input"
                                               placeholder="Escriba para buscar proveedor..."
                                               t-att-value="state.vendorSearch"
                                               t-on-input="onVendorSearchInput"
                                               t-on-focus="onVendorSearchFocus"
                                               t-on-blur="onVendorSearchBlur"
                                               autocomplete="off"/>
                                        <button class="o_tbp_search_clear"
                                                t-on-click="clearVendorSelection"
                                                t-if="state.vendorSearch">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>

                                    <div t-if="state.showVendorDropdown and filteredVendors.length > 0"
                                         class="o_tbp_vendor_dropdown">
                                        <t t-foreach="filteredVendors" t-as="vendor" t-key="vendor.id">
                                            <div t-attf-class="o_tbp_vendor_option #{state.selectedVendor === vendor.id ? 'selected' : ''}"
                                                 t-on-click="() => this.selectVendor(vendor)">
                                                <div class="o_tbp_vendor_avatar">
                                                    <i class="fa fa-building"/>
                                                </div>
                                                <div class="o_tbp_vendor_info">
                                                    <div class="o_tbp_vendor_name"><t t-esc="vendor.name"/></div>
                                                </div>
                                                <i t-if="state.selectedVendor === vendor.id"
                                                   class="fa fa-check text-primary ms-auto"/>
                                            </div>
                                        </t>
                                    </div>

                                    <div t-if="state.showVendorDropdown and state.vendorSearch and filteredVendors.length === 0"
                                         class="o_tbp_vendor_dropdown">
                                        <div class="o_tbp_vendor_empty">
                                            <i class="fa fa-search me-2 text-muted"/>
                                            No se encontraron proveedores para "<t t-esc="state.vendorSearch"/>"
                                        </div>
                                    </div>
                                </div>

                                <div t-if="state.selectedVendor" class="o_tbp_vendor_selected">
                                    <div class="o_tbp_vendor_selected_badge">
                                        <div class="o_tbp_vendor_selected_avatar">
                                            <i class="fa fa-building"/>
                                        </div>
                                        <span class="fw-semibold"><t t-esc="state.selectedVendorName"/></span>
                                        <button class="o_tbp_vendor_remove" t-on-click="clearVendorSelection">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <t t-if="state.selectedVendor">
                                <div class="o_tbp_section">
                                    <label class="o_tbp_section_label">
                                        <i class="fa fa-file-text-o me-2"/>Orden de Compra
                                        <span class="text-muted fw-normal ms-2" style="font-size: 12px;">(opcional)</span>
                                    </label>

                                    <t t-if="state.loadingPOs">
                                        <div class="o_tbp_loading">
                                            <i class="fa fa-spinner fa-spin fa-lg me-2"/>
                                            Buscando órdenes abiertas...
                                        </div>
                                    </t>

                                    <t t-elif="state.openPOs.length > 0">
                                        <div t-attf-class="o_tbp_po_option #{!state.selectedPO ? 'selected' : ''}"
                                             t-on-click="() => this.selectPO(null)">
                                            <div class="o_tbp_po_icon new">
                                                <i class="fa fa-plus"/>
                                            </div>
                                            <div class="o_tbp_po_info">
                                                <div class="fw-semibold">Crear nueva orden de compra</div>
                                                <div class="text-muted" style="font-size: 11px;">
                                                    Se generará una OC nueva para este proveedor
                                                </div>
                                            </div>
                                            <i t-if="!state.selectedPO"
                                               class="fa fa-check-circle text-primary ms-auto"
                                               style="font-size: 18px;"/>
                                        </div>

                                        <t t-foreach="state.openPOs" t-as="po" t-key="po.id">
                                            <div t-attf-class="o_tbp_po_option #{state.selectedPO === po.id ? 'selected' : ''}"
                                                 t-on-click="() => this.selectPO(po.id)">
                                                <div class="o_tbp_po_icon existing">
                                                    <i class="fa fa-file-text"/>
                                                </div>
                                                <div class="o_tbp_po_info">
                                                    <div class="fw-semibold"><t t-esc="po.name"/></div>
                                                    <div class="d-flex gap-3 text-muted" style="font-size: 11px;">
                                                        <span><i class="fa fa-calendar me-1"/><t t-esc="po.date"/></span>
                                                        <span><i class="fa fa-list me-1"/><t t-esc="po.lines_count"/> líneas</span>
                                                        <span t-if="po.origin"><i class="fa fa-link me-1"/><t t-esc="po.origin"/></span>
                                                    </div>
                                                </div>
                                                <i t-if="state.selectedPO === po.id"
                                                   class="fa fa-check-circle text-primary ms-auto"
                                                   style="font-size: 18px;"/>
                                            </div>
                                        </t>
                                    </t>

                                    <t t-else="">
                                        <div class="o_tbp_po_empty">
                                            <i class="fa fa-info-circle me-2 text-primary"/>
                                            No hay OCs abiertas para este proveedor. Se creará una nueva automáticamente.
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <div class="o_tbp_modal_footer">
                            <button class="btn btn-light btn-lg px-4" t-on-click="closeModal">
                                Descartar
                            </button>
                            <button t-attf-class="btn btn-primary btn-lg px-4 #{!state.selectedVendor ? 'disabled' : ''}"
                                    t-on-click="confirmPurchase"
                                    t-att-disabled="!state.selectedVendor">
                                <i t-attf-class="fa #{state.selectedPO ? 'fa-plus-circle' : 'fa-check'} me-2"/>
                                <t t-if="state.selectedPO">Agregar a OC existente</t>
                                <t t-else="">Crear orden de compra</t>
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>