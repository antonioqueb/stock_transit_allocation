<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="stock_transit_allocation.TransitVoyageLines" owl="1">

<div class="tvl-root">

    <!-- LOADING -->
    <div t-if="state.loading" class="tvl-loading">
        <div class="tvl-loading__spinner"/>
        <span>Cargando lotes...</span>
    </div>

    <t t-else="">

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <div class="tvl-toolbar">
            <div class="tvl-toolbar__left">
                <!-- El resumen global (cantidades, barra, %) vive SOLO en la
                     cabecera negra: aquí únicamente el conteo de contexto. -->
                <span class="tvl-toolbar__stat">
                    <strong t-esc="state.groups.length"/> productos
                    <span class="tvl-toolbar__divider"/>
                    <strong t-esc="state.groups.reduce((s,g) => s + g.lot_count, 0)"/> lotes
                </span>
            </div>

            <div class="tvl-toolbar__right">
                <button t-attf-class="tvl-chip-filter #{state.activeFilter === 'unassigned' ? 'tvl-chip-filter--on' : ''}"
                        t-on-click="() => this.setFilter('unassigned')"
                        title="Mostrar solo material sin asignar">
                    Sin asignar<t t-if="filterCount('unassigned')"> · <t t-esc="filterCount('unassigned')"/></t>
                </button>
                <button t-attf-class="tvl-chip-filter #{state.activeFilter === 'client_no_order' ? 'tvl-chip-filter--on' : ''}"
                        t-on-click="() => this.setFilter('client_no_order')"
                        title="Mostrar solo material con cliente pero sin pedido">
                    Cliente sin pedido<t t-if="filterCount('client_no_order')"> · <t t-esc="filterCount('client_no_order')"/></t>
                </button>
                <button class="tvl-btn tvl-btn--refresh" t-on-click="expandAll" title="Expandir todos los productos">
                    <i class="fa fa-angle-double-down"/>
                </button>
                <button class="tvl-btn tvl-btn--refresh" t-on-click="collapseAll" title="Colapsar todos los productos">
                    <i class="fa fa-angle-double-up"/>
                </button>
                <button class="tvl-btn tvl-btn--refresh" t-on-click="refresh" title="Recargar">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
        </div>

        <!-- ══════════════ CENTRO DE INCIDENCIAS (accionable, compacto) ══════════════ -->
        <div t-if="issues.length" class="tvl-issues">
            <t t-foreach="issues" t-as="iss" t-key="iss_index">
                <div t-attf-class="tvl-issue tvl-issue--#{iss.level}">
                    <i t-attf-class="fa #{iss.level === 'danger' ? 'fa-times-circle' : iss.level === 'warn' ? 'fa-exclamation-triangle' : 'fa-info-circle'}"/>
                    <span t-esc="iss.text"/>
                    <button t-if="iss.action and iss.key !== 'none'"
                            class="tvl-issue__action"
                            t-on-click="() => this.setFilter(iss.key)"
                            t-esc="state.activeFilter === iss.key ? 'Quitar filtro' : iss.action"/>
                </div>
            </t>
        </div>

        <!-- VACÍO -->
        <div t-if="state.groups.length === 0" class="tvl-empty">
            <div class="tvl-empty__icon">📦</div>
            <p class="tvl-empty__title">Sin lotes cargados</p>
            <p class="tvl-empty__sub">Use los botones de sincronización para cargar lotes desde el picking o la OC.</p>
        </div>

        <!-- ══════════════ GRUPOS POR PRODUCTO ══════════════ -->
        <div class="tvl-groups" t-if="state.groups.length > 0">
            <t t-foreach="state.groups" t-as="group" t-key="group.product_id">
                <t t-set="preFilter" t-value="group.lines.filter((l) => lineMatchesFilter(l))"/>
                <div class="tvl-group" t-if="preFilter.length">

                    <!-- ── Cabecera del producto (desplegable) ── -->
                    <div class="tvl-group__header" t-on-click="() => this.toggleGroup(group.product_id)">
                        <div class="tvl-group__header-left">
                            <input type="checkbox"
                                   class="tvl-checkbox"
                                   t-att-checked="isGroupAllSelected(group)"
                                   t-on-click.stop=""
                                   t-on-change="(ev) => this.toggleGroupSelect(group, ev)"/>
                            <i t-attf-class="fa #{isCollapsed(group.product_id) ? 'fa-chevron-right' : 'fa-chevron-down'} tvl-group__chevron"/>
                            <div class="tvl-group__title">
                                <span class="tvl-group__name" t-esc="group.product_name"/>
                                <span class="tvl-group__lots" t-if="group.lot_count">
                                    <t t-esc="group.lot_count"/> lotes
                                </span>
                            </div>
                        </div>
                        <t t-set="hasDims" t-value="groupHasDims(group)"/>
                        <t t-set="vLines" t-value="group.lines.filter((l) => lineMatchesFilter(l))"/>
                        <div class="tvl-group__header-right">
                            <t t-set="gflow" t-value="groupFlow(group)"/>
                            <!-- Máx. 3 indicadores: estado compra · % asignado · % disponible -->
                            <div class="tvl-group__summary">
                                <span t-if="gflow and gflow.has_po_link" t-attf-class="tvl-group__flow-diff #{gflow.pending_ship > 0.005 ? 'tvl-group__flow-diff--amber' : gflow.excess_ship > 0.005 ? 'tvl-group__flow-diff--red' : 'tvl-group__flow-diff--green'}"
                                      t-attf-title="Comprado #{fmtNum(gflow.purchased)} #{gflow.uom} · Embarcado #{fmtNum(gflow.shipped)} #{gflow.uom}">
                                    <t t-if="gflow.pending_ship > 0.005">Pendiente por embarcar <t t-esc="fmtNum(gflow.pending_ship)"/> <t t-esc="gflow.uom"/></t>
                                    <t t-elif="gflow.excess_ship > 0.005">Exceso embarcado <t t-esc="fmtNum(gflow.excess_ship)"/> <t t-esc="gflow.uom"/></t>
                                    <t t-else="">Compra completa</t>
                                </span>
                                <span t-elif="gflow" class="tvl-group__flow-diff" title="El producto no está en la OC vinculada al viaje">Sin vínculo con OC</span>
                                <span class="tvl-group__pcts">
                                    <b t-esc="pct(group)"/>% asignado · <t t-esc="100 - pct(group)"/>% disponible
                                </span>
                                <span class="tvl-group__bar" title="Asignado / embarcado del producto">
                                    <span class="tvl-group__bar-fill" t-att-style="'width:' + pct(group) + '%'"/>
                                </span>
                            </div>
                            <!-- Físico con UNIDAD REAL, segunda línea discreta -->
                            <div class="tvl-group__phys" t-if="gflow">
                                <t t-if="gflow.has_po_link">Comprado <t t-esc="fmtNum(gflow.purchased)"/> <t t-esc="gflow.uom"/> · </t>
                                Embarcado <t t-esc="fmtNum(gflow.shipped)"/> <t t-esc="gflow.uom"/>
                            </div>
                        </div>
                    </div>

                    <!-- ── Tabla de lotes del grupo ── -->
                    <t t-if="!isCollapsed(group.product_id)">
                        <div class="tvl-table-wrap">
                            <table class="tvl-table">
                                <thead>
                                    <tr>
                                        <th class="tvl-th tvl-th--chk"></th>
                                        <th class="tvl-th">Lote / placa</th>
                                        <th class="tvl-th">Contenedor</th>
                                        <th class="tvl-th tvl-th--center">Bloque</th>
                                        <t t-if="hasDims">
                                            <th class="tvl-th tvl-th--center">Atado</th>
                                            <th class="tvl-th tvl-th--center">Grosor</th>
                                            <th class="tvl-th tvl-th--right">Alto</th>
                                            <th class="tvl-th tvl-th--right">Largo</th>
                                        </t>
                                        <th class="tvl-th tvl-th--right" title="Cantidad embarcada en este viaje">Cantidad<t t-if="gflow and gflow.uom"> (<t t-esc="gflow.uom"/>)</t></th>
                                        <th class="tvl-th tvl-th--right" title="Cantidad a asignar (parcial en formatos/piezas)">Por asignar</th>
                                        <th class="tvl-th">Cliente</th>
                                        <th class="tvl-th tvl-th--prop" title="Copiar asignación al resto del producto">Copiar</th>
                                        <th class="tvl-th">Pedido de venta</th>
                                        <th class="tvl-th tvl-th--status" title="Estado de la asignación en este viaje">Asignación</th>
                                        <th class="tvl-th tvl-th--center" title="Situación física/comercial del lote (idéntico al inventario visual)">Situación</th>
                                        <th class="tvl-th tvl-th--center" title="Fotografías del lote">Foto</th>
                                        <th class="tvl-th tvl-th--center" title="Historial de movimientos del lote">Historial</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <t t-foreach="vLines" t-as="line" t-key="line.id">
                                    <!-- Separador de bloque cuando cambia -->
                                    <t t-set="currentBlock" t-value="line.x_bloque || 'Sin Bloque'"/>
                                    <t t-set="prevLine" t-value="line_index > 0 ? vLines[line_index - 1] : null"/>
                                    <t t-set="prevBlock" t-value="prevLine ? (prevLine.x_bloque || 'Sin Bloque') : null"/>
                                    <t t-if="line_index === 0 or currentBlock !== prevBlock">
                                        <t t-set="blockInfo" t-value="group.blocks.find(b => b.name === currentBlock)"/>
                                        <tr class="tvl-block-header-row">
                                            <td colspan="4" class="tvl-block-header-label">
                                                <i class="fa fa-th-large"/> Bloque: <strong t-esc="currentBlock"/>
                                                <span class="tvl-block-header-count">
                                                    <t t-esc="blockInfo ? blockInfo.count : 0"/> lotes
                                                </span>
                                            </td>
                                            <td t-att-colspan="hasDims ? 13 : 9" class="tvl-block-header-m2">
                                                <strong t-esc="blockInfo ? fmtNum(blockInfo.total_m2) : '—'"/> m²
                                            </td>
                                        </tr>
                                    </t>

                                    <tr t-attf-class="tvl-row #{line.allocation_status === 'reserved' ? 'tvl-row--reserved' : ''} #{!line.lot_id ? 'tvl-row--pending' : ''}">

                                        <!-- Checkbox -->
                                        <td class="tvl-td tvl-td--chk">
                                            <input type="checkbox" class="tvl-checkbox"
                                                t-att-checked="isLineSelected(line.id)"
                                                t-on-change="(ev) => this.toggleLineSelect(line.id, ev)"/>
                                        </td>

                                        <!-- Lote -->
                                        <td class="tvl-td">
                                            <t t-if="line.lot_id">
                                                <span class="tvl-lot-badge" t-esc="line.lot_id[1]"/>
                                            </t>
                                            <t t-else="">
                                                <span class="tvl-pending-chip">⏳ Sin lote</span>
                                            </t>
                                        </td>

                                        <!-- Contenedor -->
                                        <td class="tvl-td">
                                            <t t-if="line.container_number and line.container_number !== 'PENDIENTE'">
                                                <span class="tvl-container-chip" t-esc="line.container_number"/>
                                            </t>
                                            <t t-else=""><span class="tvl-muted">—</span></t>
                                        </td>

                                        <!-- Bloque -->
                                        <td class="tvl-td tvl-td--center">
                                            <span t-if="line.x_bloque" class="tvl-dim-chip tvl-dim-chip--bloque" t-esc="line.x_bloque"/>
                                            <span t-else="" class="tvl-muted">—</span>
                                        </td>

                                        <!-- Dimensiones físicas: solo cuando el grupo las tiene
                                             (adhesivos/formatos sin dims no muestran guiones) -->
                                        <t t-if="hasDims">
                                            <td class="tvl-td tvl-td--center">
                                                <span t-if="line.x_atado" class="tvl-dim-chip tvl-dim-chip--atado" t-esc="line.x_atado"/>
                                                <span t-else="" class="tvl-muted">—</span>
                                            </td>
                                            <td class="tvl-td tvl-td--center">
                                                <span t-if="line.x_grosor" class="tvl-dim-val" t-esc="line.x_grosor"/>
                                                <span t-else="" class="tvl-muted">—</span>
                                            </td>
                                            <td class="tvl-td tvl-td--right tvl-dim-val">
                                                <t t-if="line.x_alto" t-esc="line.x_alto.toFixed(2)"/>
                                                <span t-else="" class="tvl-muted">—</span>
                                            </td>
                                            <td class="tvl-td tvl-td--right tvl-dim-val">
                                                <t t-if="line.x_ancho" t-esc="line.x_ancho.toFixed(2)"/>
                                                <span t-else="" class="tvl-muted">—</span>
                                            </td>
                                        </t>

                                        <!-- m² -->
                                        <td class="tvl-td tvl-td--right tvl-m2-val">
                                            <t t-esc="fmtNum(line.product_uom_qty)"/>
                                        </td>

                                        <!-- A asignar: parcialidad solo en formatos/piezas -->
                                        <td class="tvl-td tvl-td--right">
                                            <t t-if="isFractionable(line)">
                                                <input type="number" class="tvl-partial-input"
                                                       t-att-value="partialQtyValue(line)"
                                                       min="0" step="0.01"
                                                       t-att-max="line.product_uom_qty"
                                                       t-on-change="(ev) => this.onPartialQtyChange(line, ev)"/>
                                            </t>
                                            <t t-else="">
                                                <span class="tvl-muted">Completo</span>
                                            </t>
                                        </td>

                                        <!-- Cliente editable -->
                                        <td class="tvl-td tvl-td--partner">
                                            <t t-if="isEditing(line.id, 'partner_id')">
                                                <select class="tvl-inline-select"
                                                        t-on-change="(ev) => this.onPartnerChange(line, ev)"
                                                        t-on-blur="() => this.state.editingCell = null">
                                                    <option value="">— Sin cliente —</option>
                                                    <t t-foreach="state.allPartners" t-as="pt" t-key="pt.id">
                                                        <option t-att-value="pt.id"
                                                                t-att-selected="line.partner_id and line.partner_id[0] === pt.id"
                                                                t-esc="pt.name"/>
                                                    </t>
                                                </select>
                                            </t>
                                            <t t-else="">
                                                <div class="tvl-editable-cell" t-on-click="() => this.startEdit(line.id, 'partner_id')">
                                                    <t t-if="line.partner_id">
                                                        <span class="tvl-partner-name" t-esc="line.partner_id[1]"/>
                                                        <i class="fa fa-pencil tvl-edit-icon"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="tvl-add-hint"><i class="fa fa-plus-circle"/> Asignar</span>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>

                                        <!-- Botón propagar -->
                                        <td class="tvl-td tvl-td--prop">
                                            <t t-if="line.order_id and line_index &lt; group.lines.length - 1">
                                                <button class="tvl-prop-btn"
                                                        title="Propagar la orden a todos los lotes siguientes de este producto"
                                                        t-on-click="(ev) => this.propagateDown(group, line_index, ev)">
                                                    <i class="fa fa-angle-double-down"/>
                                                </button>
                                            </t>
                                            <t t-else="">
                                                <span class="tvl-prop-placeholder"/>
                                            </t>
                                        </td>

                                        <!-- Sales Order editable (orden-primero: no exige cliente previo) -->
                                        <td class="tvl-td tvl-td--order">
                                            <t t-if="isEditing(line.id, 'order_id')">
                                                <select class="tvl-inline-select"
                                                        t-on-change="(ev) => this.onOrderChange(line, ev)"
                                                        t-on-blur="() => this.state.editingCell = null">
                                                    <option value="">— Sin pedido —</option>
                                                    <t t-foreach="getOrdersForProduct(line)" t-as="o" t-key="o.id">
                                                        <option t-att-value="o.id"
                                                                t-att-selected="line.order_id and line.order_id[0] === o.id">
                                                            <t t-esc="o.name"/> · <t t-esc="o.partner_name"/>
                                                            <t t-if="o.requested"> · Solicitado <t t-esc="fmtNum(o.requested)"/> · Pendiente <t t-esc="fmtNum(o.pending)"/></t>
                                                        </option>
                                                    </t>
                                                </select>
                                            </t>
                                            <t t-else="">
                                                <div class="tvl-editable-cell" t-on-click="() => this.startEdit(line.id, 'order_id')">
                                                    <t t-if="line.order_id">
                                                        <span class="tvl-order-name" t-esc="line.order_id[1]"/>
                                                        <i class="fa fa-pencil tvl-edit-icon"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="tvl-add-hint"><i class="fa fa-plus-circle"/> Orden</span>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>

                                        <!-- Estado -->
                                        <td class="tvl-td tvl-td--status">
                                            <span t-attf-class="tvl-badge #{statusCls(line.allocation_status)}"
                                                t-esc="statusLabel(line.allocation_status)"/>
                                        </td>

                                        <!-- Estado del lote: réplica 1:1 del inventario visual -->
                                        <td class="tvl-td tvl-td--center">
                                            <!-- 1. Apartado activo (manita) -->
                                            <button t-if="line.trace and line.trace.tiene_hold"
                                                    type="button"
                                                    class="status-badge-btn status-hold-active"
                                                    t-on-click="() => this.onLotHoldClick(line, group)"
                                                    title="Ver información del apartado">
                                                <i class="fa fa-hand-paper-o"></i>
                                            </button>

                                            <!-- 2. En orden de venta (signo de peso) -->
                                            <button t-elif="line.trace and line.trace.sale_order_ids and line.trace.sale_order_ids.length"
                                                    type="button"
                                                    class="status-badge-btn status-sale-order"
                                                    t-on-click="() => this.onLotSaleOrderClick(line)"
                                                    title="Ver orden de venta">
                                                <i class="fa fa-usd"></i>
                                            </button>

                                            <!-- 3. Sin estado (manita gris) -->
                                            <span t-elif="line.trace" class="status-badge-btn status-no-hold" title="Sin apartado">
                                                <i class="fa fa-hand-paper-o"></i>
                                            </span>

                                            <span t-else="" class="tvl-muted">—</span>
                                        </td>



                                        <!-- Foto del lote -->
                                        <td class="tvl-td tvl-td--center">
                                            <button t-if="line.trace and line.trace.photo_count"
                                                    class="tvl-icon-btn tvl-icon-btn--photo"
                                                    t-attf-title="Ver fotografía (#{line.trace.photo_count})"
                                                    t-on-click="() => this.openLotPhoto(line)">
                                                <i class="fa fa-camera"/>
                                            </button>
                                            <span t-else="" class="tvl-muted">—</span>
                                        </td>

                                        <!-- Historial de movimientos -->
                                        <td class="tvl-td tvl-td--center">
                                            <button t-if="line.lot_id"
                                                    class="tvl-icon-btn"
                                                    title="Historial de movimientos del lote"
                                                    t-on-click="() => this.openLotHistory(line)">
                                                <i class="fa fa-history"/>
                                            </button>
                                            <span t-else="" class="tvl-muted">—</span>
                                        </td>

                                    </tr>
                                </t>

                                <!-- Subtotal del grupo -->
                                <tr class="tvl-subtotal-row">
                                    <td t-att-colspan="hasDims ? 8 : 4" class="tvl-td tvl-subtotal__label">
                                        Subtotal <strong t-esc="group.product_name"/>
                                    </td>
                                    <td class="tvl-td tvl-subtotal__m2">
                                        <t t-esc="fmtNum(group.total_m2)"/> m²
                                    </td>
                                    <td colspan="8" class="tvl-td tvl-subtotal__info">
                                        <span t-if="group.reserved_m2 > 0" class="tvl-subtotal__reserved">
                                            <t t-esc="fmtNum(group.reserved_m2)"/> m² reservados
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                            </table>
                        </div>
                    </t>

                </div>
            </t>

            <!-- Total general -->
            <div class="tvl-grand-total">
                <span class="tvl-grand-total__label">Total General</span>
                <div class="tvl-grand-total__bar-wrap">
                    <div class="tvl-grand-total__bar">
                        <div class="tvl-grand-total__bar-fill" t-att-style="'width:' + grandPercent + '%'"/>
                    </div>
                    <span class="tvl-grand-total__pct"><t t-esc="grandPercent"/>% asignado</span>
                </div>
                <span class="tvl-grand-total__m2"><t t-esc="fmtNum(grandTotal)"/> m²</span>
            </div>
        </div>

    </t>

    <!-- ══════════════════════════════════════════════════════════
         BARRA FLOTANTE DE ASIGNACIÓN MASIVA
         Aparece en la parte inferior cuando hay lotes seleccionados
    ══════════════════════════════════════════════════════════ -->
    <t t-if="selectedCount > 0">
        <div class="tvl-floating-bar">
            <div class="tvl-floating-bar__left">
                <!-- Contador de lotes -->
                <div class="tvl-floating-bar__counter">
                    <span class="tvl-floating-bar__count" t-esc="selectedCount"/>
                    <span class="tvl-floating-bar__count-label">lotes</span>
                </div>
                <!-- Separador -->
                <div class="tvl-floating-bar__sep"/>
                <!-- Total m² -->
                <div class="tvl-floating-bar__m2">
                    <i class="fa fa-th"/>
                    <span t-esc="fmtNum(selectedM2)"/> m² seleccionados
                </div>
            </div>
            <div class="tvl-floating-bar__right">
                <button class="tvl-floating-bar__btn-clear" t-on-click="clearSelection">
                    <i class="fa fa-times"/> Cancelar
                </button>
                <button class="tvl-floating-bar__btn-assign" t-on-click="openAssignPopup">
                    <i class="fa fa-user-plus"/> Asignar Cliente
                </button>
            </div>
        </div>
    </t>

    <!-- ══════════════════════════════════════════════════════════
         POPUP DE ASIGNACIÓN
    ══════════════════════════════════════════════════════════ -->
    <t t-if="state.showAssignPopup">
        <!-- Backdrop -->
        <div class="tvl-popup-backdrop" t-on-click="closeAssignPopup"/>

        <!-- Dialog -->
        <div class="tvl-popup">
            <!-- Header -->
            <div class="tvl-popup__header">
                <div class="tvl-popup__header-icon">
                    <i class="fa fa-user-plus"/>
                </div>
                <div class="tvl-popup__header-text">
                    <h4 class="tvl-popup__title">Asignar Lotes</h4>
                    <p class="tvl-popup__subtitle">
                        <strong t-esc="selectedCount"/> lotes · <t t-esc="fmtNum(selectedM2)"/> m²
                    </p>
                </div>
                <button class="tvl-popup__close" t-on-click="closeAssignPopup">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <!-- Body -->
            <div class="tvl-popup__body">

                <!-- Resumen de lotes seleccionados -->
                <div class="tvl-popup__summary">
                    <div class="tvl-popup__summary-title">
                        <i class="fa fa-list-ul"/> Resumen de selección
                    </div>
                    <div class="tvl-popup__summary-rows">
                        <t t-foreach="selectedSummary" t-as="row" t-key="row.product">
                            <div class="tvl-popup__summary-row">
                                <span class="tvl-popup__summary-product" t-esc="row.product"/>
                                <div class="tvl-popup__summary-meta">
                                    <span class="tvl-popup__summary-count">
                                        <i class="fa fa-tag"/> <t t-esc="row.count"/> lotes
                                    </span>
                                    <span class="tvl-popup__summary-m2">
                                        <t t-esc="fmtNum(row.m2)"/> m²
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Selector de cliente -->
                <div class="tvl-popup__field-group">
                    <label class="tvl-popup__label">
                        <i class="fa fa-user"/> Cliente
                        <span class="tvl-popup__required">*</span>
                    </label>
                    <select class="tvl-popup__select"
                            t-on-change="onPopupPartnerChange">
                        <option value="">— Seleccionar cliente —</option>
                        <t t-foreach="state.allPartners" t-as="pt" t-key="pt.id">
                            <option t-att-value="pt.id"
                                    t-att-selected="state.popupPartner === pt.id"
                                    t-esc="pt.name"/>
                        </t>
                    </select>
                </div>

                <!-- Selector de orden de venta -->
                <div class="tvl-popup__field-group">
                    <label t-attf-class="tvl-popup__label #{!state.popupPartner ? 'tvl-popup__label--disabled' : ''}">
                        <i class="fa fa-file-text-o"/> Sales Order
                        <span class="tvl-popup__optional">(opcional)</span>
                    </label>
                    <select class="tvl-popup__select"
                            t-att-disabled="!state.popupPartner"
                            t-on-change="onPopupOrderChange">
                        <option value="">— Seleccionar orden —</option>
                        <t t-foreach="popupOrders" t-as="o" t-key="o.id">
                            <option t-att-value="o.id"
                                    t-att-selected="state.popupOrder === o.id"
                                    t-esc="o.name"/>
                        </t>
                    </select>
                    <p t-if="!state.popupPartner" class="tvl-popup__hint">
                        Seleccione un cliente primero
                    </p>
                    <p t-elif="popupOrders.length === 0" class="tvl-popup__hint tvl-popup__hint--warn">
                        <i class="fa fa-exclamation-triangle"/> Sin órdenes para este cliente
                    </p>
                </div>

            </div>

            <!-- Footer -->
            <div class="tvl-popup__footer">
                <button class="tvl-popup__btn-cancel" t-on-click="closeAssignPopup">
                    Cancelar
                </button>
                <button t-attf-class="tvl-popup__btn-confirm #{!state.popupPartner ? 'tvl-popup__btn-confirm--disabled' : ''}"
                        t-on-click="confirmAssign"
                        t-att-disabled="!state.popupPartner">
                    <i class="fa fa-check"/> Confirmar Asignación
                </button>
            </div>
        </div>
    </t>

    <!-- ══════════════ DRAWER DE ASIGNACIÓN (preventivo) ══════════════ -->
    <t t-if="state.drawer">
        <t t-set="d" t-value="state.drawer"/>
        <t t-set="proj" t-value="drawerProjection"/>
        <div class="tvl-drawer-overlay" t-on-click="closeAssignDrawer"/>
        <aside class="tvl-drawer" role="dialog" aria-label="Confirmar asignación">
            <div class="tvl-drawer__head">
                <h4>Confirmar asignación</h4>
                <button class="tvl-drawer__close" title="Cancelar" t-on-click="closeAssignDrawer">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div class="tvl-drawer__body">
                <!-- Material -->
                <div class="tvl-drawer__section">
                    <span class="tvl-drawer__label">Material</span>
                    <div class="tvl-drawer__val">
                        <b t-esc="d.group ? d.group.product_name : ''"/>
                        <div>
                            Lote <span class="tvl-lot-badge" t-esc="d.line.lot_id ? d.line.lot_id[1] : '—'"/>
                            · Disponible <b t-esc="fmtNum(d.line.product_uom_qty)"/>
                        </div>
                    </div>
                </div>

                <!-- Pedido -->
                <div class="tvl-drawer__section">
                    <span class="tvl-drawer__label">Pedido de venta</span>
                    <div class="tvl-drawer__val">
                        <b t-esc="d.order.name"/> · <t t-esc="d.order.partner_name"/>
                    </div>
                </div>

                <!-- Cobertura actual -->
                <div class="tvl-drawer__section" t-if="proj and proj.cov">
                    <span class="tvl-drawer__label">Cobertura actual del pedido</span>
                    <div class="tvl-drawer__cov">
                        <div><span>Solicitado</span> <b t-esc="fmtNum(proj.cov.requested)"/></div>
                        <div><span>Ya cubierto</span> <b t-esc="fmtNum(proj.cov.covered)"/></div>
                        <div><span>Pendiente</span> <b t-esc="fmtNum(proj.cov.pending)"/></div>
                    </div>
                </div>
                <div class="tvl-drawer__section" t-if="proj and proj.noProduct">
                    <div class="tvl-drawer__verdict tvl-drawer__verdict--over">
                        El pedido seleccionado no contiene este producto.
                    </div>
                </div>

                <!-- Cantidad a asignar -->
                <div class="tvl-drawer__section">
                    <span class="tvl-drawer__label">Cantidad a asignar</span>
                    <t t-if="isFractionable(d.line)">
                        <input type="number" class="tvl-drawer__qty" min="0" step="0.01"
                               t-att-max="d.line.product_uom_qty"
                               t-att-value="d.qty"
                               t-on-input="onDrawerQtyChange"/>
                    </t>
                    <t t-else="">
                        <div class="tvl-drawer__val"><b t-esc="fmtNum(d.qty)"/> (placa completa)</div>
                    </t>
                </div>

                <!-- Resultado proyectado -->
                <div class="tvl-drawer__section" t-if="proj and proj.cov">
                    <span class="tvl-drawer__label">Resultado proyectado</span>
                    <div class="tvl-drawer__proj">
                        <b t-esc="fmtNum(proj.projected)"/> / <t t-esc="fmtNum(proj.cov.requested)"/>
                        <span class="tvl-cov__bar" style="margin-top: 4px;">
                            <span t-attf-class="tvl-cov__fill #{proj.level === 'over' ? 'tvl-drawer__fill--over' : ''}"
                                  t-attf-style="width: #{proj.pct}%"/>
                        </span>
                    </div>
                    <div t-attf-class="tvl-drawer__verdict tvl-drawer__verdict--#{proj.level}"
                         t-esc="proj.verdict"/>
                </div>
            </div>

            <div class="tvl-drawer__foot">
                <button class="tvl-drawer__btn tvl-drawer__btn--secondary" t-on-click="closeAssignDrawer">Cancelar</button>
                <button class="tvl-drawer__btn tvl-drawer__btn--primary" t-on-click="confirmAssignDrawer">
                    Confirmar asignación
                </button>
            </div>
        </aside>
    </t>

</div>

</t>
</templates>
