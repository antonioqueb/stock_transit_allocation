<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_transit">
        <field name="name">Gestión de Tránsito</field>
        <field name="description">Niveles de acceso para Torre de Control</field>
        <field name="sequence">10</field>
    </record>

    <!-- Selector (Odoo 19): agrupa los niveles como dropdown en el formulario
         del usuario, fuera de "Permisos adicionales". -->
    <record id="privilege_transit" model="res.groups.privilege">
        <field name="name">Torre de Control</field>
        <field name="category_id" ref="module_category_transit"/>
        <field name="sequence">10</field>
    </record>

    <!-- Nivel mínimo: puede RECIBIR (validar recepciones, tablero de
         Recepciones) sin acceso a los hubs de Torre de Control. Los menús
         de Torre de Control van gateados por purchase.group_purchase_user,
         así que este nivel no los ve. -->
    <record id="group_transit_receptions" model="res.groups">
        <field name="name">Recepciones</field>
        <field name="privilege_id" ref="privilege_transit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_transit_user" model="res.groups">
        <field name="name">Usuario Tránsito</field>
        <field name="privilege_id" ref="privilege_transit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_transit_receptions'))]"/>
    </record>

    <record id="group_transit_manager" model="res.groups">
        <field name="name">Gerente Tránsito</field>
        <field name="privilege_id" ref="privilege_transit"/>
        <field name="implied_ids" eval="[(4, ref('group_transit_user'))]"/>
    </record>
</odoo>
