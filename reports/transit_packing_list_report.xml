<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- ACCIONES DE REPORTE -->
    <!-- ============================================================= -->

    <record id="action_report_transit_packing_list_voyage" model="ir.actions.report">
        <field name="name">Packing List de Embarque</field>
        <field name="model">stock.transit.voyage</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_transit_allocation.report_transit_packing_list_voyage</field>
        <field name="report_file">stock_transit_allocation.report_transit_packing_list_voyage</field>
        <field name="print_report_name">'Packing List - %s' % (object.name or '')</field>
    </record>

    <record id="action_report_transit_packing_list_purchase" model="ir.actions.report">
        <field name="name">Packing List de Embarque</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_transit_allocation.report_transit_packing_list_purchase</field>
        <field name="report_file">stock_transit_allocation.report_transit_packing_list_purchase</field>
        <field name="print_report_name">'Packing List - %s' % (object.name or '')</field>
    </record>

    <!-- ============================================================= -->
    <!-- WRAPPER: DESDE EMBARQUE -->
    <!-- ============================================================= -->

    <template id="report_transit_packing_list_voyage">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="stock_transit_allocation.report_transit_packing_list_document"/>
            </t>
        </t>
    </template>

    <!-- ============================================================= -->
    <!-- WRAPPER: DESDE ORDEN DE COMPRA -->
    <!-- ============================================================= -->

    <template id="report_transit_packing_list_purchase">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="purchase">
                <t t-set="voyages" t-value="purchase._tc_get_packing_report_voyages()"/>
                <t t-foreach="voyages" t-as="doc">
                    <t t-call="stock_transit_allocation.report_transit_packing_list_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================= -->
    <!-- DOCUMENTO PRINCIPAL -->
    <!-- ============================================================= -->

    <template id="report_transit_packing_list_document">
        <t t-call="web.external_layout">

            <!-- Estilos ESPECÍFICOS de este reporte (paisaje denso).
                 Lo canónico (tablas, bandas, fichas, títulos) viene del
                 sistema de diseño stock_lot_dimensions.som_report_style. -->
            <style>
                @page {
                    size: A4 landscape;
                    margin: 5mm 7mm 6mm 7mm;
                }

                .pl-page {
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                    font-size: 10px;
                    color: #222;
                }

                /* Grid de info compacto de 6 columnas (específico) */
                .pl-info-grid {
                    width: 100%;
                    border: 1px solid #d8d8d8;
                    border-collapse: collapse;
                    margin-bottom: 4px;
                    font-size: 9px;
                    table-layout: fixed;
                }
                .pl-info-grid td {
                    padding: 2px 6px;
                    border: 1px solid #d8d8d8;
                    line-height: 1.1;
                    vertical-align: middle;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
                .pl-info-grid td.pl-lbl {
                    font-weight: 800;
                    text-transform: uppercase;
                    font-size: 8.5px;
                    color: #555;
                    background: #f2f2f2;
                    width: 11%;
                    letter-spacing: .02em;
                }
                .pl-info-grid td.pl-val {
                    width: 22%;
                    color: #222;
                    font-weight: 600;
                }
                .pl-info-grid td.pl-val-strong {
                    font-weight: 800;
                    text-transform: uppercase;
                }

                /* KPIs compactos (específico) */
                .pl-kpi-row {
                    display: table;
                    width: 100%;
                    table-layout: fixed;
                    margin-bottom: 4px;
                    border-collapse: separate;
                    border-spacing: 4px 0;
                }
                .pl-kpi {
                    display: table-cell;
                    border: 1px solid #d8d8d8;
                    background: #f2f2f2;
                    padding: 2px 6px;
                    text-align: center;
                    vertical-align: middle;
                }
                .pl-kpi-label {
                    font-size: 8.5px;
                    font-weight: 800;
                    text-transform: uppercase;
                    color: #555;
                    letter-spacing: .04em;
                    line-height: 1;
                }
                .pl-kpi-value {
                    font-size: 12px;
                    font-weight: 800;
                    color: #222;
                    line-height: 1;
                    margin-top: 1px;
                }

                /* Densidad del detalle en paisaje (sobre la som-table) */
                .pl-table th { text-align: center; }
                .pl-table td {
                    padding: 2px 4px !important;
                    line-height: 1.1 !important;
                }

                /* Encabezado de producto: banda oscura canónica */
                .pl-product-row td {
                    font-weight: 800 !important;
                    text-transform: uppercase;
                    color: #ffffff !important;
                    background-color: #2f2f2f !important;
                    border-color: #2f2f2f !important;
                    letter-spacing: .02em;
                }
                .pl-product-row .pl-product-meta {
                    font-size: 8.5px;
                    color: #d8d8d8 !important;
                    font-weight: 700;
                    margin-left: 6px;
                }

                /* Subtotal por producto: banda gris canónica */
                .pl-product-subtotal td {
                    background-color: #f2f2f2 !important;
                    color: #222 !important;
                    font-weight: 800 !important;
                    text-transform: uppercase;
                }
                .pl-product-subtotal .pl-subtotal-uom {
                    color: #555 !important;
                    margin-left: 3px;
                    font-weight: 700;
                }

                .pl-muted { color: #555; margin-left: 2px; }

                /* Total general: cierre canónico */
                .pl-total-row td {
                    border-top: 2px solid #2f2f2f !important;
                    background-color: #f2f2f2 !important;
                    color: #222 !important;
                    font-weight: 800 !important;
                    text-transform: uppercase;
                }

                .pl-note {
                    border: 1px solid #d8d8d8;
                    background: #f7f7f7;
                    padding: 2px 7px;
                    margin-top: 3px;
                    font-size: 8.5px;
                    line-height: 1.15;
                    color: #555;
                }

                /* Firmas y pie (específico) */
                .pl-sign-line {
                    border-top: 1px solid #222;
                    margin-top: 14px;
                    padding-top: 2px;
                    font-size: 9.5px;
                    font-weight: 800;
                }
                .pl-sign-sub {
                    font-size: 8px;
                    color: #555;
                    line-height: 1;
                }
                .pl-foot {
                    margin-top: 3px;
                    font-size: 7.5px;
                    color: #999;
                    text-align: center;
                    border-top: 1px solid #d8d8d8;
                    padding-top: 1px;
                }
            </style>

            <t t-set="rows" t-value="doc._tc_get_packing_report_rows()"/>
            <t t-set="totals" t-value="doc._tc_get_packing_report_totals()"/>
            <t t-set="purchase" t-value="doc.purchase_id"/>
            <t t-set="supplier" t-value="purchase.partner_id if purchase else False"/>
            <t t-set="status_label" t-value="dict(doc._fields['custom_status'].selection).get(doc.custom_status) or doc.custom_status or '-'"/>

            <!-- Pre-cálculo: subtotales por producto y totales por UoM -->
            <t t-set="product_subtotals" t-value="{}"/>
            <t t-set="product_counts" t-value="{}"/>
            <t t-set="product_uom" t-value="{}"/>
            <t t-set="qty_by_uom" t-value="{}"/>
            <t t-foreach="rows" t-as="r">
                <t t-set="pk" t-value="r.get('product_key')"/>
                <t t-set="q" t-value="r.get('qty') or 0.0"/>
                <t t-set="u" t-value="r.get('uom') or 'Unid.'"/>
                <t t-set="_" t-value="product_subtotals.update({pk: product_subtotals.get(pk, 0.0) + q})"/>
                <t t-set="_" t-value="product_counts.update({pk: product_counts.get(pk, 0) + 1})"/>
                <t t-set="_" t-value="product_uom.update({pk: u})"/>
                <t t-set="_" t-value="qty_by_uom.update({u: qty_by_uom.get(u, 0.0) + q})"/>
            </t>

            <div class="page pl-page">
                <t t-call="stock_lot_dimensions.som_report_style"/>

                <!-- ===================================================== -->
                <!-- ENCABEZADO -->
                <!-- ===================================================== -->
                <div style="border-bottom: 2px solid #2f2f2f; padding-bottom: 2px; margin-bottom: 3px;">
                    <div class="row" style="align-items: center;">
                        <div class="col-5">
                            <h2 class="som-doc-title">PACKING LIST</h2>
                            <div class="som-doc-subtitle" style="margin-bottom: 0;">Detalle logístico de material cargado en embarque</div>
                        </div>
                        <div class="col-7 text-end">
                            <div class="som-small som-muted som-upper" style="font-weight: 700; line-height: 1;">No. Embarque</div>
                            <div style="font-size: 15px; font-weight: 800; color: #222; line-height: 1.05;">
                                <t t-esc="doc.name or '-'"/>
                            </div>
                            <div class="som-small som-muted" style="line-height: 1;">
                                Impreso: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===================================================== -->
                <!-- INFO COMPACTA (grid denso 3 columnas de pares) -->
                <!-- ===================================================== -->
                <table class="pl-info-grid">
                    <tr>
                        <td class="pl-lbl">Proveedor</td>
                        <td class="pl-val" colspan="3">
                            <t t-esc="supplier.display_name if supplier else '-'"/>
                        </td>
                        <td class="pl-lbl">Estado</td>
                        <td class="pl-val pl-val-strong">
                            <t t-esc="status_label"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="pl-lbl">Orden compra</td>
                        <td class="pl-val">
                            <t t-esc="purchase.name if purchase else '-'"/>
                        </td>
                        <td class="pl-lbl">Ref. prov.</td>
                        <td class="pl-val">
                            <t t-esc="purchase.partner_ref if purchase else '-'"/>
                        </td>
                        <td class="pl-lbl">Fecha OC</td>
                        <td class="pl-val">
                            <t t-if="purchase and purchase.date_order"><span t-field="purchase.date_order"/></t>
                            <t t-else="">-</t>
                        </td>
                    </tr>
                    <tr>
                        <td class="pl-lbl">Naviera</td>
                        <td class="pl-val">
                            <t t-esc="doc.shipping_line or '-'"/>
                        </td>
                        <td class="pl-lbl">Buque</td>
                        <td class="pl-val">
                            <t t-esc="doc.vessel_name or '-'"/>
                        </td>
                        <td class="pl-lbl">BL / Folio</td>
                        <td class="pl-val">
                            <t t-esc="doc.bl_number or '-'"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="pl-lbl">Contenedor(es)</td>
                        <td class="pl-val" colspan="3">
                            <t t-esc="doc.container_number or '-'"/>
                        </td>
                        <td class="pl-lbl">ETD / ETA</td>
                        <td class="pl-val">
                            <t t-if="doc.etd"><span t-field="doc.etd"/></t><t t-else="">-</t>
                            &#160;/&#160;
                            <t t-if="doc.eta"><span t-field="doc.eta"/></t><t t-else="">-</t>
                        </td>
                    </tr>
                </table>

                <!-- ===================================================== -->
                <!-- KPIs RESUMEN -->
                <!-- ===================================================== -->
                <div class="pl-kpi-row">
                    <div class="pl-kpi">
                        <div class="pl-kpi-label">Productos</div>
                        <div class="pl-kpi-value"><t t-esc="totals.get('product_count') or 0"/></div>
                    </div>
                    <div class="pl-kpi">
                        <div class="pl-kpi-label">Líneas</div>
                        <div class="pl-kpi-value"><t t-esc="totals.get('total_lines') or 0"/></div>
                    </div>
                    <t t-foreach="qty_by_uom" t-as="uom_key">
                        <div class="pl-kpi">
                            <div class="pl-kpi-label">Total <t t-esc="uom_key"/></div>
                            <div class="pl-kpi-value">
                                <t t-esc="'%.3f' % qty_by_uom.get(uom_key, 0.0)"/>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- ===================================================== -->
                <!-- DETALLE -->
                <!-- ===================================================== -->
                <div class="som-section-title" style="margin-bottom: 2px;">Detalle del Packing List</div>

                <t t-if="rows">
                    <table class="som-table pl-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 12%;">CONTENEDOR</th>
                                <th style="width: 20%;">BLOQUE</th>
                                <th style="width: 12%;">PLACA</th>
                                <th style="width: 8%;">ATADO</th>
                                <th style="width: 19%;">PEDIMENTO</th>
                                <th style="width: 7%;">LARGO</th>
                                <th style="width: 7%;">ALTO</th>
                                <th style="width: 10%;">CANT.</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="idx" t-value="0"/>
                            <t t-set="last_product_key" t-value="False"/>
                            <t t-set="row_index" t-value="0"/>
                            <t t-set="total_rows" t-value="len(rows)"/>

                            <t t-foreach="rows" t-as="row">
                                <t t-set="row_index" t-value="row_index + 1"/>
                                <t t-set="cur_pk" t-value="row.get('product_key')"/>

                                <!-- Cierre de producto anterior (subtotal) -->
                                <t t-if="last_product_key and last_product_key != cur_pk">
                                    <tr class="pl-product-subtotal">
                                        <td colspan="8" class="text-end">
                                            Subtotal producto
                                            (<t t-esc="product_counts.get(last_product_key, 0)"/> líneas)
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.3f' % (product_subtotals.get(last_product_key, 0.0))"/>
                                            <span class="pl-subtotal-uom">
                                                <t t-esc="product_uom.get(last_product_key, '')"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Encabezado de producto -->
                                <t t-if="last_product_key != cur_pk">
                                    <tr class="pl-product-row">
                                        <td colspan="9">
                                            <span t-esc="row.get('product_name') or '-'"/>
                                            <span t-if="row.get('product_code')" class="pl-product-meta">
                                                — <t t-esc="row.get('product_code')"/>
                                            </span>
                                            <span t-if="row.get('origin_name')" class="pl-product-meta">
                                                · Origen: <t t-esc="row.get('origin_name')"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>

                                <t t-set="last_product_key" t-value="cur_pk"/>

                                <t t-set="idx" t-value="idx + 1"/>

                                <tr>
                                    <td class="text-center"><t t-esc="idx"/></td>
                                    <td class="text-center"><t t-esc="row.get('container') or '-'"/></td>
                                    <td><t t-esc="row.get('bloque') or '-'"/></td>
                                    <td class="text-center"><t t-esc="row.get('numero_placa') or '-'"/></td>
                                    <td class="text-center"><t t-esc="row.get('atado') or '-'"/></td>
                                    <td><t t-esc="row.get('pedimento') or '-'"/></td>
                                    <td class="text-center">
                                        <t t-if="row.get('ancho')"><t t-esc="'%.3f' % row.get('ancho')"/></t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="row.get('alto')"><t t-esc="'%.3f' % row.get('alto')"/></t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="text-center som-nowrap" style="font-weight: 800;">
                                        <t t-esc="'%.3f' % (row.get('qty') or 0.0)"/>
                                        <span t-if="row.get('uom')" class="pl-muted">
                                            <t t-esc="row.get('uom')"/>
                                        </span>
                                    </td>
                                </tr>

                                <!-- Cierre final tras la última fila -->
                                <t t-if="row_index == total_rows">
                                    <tr class="pl-product-subtotal">
                                        <td colspan="8" class="text-end">
                                            Subtotal producto
                                            (<t t-esc="product_counts.get(cur_pk, 0)"/> líneas)
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.3f' % (product_subtotals.get(cur_pk, 0.0))"/>
                                            <span class="pl-subtotal-uom">
                                                <t t-esc="product_uom.get(cur_pk, '')"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>

                        <tfoot>
                            <t t-foreach="qty_by_uom" t-as="uom_key">
                                <tr class="pl-total-row">
                                    <td colspan="8" class="text-end">
                                        TOTAL GENERAL <t t-esc="uom_key"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="'%.3f' % qty_by_uom.get(uom_key, 0.0)"/>
                                    </td>
                                </tr>
                            </t>
                        </tfoot>
                    </table>
                </t>

                <t t-else="">
                    <div class="som-muted" style="border: 1px solid #d8d8d8; padding: 6px; font-size: 10px; font-style: italic; text-align: center;">
                        Sin líneas de Packing List para imprimir.
                    </div>
                </t>

                <!-- ===================================================== -->
                <!-- OBSERVACIÓN -->
                <!-- ===================================================== -->
                <div class="pl-note">
                    <strong>Observación:</strong>
                    Este documento muestra el detalle logístico cargado desde el embarque y/o el Packing List del proveedor.
                    No sustituye la recepción física ni valida diferencias de almacén; cualquier ajuste debe confirmarse contra el Packing List físico y el Worksheet.
                </div>

                <!-- ===================================================== -->
                <!-- FIRMAS -->
                <!-- ===================================================== -->
                <div class="row mt-2 som-avoid-break">
                    <div class="col-4 text-center">
                        <div class="pl-sign-line">Revisó</div>
                        <div class="pl-sign-sub">Nombre y firma</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="pl-sign-line">Validó almacén</div>
                        <div class="pl-sign-sub">Nombre y firma</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="pl-sign-line">Autorizó</div>
                        <div class="pl-sign-sub">Nombre y firma</div>
                    </div>
                </div>

                <!-- ===================================================== -->
                <!-- PIE -->
                <!-- ===================================================== -->
                <div class="pl-foot">
                    Packing List generado desde Odoo. Documento logístico sin precios. Página <span class="page"/>.
                </div>

            </div>
        </t>
    </template>
</odoo>
