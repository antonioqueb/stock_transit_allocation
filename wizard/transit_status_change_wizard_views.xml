<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_status_change_wizard_form" model="ir.ui.view">
        <field name="name">transit.status.change.wizard.form</field>
        <field name="model">transit.status.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Retroceder Estado">
                <group>
                    <group string="Cambio de Etapa">
                        <field name="current_status" widget="badge"/>
                        <field name="next_status_label" readonly="1"/>
                    </group>

                    <group string="Viaje">
                        <field name="voyage_id" readonly="1"/>
                        <field name="direction" invisible="1"/>
                    </group>
                </group>

                <group string="Motivo de retroceso">
                    <field name="notes"
                           nolabel="1"
                           required="direction == 'retreat'"
                           placeholder="Explique por qué se está retrocediendo el estado: error de captura, retraso, cambio operativo, problema aduanal, etc."/>
                </group>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmar Retroceso"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>