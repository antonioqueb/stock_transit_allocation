<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tc_portal_regen_confirm_form" model="ir.ui.view">
        <field name="name">tc.portal.regen.confirm.form</field>
        <field name="model">tc.portal.regen.confirm</field>
        <field name="arch" type="xml">
            <form string="Regenerar liga del portal">
                <field name="voyage_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <b>El embarque se va a echar atrás.</b><br/>
                    Todo su material en tránsito se devuelve al proveedor
                    (<field name="lot_count" readonly="1" class="oe_inline"/> lotes,
                    <field name="qty" readonly="1" class="oe_inline"/>),
                    nacen recepciones nuevas sin validar y el portal se reabre
                    con todo lo que el proveedor ya capturó.<br/>
                    Los lotes conservan su folio. Cuando el proveedor vuelva a
                    completar, la recepción la valida Compras.
                </div>
                <group>
                    <field name="picking_names"/>
                    <field name="reception_names" invisible="not reception_names"/>
                    <field name="order_names" invisible="not order_names"/>
                    <field name="assigned_count" invisible="not order_names"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="not order_names">
                    Esos pedidos conservan sus placas asignadas, pero mientras
                    el embarque esté en corrección no contarán como material
                    en tránsito.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Echar atrás y regenerar liga" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ENGRANE (menú Acciones) del embarque. -->
    <record id="action_server_voyage_regen_portal_link" model="ir.actions.server">
        <field name="name">Regenerar liga del portal</field>
        <field name="model_id" ref="model_stock_transit_voyage"/>
        <field name="binding_model_id" ref="model_stock_transit_voyage"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if record:
    action = record.action_tc_open_regen_portal_wizard()
        </field>
    </record>

    <record id="view_stock_transit_voyage_form_portal_regen" model="ir.ui.view">
        <field name="name">stock.transit.voyage.form.portal.regen</field>
        <field name="model">stock.transit.voyage</field>
        <field name="inherit_id" ref="view_stock_transit_voyage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="after">
                <field name="tc_portal_regen_pending" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not tc_portal_regen_pending">
                    <b>Embarque en corrección.</b> Se regeneró la liga del
                    portal: el material se devolvió al proveedor y no está en
                    tránsito. Volverá cuando el proveedor complete el portal y
                    Compras valide la recepción corregida.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
