<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ───────────────────────────────────────────────────────────── -->
    <!-- Formulario: columnas operativas limpias en líneas de pedido    -->
    <!-- ───────────────────────────────────────────────────────────── -->
    <record id="view_order_form_transit_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.transit.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- ========================================================= -->
            <!-- Columnas operativas después de descripción                 -->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="has_stone_lots" column_invisible="1"/>
                <field name="tc_stock_rejected" column_invisible="1"/>
                <field name="tc_assignment_closed" column_invisible="1"/>
                <field name="tc_closure_reason" column_invisible="1"/>
                <field name="tc_closure_by" column_invisible="1"/>
                <field name="tc_closure_at" column_invisible="1"/>

                <!--
                    INTERRUPTOR DE MODO.
                    'Mandar a pedir' es ahora el switch que gobierna la cantidad:
                    - ON  => product_uom_qty (Solicitado) es manual (pedido a proveedor),
                             se puede además asignar placas y mandar el restante a compra.
                    - OFF => product_uom_qty NO es editable a mano; la cantidad vendible
                             se fija exclusivamente seleccionando placas (Solicitado = Asignado).

                    Debe ser libremente activable para poder "desbloquear" la cantidad manual,
                    por eso ya no lleva readonly por pendiente<=0.
                -->
                <field name="auto_transit_assign"
                       widget="boolean_toggle"
                       width="110px"
                       string="Mandar a pedir"/>

                <!--
                    'Por Asignar': segundo interruptor de cantidad manual,
                    mutuamente excluyente con 'Mandar a pedir'. Desbloquea la
                    edición de 'Solicitado' y conserva siempre el valor escrito.
                -->
                <field name="por_asignar"
                       widget="boolean_toggle"
                       width="110px"
                       string="Por Asignar"/>
            </xpath>

            <!-- ========================================================= -->
            <!-- Renombrar cantidad comercial                              -->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Solicitado</attribute>
                <!--
                    REGLA DE MODO:
                    La cantidad solo se edita a mano cuando 'Mandar a pedir' o
                    'Por Asignar' están activos. Sin ninguno de los dos, la
                    cantidad se fija seleccionando placas (el backend la iguala a
                    la suma asignada por lotes).
                -->
                <attribute name="readonly">not auto_transit_assign and not por_asignar</attribute>
            </xpath>

            <!-- ========================================================= -->
            <!-- Asignado: única métrica que permanece en Líneas de la orden -->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="tc_qty_assigned_lots"
                       string="Asignado"
                       readonly="1"/>
            </xpath>

            <!-- ========================================================= -->
            <!-- Líneas de la orden: solo deben existir las columnas        -->
            <!-- Producto, Mandar a pedir, Por Asignar, Solicitado,         -->
            <!-- Nivel de Precio, Asignado, Unidad, Precio unitario,        -->
            <!-- Impuestos e Importe. El resto de columnas estándar se      -->
            <!-- elimina del grid (los datos viven en sus propias pestañas).-->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='analytic_distribution']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='customer_lead']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- Duplicados opcionales de Importe (Tax Incl. / Tax Excl.) -->
            <xpath expr="(//field[@name='order_line']/list/field[@name='price_total'])[2]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="(//field[@name='order_line']/list/field[@name='price_subtotal'])[2]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- ========================================================= -->
            <!-- Pestaña Logística: duplica las líneas con las métricas de  -->
            <!-- asignación, embarque y entrega. Las líneas se crean y      -->
            <!-- eliminan únicamente desde Líneas de la orden.              -->
            <!-- ========================================================= -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Logística" name="logistics_lines" invisible="state != 'sale'">
                    <field name="order_line" nolabel="1" create="0" delete="0">
                        <list editable="bottom" create="0" delete="0" decoration-muted="tc_assignment_closed">
                            <field name="display_type" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="auto_transit_assign" column_invisible="True"/>
                            <field name="por_asignar" column_invisible="True"/>
                            <field name="has_stone_lots" column_invisible="True"/>
                            <field name="tc_assignment_closed" column_invisible="True"/>

                            <field name="product_template_id" string="Producto" readonly="1"/>
                            <field name="product_uom_qty" string="Solicitado" readonly="1"/>
                            <field name="tc_qty_assigned_lots" string="Asignado" readonly="1"/>
                            <field name="tc_qty_pending_allocation" string="Pendiente" readonly="1"/>
                            <field name="tc_qty_assigned_percent" string="% Asignado" optional="hide" readonly="1"/>
                            <field name="tc_qty_over_assigned" string="Sobreasignado" optional="hide" readonly="1"/>
                            <field name="tc_closed_short_qty" string="Dif. cerrada" optional="hide" readonly="1"/>

                            <field name="qty_delivered" string="Entregado" readonly="1"/>
                            <field name="qty_invoiced" string="Facturado" optional="hide" readonly="1"/>

                            <field name="transit_status"
                                   string="Estado Embarque"
                                   widget="badge"
                                   decoration-secondary="transit_status == 'solicitud'"
                                   decoration-warning="transit_status in ['production', 'booking', 'puerto_origen']"
                                   decoration-info="transit_status in ['on_sea', 'puerto_destino']"
                                   decoration-danger="transit_status == 'arrived_port'"
                                   decoration-success="transit_status == 'delivered'"
                                   readonly="1"/>
                            <field name="transit_eta" string="ETA Embarque" readonly="1"/>

                            <!--
                                Ajuste manual desde la línea: iguala el Solicitado a las placas
                                efectivamente asignadas (la regla ratchet no lo baja solo).
                            -->
                            <button name="action_tc_adjust_qty_to_selection"
                                    type="object"
                                    string="Ajustar a selección"
                                    class="btn-secondary"
                                    title="Igualar la cantidad solicitada a las placas efectivamente asignadas (y salir de 'Por Asignar')"
                                    invisible="auto_transit_assign or tc_assignment_closed or not has_stone_lots or (not por_asignar and tc_qty_pending_allocation &lt;= 0)"/>

                            <button name="action_tc_close_allocation_short"
                                    type="object"
                                    string="Cerrar"
                                    class="btn-secondary"
                                    title="Cerrar pendiente sin modificar la cantidad solicitada"
                                    invisible="tc_qty_pending_allocation &lt;= 0 or tc_assignment_closed"/>

                            <button name="action_tc_reopen_allocation"
                                    type="object"
                                    string="Reabrir"
                                    class="btn-secondary"
                                    title="Reabrir asignación cerrada"
                                    invisible="not tc_assignment_closed"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ───────────────────────────────────────────────────────────── -->
    <!-- Ruta (route_id, de sale_stock): fuera del grid principal y     -->
    <!-- dentro de la pestaña Logística. Va en una vista aparte con     -->
    <!-- prioridad alta para aplicarse después de sale_stock (que crea  -->
    <!-- la columna) y de la vista que crea la pestaña Logística.       -->
    <!-- ───────────────────────────────────────────────────────────── -->
    <record id="view_order_form_transit_route_relocate" model="ir.ui.view">
        <field name="name">sale.order.form.transit.route.relocate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='route_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='logistics_lines']//list/field[@name='transit_status']" position="before">
                <field name="route_id"
                       string="Ruta"
                       groups="stock.group_adv_location"
                       options="{'no_open': True, 'no_create': True}"/>
            </xpath>

        </field>
    </record>

    <!-- ───────────────────────────────────────────────────────────── -->
    <!-- Vista de búsqueda: filtro y agrupación                         -->
    <!-- ───────────────────────────────────────────────────────────── -->
    <record id="view_sales_order_filter_transit_inherit" model="ir.ui.view">
        <field name="name">sale.order.filter.transit.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter name="has_mandar_pedir"
                        string="Con Mandar a pedir"
                        domain="[('has_mandar_pedir', '=', True)]"/>

                <filter name="group_mandar_pedir"
                        string="Agrupar por Mandar a pedir"
                        context="{'group_by': 'has_mandar_pedir'}"/>
            </xpath>
        </field>
    </record>
</odoo>
