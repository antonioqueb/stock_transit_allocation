<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ───────────────────────────────────────────────────────────── -->
    <!-- Formulario: columnas operativas limpias en líneas de pedido    -->
    <!-- ───────────────────────────────────────────────────────────── -->
    <record id="view_order_form_transit_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.transit.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- ========================================================= -->
            <!-- Columnas operativas después de descripción                 -->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="has_stone_lots" column_invisible="1"/>
                <field name="tc_stock_rejected" column_invisible="1"/>
                <field name="tc_assignment_closed" column_invisible="1"/>
                <field name="tc_closure_reason" column_invisible="1"/>
                <field name="tc_closure_by" column_invisible="1"/>
                <field name="tc_closure_at" column_invisible="1"/>

                <!--
                    INTERRUPTOR DE MODO.
                    'Mandar a pedir' es ahora el switch que gobierna la cantidad:
                    - ON  => product_uom_qty (Solicitado) es manual (pedido a proveedor),
                             se puede además asignar placas y mandar el restante a compra.
                    - OFF => product_uom_qty NO es editable a mano; la cantidad vendible
                             se fija exclusivamente seleccionando placas (Solicitado = Asignado).

                    Debe ser libremente activable para poder "desbloquear" la cantidad manual,
                    por eso ya no lleva readonly por pendiente<=0.
                -->
                <field name="auto_transit_assign"
                       widget="boolean_toggle"
                       optional="show"
                       width="110px"
                       string="Mandar a pedir"/>

                <!--
                    'Por Asignar': segundo interruptor de cantidad manual,
                    mutuamente excluyente con 'Mandar a pedir'. Desbloquea la
                    edición de 'Solicitado' y conserva siempre el valor escrito.
                -->
                <field name="por_asignar"
                       widget="boolean_toggle"
                       optional="show"
                       width="110px"
                       string="Por Asignar"/>

                <field name="transit_status"
                       optional="hide"
                       widget="badge"
                       decoration-secondary="transit_status == 'solicitud'"
                       decoration-warning="transit_status in ['production', 'booking', 'puerto_origen']"
                       decoration-info="transit_status in ['on_sea', 'puerto_destino']"
                       decoration-danger="transit_status == 'arrived_port'"
                       decoration-success="transit_status == 'delivered'"
                       string="Estado Embarque"
                       readonly="1"/>

                <field name="transit_eta"
                       optional="hide"
                       string="ETA Embarque"
                       readonly="1"/>
            </xpath>

            <!-- ========================================================= -->
            <!-- Renombrar cantidad comercial                              -->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Solicitado</attribute>
                <!--
                    REGLA DE MODO:
                    La cantidad solo se edita a mano cuando 'Mandar a pedir' o
                    'Por Asignar' están activos. Sin ninguno de los dos, la
                    cantidad se fija seleccionando placas (el backend la iguala a
                    la suma asignada por lotes).
                -->
                <attribute name="readonly">not auto_transit_assign and not por_asignar</attribute>
            </xpath>

            <!-- ========================================================= -->
            <!-- Métricas de asignación y acciones                          -->
            <!-- ========================================================= -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="tc_qty_assigned_lots"
                       string="Asignado"
                       optional="show"
                       readonly="1"/>

                <field name="tc_qty_pending_allocation"
                       string="Pendiente"
                       optional="show"
                       readonly="1"/>

                <field name="tc_qty_assigned_percent"
                       string="% Asignado"
                       optional="hide"
                       readonly="1"/>

                <field name="tc_qty_over_assigned"
                       string="Sobreasignado"
                       optional="hide"
                       readonly="1"/>

                <field name="tc_assignment_state"
                       string="Estado asignación"
                       optional="show"
                       widget="badge"
                       decoration-muted="tc_assignment_state == 'no_demand'"
                       decoration-warning="tc_assignment_state in ['open', 'partial', 'to_purchase']"
                       decoration-success="tc_assignment_state == 'complete'"
                       decoration-danger="tc_assignment_state in ['over_assigned', 'closed_short']"
                       readonly="1"/>

                <field name="tc_closed_short_qty"
                       string="Dif. cerrada"
                       optional="hide"
                       readonly="1"/>

                <!--
                    Acción explícita desde el pedido.
                    Sirve para el flujo:
                    100 solicitado / 80 asignado / 20 pendiente
                    → Mandar restante a To Be Purchased.
                -->
                <button name="action_tc_send_to_purchase"
                        type="object"
                        string="Mandar restante"
                        class="btn-warning"
                        title="Mandar el pendiente real a compra aunque exista stock disponible"
                        invisible="tc_qty_pending_allocation &lt;= 0 or tc_assignment_closed or auto_transit_assign"/>

                <!--
                    Acción inversa:
                    si se mandó a pedir pero luego se quiere volver a revisar stock,
                    limpia la intención de compra y permite que el pendiente regrese
                    a To Be Allocated si existe stock libre.
                -->
                <button name="action_tc_clear_stock_rejection"
                        type="object"
                        string="Revisar stock"
                        class="btn-secondary"
                        title="Quitar Mandar a pedir y volver a revisar stock disponible"
                        invisible="not auto_transit_assign or tc_assignment_closed"/>

                <!--
                    Ajuste manual desde la línea: baja el Solicitado a las placas
                    efectivamente asignadas (la regla ratchet no lo baja solo).
                    Solo aplica sin 'Mandar a pedir', con placas y cuando hay
                    diferencia por bajar (pendiente > 0).
                -->
                <button name="action_tc_adjust_qty_to_selection"
                        type="object"
                        string="Ajustar a selección"
                        class="btn-secondary"
                        title="Igualar la cantidad solicitada a las placas efectivamente asignadas (aunque sea menor)"
                        invisible="auto_transit_assign or tc_assignment_closed or not has_stone_lots or tc_qty_pending_allocation &lt;= 0"/>

                <button name="action_tc_close_allocation_short"
                        type="object"
                        string="Cerrar"
                        class="btn-secondary"
                        title="Cerrar pendiente sin modificar la cantidad solicitada"
                        invisible="tc_qty_pending_allocation &lt;= 0 or tc_assignment_closed"/>

                <button name="action_tc_reopen_allocation"
                        type="object"
                        string="Reabrir"
                        class="btn-secondary"
                        title="Reabrir asignación cerrada"
                        invisible="not tc_assignment_closed"/>
            </xpath>
        </field>
    </record>

    <!-- ───────────────────────────────────────────────────────────── -->
    <!-- Vista de búsqueda: filtro y agrupación                         -->
    <!-- ───────────────────────────────────────────────────────────── -->
    <record id="view_sales_order_filter_transit_inherit" model="ir.ui.view">
        <field name="name">sale.order.filter.transit.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter name="has_mandar_pedir"
                        string="Con Mandar a pedir"
                        domain="[('has_mandar_pedir', '=', True)]"/>

                <filter name="group_mandar_pedir"
                        string="Agrupar por Mandar a pedir"
                        context="{'group_by': 'has_mandar_pedir'}"/>
            </xpath>
        </field>
    </record>
</odoo>