<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================== -->
    <!-- VISTAS DEL MODELO STOCK.TRANSIT.VOYAGE (VIAJES)           -->
    <!-- ========================================================== -->
    
    <!-- 1. VISTA DE LISTA (VIAJES / CONTENEDORES) -->
    <record id="view_stock_transit_voyage_list" model="ir.ui.view">
        <field name="name">stock.transit.voyage.list</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <list decoration-info="custom_status == 'on_sea'" 
                  decoration-success="custom_status == 'delivered'" 
                  decoration-warning="custom_status in ['solicitud', 'production']">
                <field name="name"/>
                <field name="purchase_id" string="OC Origen"/>
                <field name="custom_status" widget="badge" 
                       decoration-warning="custom_status in ['solicitud', 'production']" 
                       decoration-info="custom_status in ['booking', 'on_sea']"
                       decoration-primary="custom_status == 'puerto_origen'"
                       decoration-success="custom_status == 'delivered'"/>
                <field name="container_number" string="Contenedores"/>
                <field name="bl_number"/>
                <field name="shipping_line"/>
                <field name="eta" widget="remaining_days" optional="show"/>
                <field name="allocation_percent" widget="progressbar" string="% Asig."/>
            </list>
        </field>
    </record>

    <!-- 2. VISTA DE FORMULARIO (VIAJES) -->
    <record id="view_stock_transit_voyage_form" model="ir.ui.view">
        <field name="name">stock.transit.voyage.form</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <form string="Gestión de Tránsito">
                <header>
                    <button name="action_advance_status" type="object" 
                            class="btn-primary"
                            invisible="custom_status in ['delivered', 'cancel']"
                            string="⏩ Avanzar Estado"/>
                    
                    <button name="action_retreat_status" type="object" 
                            class="btn-secondary"
                            invisible="custom_status in ['solicitud', 'delivered', 'cancel']"
                            string="⏪ Retroceder"/>

                    <separator/>

                    <button name="action_load_from_purchase" string="🔄 Cargar desde OC" type="object" 
                            class="btn-info" 
                            invisible="picking_id != False or custom_status == 'delivered'"/>
                    
                    <button name="action_load_from_picking" string="🚢 Sincronizar Lotes (Picking)" type="object" 
                            class="btn-secondary" 
                            invisible="picking_id == False or custom_status == 'delivered'"/>

                    <button name="action_generate_reception" string="🏭 Generar Recepción Física" type="object" 
                            class="btn-warning"
                            invisible="custom_status not in ['on_sea', 'puerto_destino', 'arrived_port', 'reception_pending', 'booking', 'puerto_origen'] or reception_picking_id != False"/>
                    
                    <button name="action_generate_reception" string="📋 Ver Recepción (Worksheet)" type="object" 
                            class="btn-success"
                            invisible="reception_picking_id == False"/>

                    <button name="action_sync_reception_from_voyage" string="📦 Recibir en Almacén" type="object" 
                            class="btn-primary"
                            invisible="reception_picking_id == False or custom_status == 'delivered'"/>

                    <button name="action_arrive" string="🏁 Cerrar Viaje" type="object" 
                            class="btn-secondary" 
                            invisible="custom_status in ['delivered', 'cancel']"
                            confirm="¿Está seguro de cerrar este viaje? Se marcará como Entregado."/>

                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="custom_status in ['delivered', 'cancel']"
                            confirm="¿Está seguro de cancelar este viaje?"/>
                            
                    <field name="custom_status" widget="statusbar" 
                           statusbar_visible="solicitud,production,booking,puerto_origen,on_sea,puerto_destino,arrived_port,reception_pending,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Referencia de Viaje</span>
                        <h1><field name="name"/></h1>
                        <label for="container_number" string="Contenedores en este Embarque"/>
                        <h3><field name="container_number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Logística y Estatus">
                            <field name="purchase_id" readonly="1" invisible="not purchase_id"/>
                            <field name="picking_id" readonly="1" invisible="not picking_id"/>
                            <field name="reception_picking_id" readonly="1" invisible="not reception_picking_id"/>
                            <field name="shipping_line" placeholder="Ej. MSC / Maersk"/>
                            <field name="vessel_name"/>
                            <field name="bl_number" string="Folio / BL"/>
                        </group>
                        <group string="Itinerario">
                            <field name="transit_days_expected"/>
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="arrival_date" readonly="1" invisible="not arrival_date"/>
                            <field name="transit_progress" widget="transit_ship_progress"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Contenido y Asignación" name="lots">
                            <field name="line_ids">
                                <list create="0" delete="0" 
                                      decoration-success="allocation_status == 'reserved'" 
                                      decoration-muted="not lot_id" 
                                      editable="bottom">
                                    <field name="container_number" optional="show" readonly="1"/> 
                                    <field name="product_id" readonly="1"/>
                                    <field name="lot_id" placeholder="Esperando recepción..." decoration-bf="1" readonly="1"/>
                                    <field name="product_uom_qty" string="m²" sum="Total m²" readonly="1"/>
                                    
                                    <field name="eligible_partner_ids" column_invisible="1"/>
                                    <field name="partner_id" 
                                           widget="many2one"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           placeholder="Seleccionar cliente..."/>
                                    
                                    <field name="propagate_btn"
                                           widget="transit_propagate_btn"
                                           string=" "
                                           nolabel="1"
                                           width="60px"
                                           readonly="0"/>
                                    
                                    <field name="eligible_order_ids" column_invisible="1"/>
                                    <field name="order_id" 
                                           widget="many2one"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           placeholder="Seleccionar orden..."/>
                                    
                                    <field name="allocation_status" widget="badge" readonly="1"
                                           decoration-success="allocation_status == 'reserved'"
                                           decoration-info="allocation_status == 'available'"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            
                            <div class="alert alert-info mt-2" role="alert">
                                <strong>💡 Propagación Rápida:</strong>
                                Al asignar un <b>Cliente</b>, aparecen dos botones:
                                <span class="badge bg-primary ms-1 me-1">↓1</span> propaga a la siguiente fila,
                                <span class="badge bg-success ms-1 me-1">↓↓</span> propaga a todas las siguientes.
                                <br/>
                                <strong>📦 Contenedores:</strong> Se cargan automáticamente desde el Packing List del proveedor.
                            </div>
                        </page>
                        <page string="Métricas de Carga">
                            <group>
                                <group>
                                    <field name="total_m2"/>
                                    <field name="allocated_m2"/>
                                </group>
                                <group>
                                    <field name="allocation_percent" widget="progressbar"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 3. VISTA KANBAN -->
    <record id="view_stock_transit_voyage_kanban" model="ir.ui.view">
        <field name="name">stock.transit.voyage.kanban</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <kanban default_group_by="custom_status" 
                    class="o_kanban_small_column" 
                    records_draggable="1" 
                    sample="1">
                
                <field name="custom_status"/>
                <field name="name"/>
                <field name="vessel_name"/>
                <field name="shipping_line"/>
                <field name="container_number"/>
                <field name="purchase_id"/>
                <field name="eta"/>
                <field name="allocation_percent"/>
                <field name="transit_progress"/> 
                
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <strong class="o_kanban_record_title text-primary">
                                    <field name="name"/>
                                </strong>
                                <field name="custom_status" widget="label_selection" 
                                       options="{'classes': {
                                           'solicitud': 'warning', 
                                           'production': 'warning', 
                                           'booking': 'info',
                                           'puerto_origen': 'primary',
                                           'on_sea': 'info', 
                                           'puerto_destino': 'info',
                                           'arrived_port': 'warning',
                                           'reception_pending': 'warning',
                                           'delivered': 'success',
                                           'cancel': 'danger'
                                       }}"/>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-shopping-cart me-1"/> 
                                <field name="purchase_id"/>
                            </div>
                            <div class="text-muted mb-1" t-if="record.container_number.raw_value">
                                <small><i class="fa fa-cube me-1"/> <field name="container_number"/></small>
                            </div>
                            <div class="text-muted mb-1" t-if="record.shipping_line.raw_value">
                                <small><i class="fa fa-globe me-1"/> <field name="shipping_line"/></small>
                            </div>
                            <div class="text-muted mb-1" t-if="record.vessel_name.raw_value">
                                <i class="fa fa-ship me-1"/> <field name="vessel_name"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="text-muted small">
                                    <i class="fa fa-calendar me-1"/> 
                                    <field name="eta" widget="remaining_days"/>
                                </span>
                            </div>
                            <div class="mt-2">
                                <field name="allocation_percent" widget="progressbar"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- SÁBANA DE SEGUIMIENTO — Vista de lista nativa              -->
    <!-- (Se mantiene para fallback, pero la acción apunta al      -->
    <!-- componente OWL personalizado)                             -->
    <!-- ========================================================== -->
    <record id="view_transit_sheet_list" model="ir.ui.view">
        <field name="name">stock.transit.sheet.list</field>
        <field name="model">stock.transit.sheet</field>
        <field name="arch" type="xml">
            <list string="Sábana de Seguimiento" create="0" delete="0" edit="0"
                  decoration-success="voyage_status == 'delivered'"
                  decoration-info="voyage_status in ['on_sea', 'booking']"
                  decoration-warning="voyage_status in ['solicitud', 'production']">
                <field name="purchase_id" string="OC Sistema"/>
                <field name="date_order" string="Fecha OC" widget="date"/>
                <field name="voyage_status" widget="badge" 
                       decoration-warning="voyage_status in ['solicitud', 'production']" 
                       decoration-info="voyage_status in ['on_sea', 'booking']"
                       decoration-success="voyage_status == 'delivered'"/>
                <field name="salesperson_id" widget="many2one_avatar_user"/>
                <field name="order_id" string="Sales Order"/>
                <field name="partner_id" string="Cliente / Proyecto"/>
                <field name="proforma_ref" string="Proforma"/>
                <field name="vendor_id" string="Proveedor"/>
                <field name="product_id" string="Descripción"/>
                <field name="product_uom_qty" string="M2 Embarcados" sum="Total"/>
                <field name="container_number"/>
                <field name="shipping_line" optional="hide"/>
                <field name="bl_number" optional="show"/>
                <field name="etd" widget="date"/>
                <field name="eta" widget="date"/>
                <field name="arrival_date" widget="date" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ACCIÓN VIAJES -->
    <record id="action_stock_transit_voyage_main" model="ir.actions.act_window">
        <field name="name">Viajes y Contenedores</field>
        <field name="res_model">stock.transit.voyage</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- MENÚS -->
    <menuitem id="menu_transit_root" name="Torre de Control" 
              web_icon="stock_transit_allocation,static/description/icon.png" sequence="10"/>

    <menuitem id="menu_transit_sheet" name="Sábana de Seguimiento" 
              parent="menu_transit_root" action="action_transit_sheet_custom_client" sequence="1"/>

    <menuitem id="menu_transit_voyage_dashboard" name="Viajes y Contenedores" 
              parent="menu_transit_root" action="action_stock_transit_voyage_main" sequence="2"/>
</odoo>