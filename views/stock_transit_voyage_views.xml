<record id="view_stock_transit_voyage_form" model="ir.ui.view">
    <field name="name">stock.transit.voyage.form</field>
    <field name="model">stock.transit.voyage</field>
    <field name="arch" type="xml">
        <form string="Gestión de Tránsito" class="o_voyage_form o_voyage_form_tech">
            <header>
                <button name="action_advance_status"
                        type="object"
                        string="Avanzar"
                        class="btn-primary"
                        invisible="custom_status in ['delivered', 'cancel']"/>

                <button name="action_retreat_status"
                        type="object"
                        string="Retroceder"
                        class="btn-secondary"
                        invisible="custom_status in ['solicitud', 'delivered', 'cancel']"/>

                <separator/>

                <button name="action_load_from_purchase"
                        string="Cargar OC"
                        type="object"
                        class="btn-secondary"
                        invisible="picking_id != False or custom_status == 'delivered'"/>

                <button name="action_load_from_picking"
                        string="Sincronizar Lotes"
                        type="object"
                        class="btn-secondary"
                        invisible="picking_id == False or custom_status == 'delivered'"/>

                <button name="action_sync_shipsgo"
                        string="Sincronizar API"
                        type="object"
                        class="btn-secondary"
                        invisible="custom_status in ['delivered', 'cancel']"/>

                <button name="action_generate_reception"
                        string="Generar Recepción"
                        type="object"
                        class="btn-warning"
                        invisible="custom_status not in ['on_sea', 'puerto_destino', 'arrived_port', 'reception_pending', 'booking', 'puerto_origen'] or reception_picking_id != False"/>

                <button name="action_generate_reception"
                        string="Abrir Recepción"
                        type="object"
                        class="btn-success"
                        invisible="reception_picking_id == False"/>

                <button name="action_sync_reception_from_voyage"
                        string="Recepcionar"
                        type="object"
                        class="btn-primary"
                        invisible="reception_picking_id == False or custom_status == 'delivered'"/>

                <button name="action_arrive"
                        string="Cerrar Viaje"
                        type="object"
                        class="btn-secondary"
                        invisible="custom_status in ['delivered', 'cancel']"
                        confirm="¿Está seguro de cerrar este viaje? Se marcará como Entregado."/>

                <button name="action_cancel"
                        string="Cancelar"
                        type="object"
                        invisible="custom_status in ['delivered', 'cancel']"
                        confirm="¿Está seguro de cancelar este viaje?"/>

                <field name="custom_status"
                       widget="statusbar"
                       statusbar_visible="solicitud,production,booking,puerto_origen,on_sea,puerto_destino,arrived_port,reception_pending,delivered"/>
            </header>

            <sheet>
                <div class="vf-page">

                    <!-- HERO / COMMAND CENTER -->
                    <section class="vf-hero">
                        <div class="vf-hero__main">
                            <div class="vf-orb">
                                <i class="fa fa-ship"/>
                            </div>

                            <div class="vf-hero__identity">
                                <div class="vf-eyebrow">
                                    <span class="vf-live-dot"/>
                                    Control Tower · Voyage Command
                                </div>

                                <h1 class="vf-title">
                                    <field name="name" readonly="1"/>
                                </h1>

                                <div class="vf-hero__chips">
                                    <div class="vf-chip vf-chip--dark">
                                        <i class="fa fa-shopping-cart"/>
                                        <span>OC</span>
                                        <field name="purchase_id" readonly="1"/>
                                    </div>

                                    <div class="vf-chip">
                                        <i class="fa fa-barcode"/>
                                        <span>BL</span>
                                        <field name="bl_number" placeholder="Sin BL"/>
                                    </div>

                                    <div class="vf-chip">
                                        <i class="fa fa-cube"/>
                                        <span>Contenedores</span>
                                        <field name="container_number" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="vf-hero__side">
                            <div class="vf-status-panel">
                                <div class="vf-status-panel__label">Progreso de tránsito</div>
                                <field name="transit_progress" widget="transit_ship_progress"/>
                            </div>

                            <div class="vf-mini-grid">
                                <div class="vf-mini-stat">
                                    <span>Total</span>
                                    <strong><field name="total_m2" readonly="1"/></strong>
                                    <em>m²</em>
                                </div>

                                <div class="vf-mini-stat vf-mini-stat--success">
                                    <span>Asignado</span>
                                    <strong><field name="allocated_m2" readonly="1"/></strong>
                                    <em>m²</em>
                                </div>

                                <div class="vf-mini-stat vf-mini-stat--blue">
                                    <span>Asignación</span>
                                    <strong><field name="allocation_percent" readonly="1"/></strong>
                                    <em>%</em>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- KPI STRIP -->
                    <section class="vf-kpi-strip">
                        <div class="vf-kpi-card">
                            <div class="vf-kpi-card__icon">
                                <i class="fa fa-th-large"/>
                            </div>
                            <div class="vf-kpi-card__body">
                                <span>Total embarcado</span>
                                <strong>
                                    <field name="total_m2" readonly="1"/>
                                    <em>m²</em>
                                </strong>
                            </div>
                        </div>

                        <div class="vf-kpi-card vf-kpi-card--green">
                            <div class="vf-kpi-card__icon">
                                <i class="fa fa-check-circle"/>
                            </div>
                            <div class="vf-kpi-card__body">
                                <span>Asignado</span>
                                <strong>
                                    <field name="allocated_m2" readonly="1"/>
                                    <em>m²</em>
                                </strong>
                            </div>
                        </div>

                        <div class="vf-kpi-card vf-kpi-card--blue">
                            <div class="vf-kpi-card__icon">
                                <i class="fa fa-line-chart"/>
                            </div>
                            <div class="vf-kpi-card__body">
                                <span>Porcentaje asignado</span>
                                <strong>
                                    <field name="allocation_percent" readonly="1"/>
                                    <em>%</em>
                                </strong>
                            </div>
                        </div>

                        <div class="vf-kpi-card vf-kpi-card--amber">
                            <div class="vf-kpi-card__icon">
                                <i class="fa fa-clock-o"/>
                            </div>
                            <div class="vf-kpi-card__body">
                                <span>Última sincronización</span>
                                <strong class="vf-kpi-card__date">
                                    <field name="shipsgo_last_sync" readonly="1"/>
                                </strong>
                            </div>
                        </div>
                    </section>

                    <!-- DATA CARDS -->
                    <section class="vf-command-grid">
                        <div class="vf-panel vf-panel--documents">
                            <div class="vf-panel__header">
                                <div>
                                    <span>01</span>
                                    <h3>Documentos</h3>
                                </div>
                                <i class="fa fa-file-text-o"/>
                            </div>

                            <div class="vf-field-list">
                                <div class="vf-field-row">
                                    <label>OC Sistema</label>
                                    <div class="vf-field-value">
                                        <field name="purchase_id" readonly="1" no_open="0"/>
                                    </div>
                                </div>

                                <div class="vf-field-row">
                                    <label>Folio / BL</label>
                                    <div class="vf-field-value">
                                        <field name="bl_number" placeholder="Número de BL..."/>
                                    </div>
                                </div>

                                <div class="vf-field-row">
                                    <label>No. Viaje</label>
                                    <div class="vf-field-value">
                                        <field name="voyage_number" placeholder="Ej. 0302W..."/>
                                    </div>
                                </div>

                                <div class="vf-field-row" invisible="not picking_id">
                                    <label>Recepción ADM</label>
                                    <div class="vf-field-value">
                                        <field name="picking_id" readonly="1"/>
                                    </div>
                                </div>

                                <div class="vf-field-row" invisible="not reception_picking_id">
                                    <label>Recepción Física</label>
                                    <div class="vf-field-value">
                                        <field name="reception_picking_id" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="vf-panel vf-panel--route">
                            <div class="vf-panel__header">
                                <div>
                                    <span>02</span>
                                    <h3>Ruta e itinerario</h3>
                                </div>
                                <i class="fa fa-calendar"/>
                            </div>

                            <div class="vf-route-strip">
                                <div class="vf-route-node">
                                    <span>ETD</span>
                                    <strong><field name="etd"/></strong>
                                </div>
                                <div class="vf-route-line"/>
                                <div class="vf-route-node vf-route-node--active">
                                    <span>ETA</span>
                                    <strong><field name="eta"/></strong>
                                </div>
                                <div class="vf-route-line"/>
                                <div class="vf-route-node">
                                    <span>Llegada</span>
                                    <strong><field name="arrival_date" readonly="1"/></strong>
                                </div>
                            </div>

                            <div class="vf-field-list">
                                <div class="vf-field-row">
                                    <label>Días tránsito</label>
                                    <div class="vf-field-value">
                                        <field name="transit_days_expected"/>
                                    </div>
                                </div>

                                <div class="vf-field-row">
                                    <label>Entregado en bodega</label>
                                    <div class="vf-field-value">
                                        <field name="arrival_date_bodega" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="vf-panel vf-panel--vessel">
                            <div class="vf-panel__header">
                                <div>
                                    <span>03</span>
                                    <h3>Buque y contenedores</h3>
                                </div>
                                <i class="fa fa-cubes"/>
                            </div>

                            <div class="vf-vessel-card">
                                <div class="vf-vessel-card__icon">
                                    <i class="fa fa-ship"/>
                                </div>
                                <div class="vf-vessel-card__info">
                                    <label>Buque / Barco</label>
                                    <field name="vessel_name" placeholder="Nombre del buque..."/>
                                    <label>Naviera</label>
                                    <field name="shipping_line" placeholder="Naviera..."/>
                                </div>
                            </div>

                            <div class="vf-container-display">
                                <span>Contenedores detectados</span>
                                <strong><field name="container_number" readonly="1"/></strong>
                            </div>

                            <div class="vf-hint">
                                <i class="fa fa-info-circle"/>
                                Se actualizan automáticamente desde las líneas del viaje.
                            </div>
                        </div>
                    </section>

                    <!-- TRACKING MAP -->
                    <section class="vf-map-panel">
                        <div class="vf-section-title">
                            <div>
                                <span class="vf-section-kicker">Tracking</span>
                                <h2>Seguimiento en tiempo real</h2>
                            </div>
                            <div class="vf-sync-meta">
                                <i class="fa fa-satellite-dish"/>
                                <span>ShipsGo / SOM Group</span>
                            </div>
                        </div>

                        <div invisible="shipsgo_map_html" class="vf-map-empty">
                            <div class="vf-map-empty__icon">
                                <i class="fa fa-map-o"/>
                            </div>
                            <h3>Sin datos de rastreo</h3>
                            <p>Captura un contenedor válido y usa “Sincronizar API” para cargar la ubicación.</p>
                        </div>

                        <div invisible="not shipsgo_map_html" class="vf-map-canvas">
                            <field name="shipsgo_map_html"
                                   widget="html"
                                   readonly="1"
                                   class="o_field_html"
                                   nolabel="1"
                                   options="{'style-inline': True}"/>
                        </div>

                        <field name="shipsgo_payload" invisible="1"/>
                    </section>

                    <!-- LOTS -->
                    <section class="vf-lots-section vf-lots-section--tech">
                        <div class="vf-section-title vf-section-title--compact">
                            <div>
                                <span class="vf-section-kicker">Cargo Manifest</span>
                                <h2>Contenido del embarque</h2>
                                <p>Agrupado por producto · asignación directa por cliente y orden.</p>
                            </div>
                            <div class="vf-info-pill">
                                <i class="fa fa-angle-double-down"/>
                                <span>Propagación disponible por línea</span>
                            </div>
                        </div>

                        <field name="line_ids" widget="transit_voyage_lines"/>
                    </section>

                    <!-- FOOTER METRICS -->
                    <section class="vf-footer-metrics">
                        <div class="vf-footer-metric">
                            <span>Total embarcado</span>
                            <strong><field name="total_m2" readonly="1"/> <em>m²</em></strong>
                        </div>

                        <div class="vf-footer-metric vf-footer-metric--green">
                            <span>Asignado</span>
                            <strong><field name="allocated_m2" readonly="1"/> <em>m²</em></strong>
                        </div>

                        <div class="vf-footer-progress">
                            <span>Asignación general</span>
                            <field name="allocation_percent" widget="progressbar" readonly="1"/>
                        </div>
                    </section>

                </div>
            </sheet>

            <chatter/>
        </form>
    </field>
</record>