<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         VISTAS STOCK.TRANSIT.VOYAGE — Torre de Control
    ====================================================================== -->

    <!-- ────────────────────────────────────────────────────────────────────────
         LISTA
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="view_stock_transit_voyage_list" model="ir.ui.view">
        <field name="name">stock.transit.voyage.list</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <list decoration-info="custom_status == 'on_sea'"
                  decoration-success="custom_status == 'delivered'"
                  decoration-warning="custom_status in ['solicitud', 'production']">
                <field name="name"/>
                <field name="purchase_id" string="OC Origen"/>
                <field name="custom_status" widget="badge"
                       decoration-warning="custom_status in ['solicitud', 'production']"
                       decoration-info="custom_status in ['booking', 'on_sea']"
                       decoration-primary="custom_status == 'puerto_origen'"
                       decoration-success="custom_status == 'delivered'"/>
                <field name="container_number" string="Contenedores"/>
                <field name="bl_number"/>
                <field name="shipping_line"/>
                <field name="eta" widget="remaining_days" optional="show"/>
                <field name="transit_progress" widget="progressbar" string="Progreso" optional="show"/>
                <field name="allocation_percent" widget="progressbar" string="% Asig."/>
            </list>
        </field>
    </record>

    <!-- ────────────────────────────────────────────────────────────────────────
         FORMULARIO PRINCIPAL
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="view_stock_transit_voyage_form" model="ir.ui.view">
        <field name="name">stock.transit.voyage.form</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <form string="Gestión de Tránsito" class="o_voyage_form">
                <header>
                    <button name="action_advance_status"
                            type="object"
                            class="btn-primary"
                            invisible="custom_status in ['delivered', 'cancel']"
                            title="Avanzar" icon="fa-forward"/>

                    <button name="action_retreat_status"
                            type="object"
                            class="btn-secondary"
                            invisible="custom_status in ['solicitud', 'delivered', 'cancel']"
                            title="Retroceder" icon="fa-backward"/>

                    <separator/>

                    <button name="action_load_from_purchase"
                            string="Cargar OC" icon="fa-download"
                            type="object"
                            class="btn-secondary"
                            invisible="picking_id != False or custom_status == 'delivered'"/>

                    <!-- Ocultos por pedido (2026-08-10): ya no se usan, pero los
                         nodos permanecen porque otras vistas se anclan a ellos. -->
                    <button name="action_load_from_picking"
                            string="Sincronizar lotes" icon="fa-refresh"
                            type="object"
                            class="btn-secondary"
                            invisible="1"/>

                    <button name="action_sync_shipsgo"
                            string="Sincronizar API" icon="fa-wifi"
                            type="object"
                            class="btn-secondary"
                            invisible="1"/>

                    <button name="action_open_unassign_wizard"
                            string="Desasignar" icon="fa-unlock"
                            type="object"
                            class="btn-secondary"
                            invisible="1"/>

                    <button name="action_generate_reception"
                            string="Recibir" icon="fa-industry"
                            type="object"
                            class="btn-warning"
                            invisible="custom_status not in ['on_sea', 'puerto_destino', 'arrived_port', 'reception_pending', 'booking', 'puerto_origen'] or reception_picking_id != False"/>

                    <button name="action_generate_reception"
                            string="Recepción" icon="fa-clipboard"
                            type="object"
                            class="btn-success"
                            invisible="reception_picking_id == False"/>

                    <button name="action_sync_reception_from_voyage"
                            string="Recepcionar" icon="fa-cubes"
                            type="object"
                            class="btn-primary"
                            invisible="reception_picking_id == False or custom_status == 'delivered'"/>

                    <button name="action_print_reception_labels"
                            string="Etiquetas" icon="fa-tags"
                            type="object"
                            class="btn-secondary"
                            invisible="1"/>

                    <button name="action_arrive"
                            string="Cerrar viaje" icon="fa-flag-checkered"
                            type="object"
                            class="btn-secondary"
                            invisible="custom_status in ['delivered', 'cancel']"
                            confirm="¿Está seguro de cerrar este viaje? Se marcará como Entregado."/>

                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="custom_status in ['delivered', 'cancel']"
                            confirm="¿Está seguro de cancelar este viaje?"/>

                    <!-- Etapas logísticas: ventana deslizante de 3 estados
                         (anterior · ACTUAL · siguiente), con nombres cortos. -->
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="solicitud,production,booking"
                           invisible="custom_status not in ['solicitud', 'production']"/>
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="production,booking,puerto_origen"
                           invisible="custom_status != 'booking'"/>
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="booking,puerto_origen,on_sea"
                           invisible="custom_status != 'puerto_origen'"/>
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="puerto_origen,on_sea,puerto_destino"
                           invisible="custom_status != 'on_sea'"/>
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="on_sea,puerto_destino,arrived_port"
                           invisible="custom_status != 'puerto_destino'"/>
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="puerto_destino,arrived_port,reception_pending"
                           invisible="custom_status != 'arrived_port'"/>
                    <field name="custom_status" widget="statusbar" options="{'clickable': True}"
                           statusbar_visible="arrived_port,reception_pending,delivered"
                           invisible="custom_status not in ['reception_pending', 'delivered']"/>
                    <field name="custom_status" widget="statusbar"
                           statusbar_visible="cancel"
                           invisible="custom_status != 'cancel'"/>
                </header>

                <sheet>
                    <!-- ════════════════════════════════════════════════
                         HERO HEADER
                    ════════════════════════════════════════════════ -->
                    <div class="vf-hero vf-hero--exec">
                        <!-- 1. Identificación (30%) -->
                        <div class="vf-exec-id">
                            <div class="vf-hero__ref">
                                <field name="name" class="vf-hero__name" readonly="1"/>
                            </div>
                            <div class="vf-hero__supplier" invisible="not tc_supplier_id">
                                <field name="tc_supplier_id" readonly="1" options="{'no_open': True}"/>
                            </div>
                        </div>

                        <!-- 2. Información logística (40%): campos con etiqueta -->
                        <div class="vf-exec-log">
                            <div class="vf-log-item">
                                <span class="vf-log-label">Orden de compra</span>
                                <span class="vf-log-value" invisible="not purchase_id">
                                    <field name="purchase_id" readonly="1" options="{'no_open': True}"/>
                                </span>
                                <span class="vf-log-value vf-log-value--empty" invisible="purchase_id">Sin definir</span>
                            </div>
                            <div class="vf-log-item">
                                <span class="vf-log-label">BL / Referencia</span>
                                <span class="vf-log-value" invisible="not bl_number">
                                    <field name="bl_number" readonly="1"/>
                                </span>
                                <span class="vf-log-value vf-log-value--empty" invisible="bl_number">Sin definir</span>
                            </div>
                        </div>

                        <!-- 3. Cobertura comercial (30%): una sola línea, centrada -->
                        <div class="vf-exec-coverage"
                             title="Cobertura comercial = asignado / embarcado. Independiente del avance logístico.">
                            <div class="vf-cov-headline">
                                <field name="allocation_percent" class="vf-cov-pct" readonly="1" options="{'digits': [16, 0]}"/><span class="vf-cov-pct-unit">% asignado</span>
                                <span class="vf-cov-sep">·</span>
                                <span class="vf-cov-lots"><field name="tc_lots_summary" readonly="1"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════════════
                         DATOS DEL EMBARQUE
                         Fila compacta; el panel completo la REEMPLAZA al abrir.
                    ════════════════════════════════════════════════ -->
                    <div class="vf-databand">
                    <div class="vf-quickdata">
                        <span class="vf-qd" invisible="not reception_picking_id">
                            <span class="vf-qd__label">Recepción física</span>
                            <field name="reception_picking_id" readonly="1" options="{'no_open': True}"/>
                        </span>
                        <span class="vf-qd" invisible="not picking_id">
                            <span class="vf-qd__label">Recepción ADM</span>
                            <field name="picking_id" readonly="1" options="{'no_open': True}"/>
                        </span>
                        <span class="vf-qd" invisible="not etd">
                            <span class="vf-qd__label">ETD</span>
                            <field name="etd" readonly="1"/>
                        </span>
                        <span class="vf-qd">
                            <span class="vf-qd__label">ETA</span>
                            <field name="eta" readonly="1" invisible="not eta"/>
                            <span invisible="eta">Sin definir</span>
                        </span>
                        <span class="vf-qd">
                            <span class="vf-qd__label">Contenedor</span>
                            <field name="container_number" readonly="1"
                                   invisible="not container_number or container_number == 'PENDIENTE'"/>
                            <span invisible="container_number and container_number != 'PENDIENTE'">Sin asignar</span>
                        </span>
                        <span class="vf-qd" invisible="not arrival_date">
                            <span class="vf-qd__label">Llegada real</span>
                            <field name="arrival_date" readonly="1"/>
                        </span>
                        <span class="vf-qd" invisible="not arrival_date_bodega">
                            <span class="vf-qd__label">En bodega</span>
                            <field name="arrival_date_bodega" readonly="1"/>
                        </span>
                        <span class="vf-qd">
                            <span class="vf-qd__label">Días tránsito</span>
                            <field name="transit_days_expected" readonly="1"/>
                        </span>
                    </div>

                    </div>

                    <!-- ════════════════════════════════════════════════
                         MAPA (SIEMPRE colapsado; se expande bajo demanda)
                    ════════════════════════════════════════════════ -->
                    <details class="vf-map-details mt-3 mb-3">
                        <summary class="vf-map-summary o_horizontal_separator mb-2 text-uppercase fw-bold text-muted small">
                            <i class="fa fa-chevron-right vf-map-caret me-1"/>
                            Seguimiento en Tiempo Real
                            <span class="vf-map-hint">— clic para expandir</span>
                        </summary>

                        <div invisible="shipsgo_map_html"
                             class="text-center text-muted py-4 vf-map-placeholder"
                             style="background:#f1f5f9;border:1px solid #e5e7eb;border-radius:8px;min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                            <i class="fa fa-map-o fa-3x mb-2" title="Mapa de seguimiento"/>
                            <p>Sin datos de rastreo.</p>
                            <small>Presione “Sincronizar API” para cargar ubicación.</small>
                        </div>

                        <div invisible="not shipsgo_map_html"
                             class="vf-map-wrapper"
                             style="width:100%;height:420px;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;margin-bottom:8px;">
                            <field name="shipsgo_map_html"
                                   widget="html"
                                   readonly="1"
                                   class="o_field_html"
                                   nolabel="1"
                                   options="{'style-inline': True}"/>
                        </div>

                        <div class="d-flex justify-content-between text-muted small px-2 mb-3 vf-sync-footer">
                            <span>
                                <i class="fa fa-clock-o me-1"/>
                                Última act:
                                <field name="shipsgo_last_sync" readonly="1" class="d-inline"/>
                            </span>
                            <span>Powered by SOM Group</span>
                        </div>
                    </details>

                    <field name="shipsgo_payload" invisible="1"/>

                    <!-- La incidencia "cliente sin pedido" vive ÚNICAMENTE en el
                         centro de incidencias del widget (una sola alerta, accionable). -->
                    <field name="pending_order_count" invisible="1"/>
                    <field name="pending_order_summary" invisible="1"/>

                    <!-- ════════════════════════════════════════════════
                         LOTES
                    ════════════════════════════════════════════════ -->
                    <div class="vf-lots-section">
                        <div class="vf-lots-section__header">
                            <div class="vf-lots-section__title">
                                <i class="fa fa-th-list"/>
                                <span title="Agrupado por producto; clic en la cabecera para expandir o colapsar">Contenido del embarque</span>
                            </div>

                        </div>

                        <field name="line_ids" widget="transit_voyage_lines"/>
                    </div>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ────────────────────────────────────────────────────────────────────────
         KANBAN NATIVO — fallback
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="view_stock_transit_voyage_kanban" model="ir.ui.view">
        <field name="name">stock.transit.voyage.kanban</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <kanban default_group_by="custom_status" class="o_kanban_small_column" sample="1">
                <field name="custom_status"/>
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="eta"/>
                <field name="allocation_percent"/>

                <templates>
                    <t t-name="card">
                        <strong><field name="name"/></strong>
                        <div><field name="purchase_id"/></div>
                        <div><field name="eta" widget="remaining_days"/></div>
                        <div><field name="allocation_percent" widget="progressbar"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ────────────────────────────────────────────────────────────────────────
         SÁBANA NATIVA — fallback
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="view_transit_sheet_list" model="ir.ui.view">
        <field name="name">stock.transit.sheet.list</field>
        <field name="model">stock.transit.sheet</field>
        <field name="arch" type="xml">
            <list string="Cronograma" create="0" delete="0" edit="0">
                <field name="purchase_id" string="OC Sistema"/>
                <field name="date_order" string="Fecha OC" widget="date"/>
                <field name="voyage_status" widget="badge"/>
                <field name="salesperson_id" widget="many2one_avatar_user"/>
                <field name="order_id" string="Sales Order"/>
                <field name="partner_id" string="Cliente / Proyecto"/>
                <field name="proforma_ref" string="Proforma"/>
                <field name="vendor_id" string="Proveedor"/>
                <field name="product_id" string="Descripción"/>
                <field name="product_uom_qty" string="M2 Embarcados" sum="Total"/>
                <field name="container_number"/>
                <field name="bl_number" optional="show"/>
                <field name="etd" widget="date"/>
                <field name="eta" widget="date"/>
                <field name="arrival_date" widget="date" optional="show"/>
                <field name="tc_publication_pending" string="Sin publicar"
                       optional="show" widget="boolean"
                       decoration-danger="tc_publication_pending"/>
            </list>
        </field>
    </record>

    <!-- ────────────────────────────────────────────────────────────────────────
         BÚSQUEDA: filtro "Pendiente de publicar" (PL procesado + Puerto Origen o
         superior + X días + inventario sin publicar). La meta es verlo VACÍO.
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="view_stock_transit_voyage_search" model="ir.ui.view">
        <field name="name">stock.transit.voyage.search</field>
        <field name="model">stock.transit.voyage</field>
        <field name="arch" type="xml">
            <search string="Buscar Viajes">
                <field name="name"/>
                <field name="bl_number"/>
                <field name="shipping_line"/>
                <filter name="publication_pending"
                        string="Pendiente de publicar"
                        domain="[('tc_publication_pending', '=', True)]"
                        help="PL procesado, en Puerto Origen o superior, y el inventario de tránsito sigue sin publicarse."/>
                <filter name="group_status" string="Estado" context="{'group_by': 'custom_status'}"/>
            </search>
        </field>
    </record>

    <record id="view_transit_sheet_search" model="ir.ui.view">
        <field name="name">stock.transit.sheet.search</field>
        <field name="model">stock.transit.sheet</field>
        <field name="arch" type="xml">
            <search string="Buscar Cronograma">
                <field name="purchase_id"/>
                <field name="partner_id"/>
                <field name="vendor_id"/>
                <field name="container_number"/>
                <filter name="publication_pending"
                        string="Pendiente de publicar"
                        domain="[('tc_publication_pending', '=', True)]"
                        help="PL procesado, en Puerto Origen o superior, y el inventario de tránsito sigue sin publicarse."/>
            </search>
        </field>
    </record>

    <!-- ────────────────────────────────────────────────────────────────────────
         ACCIONES
    ──────────────────────────────────────────────────────────────────────── -->
    <record id="action_stock_transit_voyage_main" model="ir.actions.act_window">
        <field name="name">Viajes (Lista)</field>
        <field name="res_model">stock.transit.voyage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_transit_voyage_search"/>
    </record>

    <record id="action_transit_tracking_sheet" model="ir.actions.act_window">
        <field name="name">Sábana (Nativa)</field>
        <field name="res_model">stock.transit.sheet</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_transit_sheet_list"/>
        <field name="search_view_id" ref="view_transit_sheet_search"/>
    </record>

    <record id="action_transit_sheet_custom_client" model="ir.actions.client">
        <field name="name">Cronograma</field>
        <field name="tag">action_transit_sheet_custom</field>
    </record>

    <record id="action_transit_kanban_custom_client" model="ir.actions.client">
        <field name="name">Viajes y Contenedores</field>
        <field name="tag">action_transit_kanban_custom</field>
    </record>

    <!-- ────────────────────────────────────────────────────────────────────────
         MENÚS
    ──────────────────────────────────────────────────────────────────────── -->
    <menuitem id="menu_transit_root"
              name="Torre de Control"
              web_icon="stock_transit_allocation,static/description/icon.png"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_transit_sheet"
              name="Cronograma"
              parent="menu_transit_root"
              action="action_transit_sheet_custom_client"
              sequence="1"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_transit_voyage_dashboard"
              name="Viajes y Contenedores"
              parent="menu_transit_root"
              action="action_transit_kanban_custom_client"
              sequence="2"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_transit_voyage_list"
              name="Lista de Viajes"
              parent="menu_transit_root"
              action="action_stock_transit_voyage_main"
              sequence="3"
              groups="purchase.group_purchase_user"/>
</odoo>