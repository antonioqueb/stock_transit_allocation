<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_supplier_shipment_form" model="ir.ui.view">
        <field name="name">supplier.shipment.form</field>
        <field name="model">supplier.shipment</field>
        <field name="arch" type="xml">
            <form string="Embarque">
                <header>
                    <button name="action_sync_to_voyage" type="object"
                            string="🔄 Sincronizar con Torre de Control"
                            class="btn-primary"
                            invisible="status in ['draft']"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,in_production,booked,departed,in_transit,arrived,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Referencia">
                            <field name="proforma_id" readonly="1"/>
                            <field name="purchase_id" readonly="1"/>
                            <field name="shipment_type"/>
                            <field name="voyage_id" readonly="1"/>
                        </group>
                        <group string="Logística">
                            <field name="shipping_line"/>
                            <field name="vessel_name"/>
                            <field name="port_origin"/>
                            <field name="port_destination"/>
                            <field name="etd"/>
                            <field name="eta"/>
                        </group>
                    </group>

                    <group string="Conocimiento de Embarque (B/L)">
                        <group>
                            <field name="bl_number"/>
                            <field name="bl_date"/>
                        </group>
                        <group>
                            <field name="bl_file" filename="bl_filename"/>
                            <field name="bl_filename" invisible="1"/>
                        </group>
                    </group>

                    <group string="Observaciones">
                        <field name="notes" nolabel="1" placeholder="Observaciones logísticas del embarque..."/>
                    </group>

                    <notebook>
                        <page string="Invoices" name="invoices">
                            <field name="invoice_ids">
                                <list editable="bottom">
                                    <field name="invoice_number"/>
                                    <field name="invoice_date"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="scope"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Packing Lists" name="packings">
                            <field name="packing_ids">
                                <list editable="bottom">
                                    <field name="packing_number"/>
                                    <field name="packing_date"/>
                                    <field name="scope"/>
                                    <field name="row_count" string="Líneas" readonly="1"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Contenedores" name="containers">
                            <field name="container_ids">
                                <list editable="bottom">
                                    <field name="container_number"/>
                                    <field name="seal_number"/>
                                    <field name="container_type"/>
                                    <field name="weight"/>
                                    <field name="volume"/>
                                    <field name="packages"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Trazabilidad" name="lot_traceability">
                            <field name="packing_row_ids" readonly="1">
                                <list create="0" delete="0" edit="0"
                                      default_order="packing_id, sequence, id"
                                      decoration-muted="trace_state == 'entregado'"
                                      decoration-info="trace_state == 'en_transito'"
                                      decoration-warning="trace_state in ('hold', 'vendido')"
                                      decoration-success="trace_state == 'libre'">
                                    <field name="product_id" string="Producto"/>
                                    <field name="trace_lot_id" string="Lote"/>
                                    <field name="bloque" string="Bloque" optional="show"/>
                                    <field name="numero_placa" string="Placa" optional="show"/>
                                    <field name="atado" string="Atado" optional="hide"/>
                                    <field name="grupo_name" string="Tono/Grupo" optional="hide"/>
                                    <field name="pedimento" string="Pedimento" optional="show"/>
                                    <field name="container_id" string="Contenedor" optional="show"/>
                                    <field name="packing_id" string="Packing List" optional="show"/>
                                    <field name="area_m2" string="Cant." sum="Total"/>
                                    <field name="trace_costo_unit" string="Costo Unit." optional="show"/>
                                    <field name="trace_subtotal" string="Subtotal" sum="Total" optional="show"/>
                                    <field name="trace_fecha_solicitud" string="Solicitud" optional="show"/>
                                    <field name="trace_fecha_atencion" string="Atención" optional="show"/>
                                    <field name="trace_fecha_llegada" string="Llegada bodega" optional="show"/>
                                    <field name="trace_sale_orders" string="Ventas" optional="show"/>
                                    <field name="trace_state" string="Estado" widget="badge"
                                           decoration-success="trace_state == 'libre'"
                                           decoration-info="trace_state in ('en_transito', 'recibido')"
                                           decoration-warning="trace_state in ('hold', 'vendido')"
                                           decoration-danger="trace_state in ('sin_lote', 'sin_stock')"/>
                                    <button name="action_view_lot_history" type="object"
                                            icon="fa-history" title="Historial de movimientos"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_supplier_shipment_list" model="ir.ui.view">
        <field name="name">supplier.shipment.list</field>
        <field name="model">supplier.shipment</field>
        <field name="arch" type="xml">
            <list string="Embarques"
                  decoration-info="status in ['in_production','booked']"
                  decoration-warning="status in ['departed','in_transit']"
                  decoration-success="status in ['arrived','delivered']">
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="shipment_type"/>
                <field name="shipping_line"/>
                <field name="bl_number"/>
                <field name="bl_date"/>
                <field name="etd"/>
                <field name="eta"/>
                <field name="container_count"/>
                <field name="invoice_count"/>
                <field name="packing_count"/>
                <field name="status" widget="badge"/>
                <field name="voyage_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_shipment_search" model="ir.ui.view">
        <field name="name">supplier.shipment.search</field>
        <field name="model">supplier.shipment</field>
        <field name="arch" type="xml">
            <search string="Buscar Embarques">
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="bl_number"/>
                <field name="shipping_line"/>
                <filter name="maritime" string="Marítimo" domain="[('shipment_type','=','maritime')]"/>
                <filter name="in_transit" string="En Tránsito" domain="[('status','in',['departed','in_transit'])]"/>
                <filter name="arrived" string="Arribados" domain="[('status','in',['arrived','delivered'])]"/>
                    <filter name="group_purchase" string="Orden de Compra" context="{'group_by':'purchase_id'}"/>
                    <filter name="group_status" string="Estado" context="{'group_by':'status'}"/>
                    <filter name="group_shipping" string="Naviera" context="{'group_by':'shipping_line'}"/>
            </search>
        </field>
    </record>

    <record id="action_supplier_shipment" model="ir.actions.act_window">
        <field name="name">Embarques</field>
        <field name="res_model">supplier.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_supplier_shipment_packing_form" model="ir.ui.view">
        <field name="name">supplier.shipment.packing.form</field>
        <field name="model">supplier.shipment.packing</field>
        <field name="arch" type="xml">
            <form string="Packing List">
                <sheet>
                    <group>
                        <group>
                            <field name="shipment_id" readonly="1"/>
                            <field name="packing_number"/>
                            <field name="packing_date"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <field name="container_ids" widget="many2many_tags"
                                   invisible="scope != 'specific_containers'"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="row_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="container_id"/>
                            <field name="tipo"/>
                            <field name="bloque"/>
                            <field name="atado"/>
                            <field name="numero_placa"/>
                            <field name="grosor"/>
                            <field name="alto"/>
                            <field name="ancho"/>
                            <field name="area_m2" readonly="1"/>
                            <field name="quantity"/>
                            <field name="peso"/>
                            <field name="color"/>
                            <field name="ref_proveedor"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MENÚS -->
    <menuitem id="menu_transit_portal_data" name="Portal Proveedor"
              parent="menu_transit_root" sequence="20"/>

    <menuitem id="menu_supplier_proformas"
              name="Proformas"
              parent="menu_transit_portal_data"
              action="action_supplier_proforma_header"
              sequence="1"/>

    <menuitem id="menu_supplier_shipments"
              name="Embarques"
              parent="menu_transit_portal_data"
              action="action_supplier_shipment"
              sequence="2"/>

</odoo>