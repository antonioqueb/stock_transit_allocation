<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_proforma" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.proforma</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- ACCESO DIRECTO al embarque de Torre de Control: nada
                     de formularios intermedios de proforma. Sin embarque,
                     el botón NO existe. -->
                <button name="action_open_tc_voyage"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-ship"
                        invisible="tc_voyage_count == 0">
                    <div class="o_stat_info">
                        <field name="tc_voyage_count" class="o_stat_value"/>
                        <span class="o_stat_text">Embarque</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>