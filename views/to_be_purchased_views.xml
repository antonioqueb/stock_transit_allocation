<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- ACCIONES CLIENTE                                          -->
    <!-- ========================================================= -->

    <record id="action_to_be_purchased_client" model="ir.actions.client">
        <field name="name">To Be Purchased</field>
        <field name="tag">action_to_be_purchased</field>
    </record>

    <record id="action_to_be_allocated_client" model="ir.actions.client">
        <field name="name">To Be Allocated</field>
        <field name="tag">action_to_be_allocated</field>
    </record>

    <record id="action_to_be_loading_client" model="ir.actions.client">
        <field name="name">Open PO</field>
        <field name="tag">action_to_be_loading</field>
    </record>

    <!-- ========================================================= -->
    <!-- APLICACIONES INDEPENDIENTES EN RAÍZ                       -->
    <!-- Estas aparecen como apps principales en el menú raíz       -->
    <!-- ========================================================= -->

    <menuitem id="menu_app_to_be_allocated_root"
              name="To Be Allocated"
              action="action_to_be_allocated_client"
              web_icon="stock_transit_allocation,static/description/tobeallocated.png"
              sequence="2"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_app_to_be_purchased_root"
              name="To Be Purchased"
              action="action_to_be_purchased_client"
              web_icon="stock_transit_allocation,static/description/tobepurchase.png"
              sequence="3"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_app_to_be_loading_root"
              name="Open PO"
              action="action_to_be_loading_client"
              web_icon="stock_transit_allocation,static/description/tobeloading.svg"
              sequence="4"
              groups="purchase.group_purchase_user"/>

    <!-- ========================================================= -->
    <!-- MENÚS DENTRO DE APLICACIONES EXISTENTES                   -->
    <!-- Se conservan además de las apps independientes             -->
    <!-- ========================================================= -->

    <!-- Menú dentro de Ventas -->
    <menuitem id="menu_sale_to_be_allocated"
              name="To Be Allocated"
              parent="sale.sale_order_menu"
              action="action_to_be_allocated_client"
              sequence="0"
              groups="purchase.group_purchase_user"/>

    <!-- Menú dentro de Compras -->
    <menuitem id="menu_purchase_to_be_purchased"
              name="To Be Purchased"
              parent="purchase.menu_procurement_management"
              action="action_to_be_purchased_client"
              sequence="0"
              groups="purchase.group_purchase_user"/>

    <!-- Eliminar binding del wizard viejo si existía en sale.order -->
    <delete model="ir.actions.act_window"
            search="[('res_model','=','sale.order.consolidate.purchase')]"/>
</odoo>