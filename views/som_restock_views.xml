<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SOM Restock: radar de recompra (stock + apartados + tránsito +
         consumo + lead times medidos) y asesor de compra. -->
    <record id="action_som_restock" model="ir.actions.client">
        <field name="name">Restock</field>
        <field name="tag">stock_transit_allocation.som_restock</field>
    </record>

    <menuitem id="menu_som_restock_root" name="Restock"
              web_icon="stock_transit_allocation,static/description/restock_icon.svg"
              sequence="33"
              groups="purchase.group_purchase_user,inventory_shopping_cart.group_dashboard_viewer,inventory_shopping_cart.group_price_authorizer"/>
    <menuitem id="menu_som_restock_dashboard" name="Radar de Restock"
              parent="menu_som_restock_root"
              action="action_som_restock" sequence="1"/>
</odoo>
