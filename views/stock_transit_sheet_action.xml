<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        REEMPLAZA action_transit_tracking_sheet por una ir.actions.client
        que carga el componente OWL personalizado TransitSheetView.
        Se conserva el tag original para que no rompan referencias externas,
        pero el tag del client action es el propio del componente.
    -->
    <record id="action_transit_tracking_sheet" model="ir.actions.client">
        <field name="name">Sábana de Seguimiento</field>
        <field name="tag">action_transit_sheet_custom</field>
    </record>
</odoo>