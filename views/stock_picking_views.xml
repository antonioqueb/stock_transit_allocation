<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Extensión propia de Torre de Control.

        IMPORTANTE:
        Este archivo NO debe volver a crear botones de Packing List / Worksheet,
        porque esos botones ya existen en stock_lot_packing_import.

        Aquí solo agregamos:
        - Campo técnico tc_is_physical_reception
        - Botón Sincronizar con Embarque
        - Smart button de tránsito
        - Pedidos consolidados
    -->
    <record id="view_picking_form_transit_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.transit.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="tc_is_physical_reception" invisible="1"/>
            </field>

            <xpath expr="//header" position="inside">
                <button name="action_sync_from_voyage"
                        string="📲 Sincronizar con Embarque"
                        type="object"
                        class="btn-primary"
                        groups="stock.group_stock_user"
                        invisible="not tc_is_physical_reception or state in ('done', 'cancel')"/>
            </xpath>

            <div name="button_box" position="inside">
                <button name="action_view_transit_voyage"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-ship"
                        invisible="transit_count == 0">
                    <field name="transit_count" widget="statinfo" string="En Tránsito"/>
                </button>
            </div>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="transit_sale_order_ids"
                       widget="many2many_tags"
                       invisible="picking_type_code != 'incoming'"
                       string="Pedidos (Consolidado)"/>
            </xpath>

        </field>
    </record>


    <!--
        Parche sobre los botones EXISTENTES del módulo principal
        stock_lot_packing_import.

        No se crean botones nuevos.
        Solo ajustamos la visibilidad de los botones originales para que
        también funcionen en recepciones físicas internas de Torre de Control.
    -->
    <record id="view_picking_form_transit_patch_packing_import_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.transit.patch.packing.import.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_lot_packing_import.view_picking_form_inherit_packing_import"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Abrir PL: permitirlo en recepción física TC aunque sea internal -->
            <xpath expr="//header/button[@name='action_open_packing_list_spreadsheet' and @string='Abrir PL']"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or packing_list_imported
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Procesar PL: permitirlo en recepción física TC aunque sea internal -->
            <xpath expr="//header/button[@name='action_import_packing_list' and @string='Procesar PL']"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or packing_list_imported
                    or not spreadsheet_id
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Corregir PL: se conserva como botón único del módulo principal -->
            <xpath expr="//header/button[@name='action_open_packing_list_spreadsheet' and @string='Corregir PL']"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or not packing_list_imported
                    or worksheet_imported
                </attribute>
            </xpath>

            <!-- Reprocesar PL: se conserva como botón único del módulo principal -->
            <xpath expr="//header/button[@name='action_import_packing_list' and @string='Reprocesar PL']"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or not packing_list_imported
                    or worksheet_imported
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>