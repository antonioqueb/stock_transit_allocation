<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Extensión propia de Torre de Control.

        IMPORTANTE:
        Este archivo NO crea botones nuevos de Packing List / Worksheet.
        Los botones PL/WS ya existen en stock_lot_packing_import.

        Aquí solo agregamos:
        - Campo técnico tc_is_physical_reception
        - Botón Sincronizar con Embarque
        - Smart button de tránsito
        - Pedidos consolidados

        Después, en una vista separada, solo ajustamos la visibilidad
        de los botones originales del módulo stock_lot_packing_import.
    -->
    <record id="view_picking_form_transit_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.transit.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="tc_is_physical_reception" invisible="1"/>
            </field>

            <xpath expr="//header" position="inside">
                <button name="action_sync_from_voyage"
                        string="📲 Sincronizar con Embarque"
                        type="object"
                        class="btn-primary"
                        groups="stock.group_stock_user"
                        invisible="not tc_is_physical_reception or state in ('done', 'cancel')"/>
            </xpath>

            <div name="button_box" position="inside">
                <button name="action_view_transit_voyage"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-ship"
                        invisible="transit_count == 0">
                    <field name="transit_count"
                           widget="statinfo"
                           string="En Tránsito"/>
                </button>
            </div>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="transit_sale_order_ids"
                       widget="many2many_tags"
                       invisible="picking_type_code != 'incoming'"
                       string="Pedidos (Consolidado)"/>
            </xpath>

        </field>
    </record>


    <!--
        Parche sobre los botones EXISTENTES del módulo principal:
        stock_lot_packing_import.view_picking_form_inherit_packing_import

        No se crean botones nuevos.

        Odoo 19 NO permite usar @string como selector XPath.
        Por eso se seleccionan por name + índice:

        action_open_packing_list_spreadsheet:
            [1] = Abrir PL
            [2] = Corregir PL

        action_import_packing_list:
            [1] = Procesar PL
            [2] = Reprocesar PL
    -->
    <record id="view_picking_form_transit_patch_packing_import_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.transit.patch.packing.import.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_lot_packing_import.view_picking_form_inherit_packing_import"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Abrir PL -->
            <xpath expr="(//header/button[@name='action_open_packing_list_spreadsheet'])[1]"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or packing_list_imported
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Procesar PL -->
            <xpath expr="(//header/button[@name='action_import_packing_list'])[1]"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or packing_list_imported
                    or not spreadsheet_id
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Corregir PL -->
            <xpath expr="(//header/button[@name='action_open_packing_list_spreadsheet'])[2]"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or not packing_list_imported
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Reprocesar PL -->
            <xpath expr="(//header/button[@name='action_import_packing_list'])[2]"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or not packing_list_imported
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Abrir Worksheet -->
            <xpath expr="//header/button[@name='action_open_worksheet_spreadsheet']"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or not packing_list_imported
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

            <!-- Procesar Worksheet -->
            <xpath expr="//header/button[@name='action_import_worksheet']"
                   position="attributes">
                <attribute name="invisible">
                    state in ('done', 'cancel', 'draft')
                    or not packing_list_imported
                    or not ws_spreadsheet_id
                    or worksheet_imported
                    or (picking_type_code != 'incoming' and not tc_is_physical_reception)
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>